{
  "name": "telfer-wiki",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "The Telfer Family Wiki — a digital genealogy for the Telfer line",
  "scripts": {
    "dev": "astro dev",
    "sanitize": "node scripts/sanitize-people.mjs",
    "validate": "node validate-people.mjs",
    "build": "npm run sanitize && npm run validate && astro build",
    "postbuild": "node scripts/generate-redirects.mjs && node scripts/validate-links.mjs",
    "self-heal": "node scripts/auto-fix-links.mjs && npm run build",
    "preview": "astro preview",
    "astro": "astro",
    "regenerate-data": "bash scripts/regenerate-data.sh"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "astro": "^5.7.0",
    "fuse.js": "^7.4.0",
    "tailwindcss": "^4.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "gray-matter": "^4.0.3"
  }
}
