---
// TreeView.astro — Renders the Telfer surname tree (Charles & Sons view)
// Click a person to load their detail panel
import type { PersonData } from "../utils/extract-data.mjs";

interface Props {
  people: PersonData[];
  selectedId?: string;
}

const { people, selectedId } = Astro.props;

// Build lookup for tree rendering
const peopleById = new Map(people.map(p => [p.id, p]));
const peopleBySlug = new Map(people.map(p => [p.slug, p]));

function findPerson(id: string | undefined, dataset = people) {
  if (!id || typeof id !== "string") return undefined;
  let person = dataset.find(p => p.id === id || p.display_name === id || p.slug === id);
  if (!person) {
    const nameOnly = id.replace(/\s*\([^)]+\)\s*$/, "").trim();
    person = dataset.find(p => p.display_name === nameOnly);
  }
  return person;
}

// Known children of Francis Charles Telfer (some lack wiki entries)
// 10 children total: 5 Telfer-surname sons, 5 married daughters
// Daughters: shown with spouse + their children, then STOP (no further recursion)
const KNOWN_CHILDREN: Record<string, { name: string; birth: number; death?: number; hasProfile: boolean; spouse?: string; children?: { name: string; birth?: number; death?: number }[] }> = {
  "Francis Kelson Telfer": { name: "Francis Kelson Telfer", birth: 1910, death: 1987, hasProfile: false },
  "Edwin Roy Telfer": { name: "Edwin Roy Telfer", birth: 1921, death: 2009, hasProfile: false },
  "Reginald Masters Telfer": { name: "Reginald Masters Telfer", birth: 1923, hasProfile: false },
  "Murray John Telfer": { name: "Murray John Telfer", birth: 1924, death: 2009, hasProfile: true },

  // Married daughters (Telfer by birth, took husband's surname)
  // We show: daughter + spouse + THEIR children → then STOP
  "Clarice May Fatchen": {
    name: "Clarice May Fatchen (née Telfer)",
    birth: 1911,
    death: 1997,
    hasProfile: true,
    spouse: "Mr Fatchen",
    children: [
      { name: "David Fatchen", birth: 1935 },
      { name: "Robert Fatchen", birth: 1938 },
      { name: "Helen Fatchen", birth: 1942 },
    ],
  },
  "Emily Amelia Barton": {
    name: "Emily Amelia Barton (née Telfer)",
    birth: 1913,
    death: 2000,
    hasProfile: false,
    spouse: "Mr Barton",
    children: [
      { name: "John Barton" },
      { name: "Margaret Barton" },
    ],
  },
  "Ethel Jean McMurtrie": {
    name: "Ethel Jean McMurtrie (née Telfer)",
    birth: 1915,
    hasProfile: false,
    spouse: "Mr McMurtrie",
    children: [
      { name: "Ian McMurtrie" },
      { name: "Diana McMurtrie" },
    ],
  },
  "Gladys Merle Pedler": {
    name: "Gladys Merle Pedler (née Telfer)",
    birth: 1917,
    hasProfile: false,
    spouse: "Mr Pedler",
    children: [
      { name: "Peter Pedler" },
      { name: "Anne Pedler" },
    ],
  },
  "Doris Elma Rowe": {
    name: "Doris Elma Rowe (née Telfer)",
    birth: 1919,
    hasProfile: false,
    spouse: "Mr Rowe",
    children: [
      { name: "Michael Rowe" },
      { name: "Jennifer Rowe" },
    ],
  },

  // Youngest daughter — never married, kept Telfer surname
  "Ruth Telfer": { name: "Ruth Telfer", birth: 1931, hasProfile: true },
};

function getAllChildren(person: PersonData) {
  if (!person?.children) return [];
  const wikiChildren = person.children
    .map((c) => findPerson(c))
    .filter((c) => c)
    .sort((a, b) => (a.birth_year || 9999) - (b.birth_year || 9999));

  const isFrancis =
    person.slug === "francis-charles-telfer" ||
    person.display_name === "Francis Charles Telfer";

  if (isFrancis) {
    // KNOWN_CHILDREN is the authoritative list of Francis's children (sons +
    // married daughters). Every child now has a real profile in the vault, so we
    // merge that live data in instead of emitting duplicate placeholder nodes:
    //   - real profile supplies the node (correct birth/death years + working link)
    //   - a married daughter additionally carries her grandchildren from the table
    //     (the vault's daughter profiles hold no children), rendered as final leaves
    const result: PersonData[] = [];
    const seenSlugs = new Set<string>();

    for (const kc of Object.values(KNOWN_CHILDREN)) {
      // Resolve the real profile by exact slug (children slugs are stored as-is)
      // or by given names (married entries swap the surname to the husband's and
      // may drop/alter middle names, so match on the first two given-name tokens).
      const realBySlug = findPerson(kc.profile_slug || kc.name);
      const givenKey = kc.name.replace(/\(.*\)/, "").trim().toLowerCase();
      const givenTokens = givenKey.split(/\s+/).slice(0, 2).join(" ");
      const firstToken = givenKey.split(/\s+/)[0];
      const real =
        realBySlug ||
        wikiChildren.find(
          (wc) => wc.display_name?.toLowerCase() === givenKey
        ) ||
        wikiChildren.find((wc) =>
          wc.display_name?.toLowerCase().split(/\s+/).slice(0, 2).join(" ") === givenTokens
        ) ||
        // Sons carry middle names in this table that real profiles omit
        // ("Francis Kelson Telfer" -> "Francis Telfer"). Every child of Francis
        // has a unique first given name, so a first-token fallback is safe.
        wikiChildren.find((wc) =>
          wc.display_name?.toLowerCase().split(/\s+/)[0] === firstToken
        );

      if (real) {
        if (seenSlugs.has(real.slug || real.id)) continue; // already emitted
        // Sons and unmarried daughters: emit the real profile as a recurse node.
        const isMarriedDaughter = kc.name.includes("(née") && (kc.children?.length || kc.spouse);
        if (!isMarriedDaughter) {
          seenSlugs.add(real.slug || real.id);
          result.push(real);
          continue;
        }
        // Married daughter: emit a leaf node using the real profile's correct
        // years + slug (working link) but the married surname so it renders as a
        // non-recursing leaf, with her grandchildren as the final line.
        const marriedSurname = (kc.name.split("(")[0]?.trim().split(/\s+/).slice(-1)[0]) || "Telfer";
        const grandkids = (kc.children || []).map((gc: any) => ({
          display_name: gc.name,
          birth_year: gc.birth,
          death_year: gc.death,
          death_year_display: gc.death?.toString(),
          is_living: !gc.death,
          last_name: gc.name.split(" ").slice(-1)[0] || "Unknown",
          slug: gc.name.toLowerCase().replace(/\s+/g, "-"),
          children: undefined,
          spouses: undefined,
          id: `placeholder:${kc.name}::${gc.name}`,
        }));
        seenSlugs.add(real.slug || real.id);
        result.push({
          ...real,
          last_name: marriedSurname,
          children: grandkids,
          spouses: undefined,
          _placeholderMeta: {
            isMarriedDaughter: true,
            spouse: kc.spouse,
            grandchildren: kc.children,
          },
        } as any);
        continue;
      }

      // No real profile at all — emit a placeholder node (the data is only in the
      // table). This is rare now that all children have profiles.
      const grandchildren = kc.children
        ? kc.children.map((gc: any) => ({
            display_name: gc.name,
            birth_year: gc.birth,
            death_year: gc.death,
            death_year_display: gc.death?.toString(),
            is_living: !gc.death,
            last_name: kc.name.includes("(née Telfer)")
              ? kc.name.split("(")[1]?.split(")")[0]?.replace("née ", "") || "Unknown"
              : "Telfer",
            slug: gc.name.toLowerCase().replace(/\s+/g, "-"),
            children: undefined,
            spouses: undefined,
            id: `placeholder:${kc.name}::${gc.name}`,
          }))
        : undefined;
      const marriedSurname = kc.name.includes("(née")
        ? (kc.name.split("(")[0]?.trim().split(/\s+/).slice(-1)[0]) || "Telfer"
        : "Telfer";
      result.push({
        display_name: kc.name,
        birth_year: kc.birth,
        death_year: kc.death,
        death_year_display: kc.death?.toString(),
        is_living: !kc.death,
        last_name: kc.name.includes("(née Telfer)") ? marriedSurname : "Telfer",
        slug: kc.name.toLowerCase().replace(/\s+/g, "-").replace(/[()]/g, ""),
        children: grandchildren,
        spouse: undefined,
        spouses: kc.spouse ? [{ display_name: kc.spouse, id: `placeholder:${kc.name}::spouse` }] : undefined,
        id: `placeholder:${kc.name}`,
        _placeholderMeta: {
          isMarriedDaughter: kc.name.includes("(née Telfer)"),
          spouse: kc.spouse,
          grandchildren: kc.children,
        },
      } as any);
    }
    return result.sort((a, b) => (a.birth_year || 9999) - (b.birth_year || 9999));
  }
  return wikiChildren;
}

function getSpouse(person: PersonData) {
  if (!person?.spouses?.length) return null;
  return findPerson(person.spouses[0]);
}

function shouldRecurseSurname(person: PersonData) {
  return person.last_name?.toLowerCase() === "telfer";
}

// Check if a person is a married daughter (placeholder with _placeholderMeta)
function isMarriedDaughter(person: PersonData) {
  return (person as any)._placeholderMeta?.isMarriedDaughter === true;
}

// Render surname tree with click handlers for detail panel
function renderSurnameTree(person: PersonData, depth = 0, seen = new Set<string>()): string {
  if (!person) return "";
  const personKey = person.slug || person.id || person.display_name;
  if (seen.has(personKey)) {
    return `<div class="tree-cycle text-xs text-[var(--color-muted)] italic">${"  ".repeat(depth)}↻ cycle skipped (${person.display_name})</div>`;
  }
  const newSeen = new Set(seen);
  newSeen.add(personKey);

  const spouse = getSpouse(person);
  const allChildren = getAllChildren(person);
  const childrenToRecurse = allChildren.filter(shouldRecurseSurname);
  const childrenToShowOnly = allChildren.filter(c => !shouldRecurseSurname(c));

  const indent = "  ".repeat(depth);
  const lifespan = `${person.birth_year || "?"}–${person.death_year ?? (person.is_living ? "living" : "?")}`;
  const livingBadge = person.is_living
    ? ' <span class="badge badge-living text-xs">living</span>'
    : "";
  const spouseName = spouse
    ? ` + ${spouse.display_name} (${spouse.birth_year || "?"}–${spouse.death_year ?? (spouse.is_living ? "living" : "?")})`
    : "";
  const surnameLabel =
    person.last_name?.toLowerCase() !== "telfer"
      ? ` <span class="text-xs text-[var(--color-muted)]">[${person.last_name}]</span>`
      : "";

  const isSelected = selectedId && (person.id === selectedId || person.slug === selectedId || person.display_name === selectedId);
  const selectedClass = isSelected ? " selected" : "";
  const personIdAttr = `data-person-id="${person.id}" data-person-slug="${person.slug}" data-person-name="${person.display_name.replace(/"/g, "&quot;")}"`;

  let html = `
${indent}<details class="tree-node${selectedClass}" ${depth === 0 ? "open" : ""}>
${indent}  <summary class="cursor-pointer select-none flex items-center gap-2 px-2 py-1 rounded ${selectedClass}" tabindex="0" ${personIdAttr}>
${indent}    <span class="font-mono text-[var(--color-heading)] shrink-0">${"│  ".repeat(depth)}├─</span>
${indent}    <strong class="truncate">${person.display_name}</strong>
${indent}    <span class="text-xs text-[var(--color-muted)] shrink-0">(${lifespan})</span>${livingBadge}${spouseName}${surnameLabel}
${indent}  </summary>
${indent}  <div class="ml-6 mt-1 border-l border-[var(--color-border)] pl-3">`;

  for (const child of childrenToRecurse) {
    html += renderSurnameTree(child, depth + 1, newSeen);
  }

  for (const child of childrenToShowOnly) {
    const childSpouse = getSpouse(child);
    const childLifespan = `${child.birth_year || "?"}–${child.death_year ?? (child.is_living ? "living" : "?")}`;
    const childLivingBadge = child.is_living
      ? ' <span class="badge badge-living text-xs">living</span>'
      : "";
    const childSpouseName = childSpouse
      ? ` + ${childSpouse.display_name} (${childSpouse.birth_year || "?"}–${childSpouse.death_year ?? (childSpouse.is_living ? "living" : "?")})`
      : "";
    const childSurnameLabel = ` <span class="text-xs text-[var(--color-muted)]">[${child.last_name}]</span>`;
    const childIsSelected = selectedId && (child.id === selectedId || child.slug === selectedId || child.display_name === selectedId);
    const childIdAttr = `data-person-id="${child.id}" data-person-slug="${child.slug}" data-person-name="${child.display_name.replace(/"/g, "&quot;")}"`;

    html += `
${indent}    <details class="tree-leaf${childIsSelected ? " selected" : ""}" open>
${indent}      <summary class="cursor-pointer select-none flex items-center gap-2 px-2 py-1 rounded" tabindex="0" ${childIdAttr}>
${indent}        <span class="font-mono text-[var(--color-heading)] shrink-0">${"│  ".repeat(depth + 1)}├─</span>
${indent}        <strong class="truncate">${child.display_name}</strong>
${indent}        <span class="text-xs text-[var(--color-muted)] shrink-0">(${childLifespan})</span>${childLivingBadge}${childSpouseName}${childSurnameLabel}
${indent}      </summary>
${indent}      <div class="ml-6 mt-1 border-l border-[var(--color-border)] pl-3">`;

    // If this is a married daughter (placeholder with grandchildren), show her children as final leaf level
    if (isMarriedDaughter(child) && child.children) {
      for (const grandchild of child.children) {
        const gcLifespan = `${grandchild.birth_year || "?"}–${grandchild.death_year ?? (grandchild.is_living ? "living" : "?")}`;
        const gcLivingBadge = grandchild.is_living
          ? ' <span class="badge badge-living text-xs">living</span>'
          : "";
        const gcSurnameLabel = ` <span class="text-xs text-[var(--color-muted)]">[${grandchild.last_name}]</span>`;
        const gcIdAttr = `data-person-id="${grandchild.id}" data-person-slug="${grandchild.slug}" data-person-name="${grandchild.display_name.replace(/"/g, "&quot;")}"`;

        html += `
${indent}        <div class="tree-leaf" style="margin-top: 0.25rem;">
${indent}          <span class="font-mono text-[var(--color-heading)] shrink-0">${"│  ".repeat(depth + 2)}├─</span>
${indent}          <strong class="truncate">${grandchild.display_name}</strong>
${indent}          <span class="text-xs text-[var(--color-muted)] shrink-0">(${gcLifespan})</span>${gcLivingBadge}${gcSurnameLabel}
${indent}          <span class="text-xs text-[var(--color-muted)] ml-8">→ line ends</span>
${indent}        </div>`;
      }
    } else {
      // Regular non-Telfer child (not a married daughter placeholder) — just show "line ends"
      html += `
${indent}        <div class="tree-leaf" style="margin-top: 0.25rem;">
${indent}          <span class="font-mono text-[var(--color-heading)] shrink-0">${"│  ".repeat(depth + 1)}├─</span>
${indent}          <span class="text-xs text-[var(--color-muted)] italic">→ line ends (no further data)</span>
${indent}        </div>`;
    }

    html += `
${indent}      </div>
${indent}    </details>`;
  }

  html += `
${indent}  </div>
${indent}</details>`;
  return html;
}

// Generate tree from Francis Charles Telfer (Charles & Sons)
const FRANCIS_ID = "Francis Charles Telfer (1875–1954)";
const francis = findPerson(FRANCIS_ID);
const treeHtml = francis ? renderSurnameTree(francis) : "<p>Francis Charles Telfer not found</p>";
---

<div class="tree-view person-card rounded-xl p-4" role="region" aria-label="Telfer surname family tree">
  <p class="text-[var(--color-muted)] mb-4 text-sm">
    Descendant chart from <strong>Francis Charles Telfer (1875–1954)</strong> — Telfer-surname line only.
    Wives shown; daughters' married lines noted but not expanded. Click a name to view details.
  </p>
  <div class="tree-container prose prose-sm max-w-none" style="font-size: 0.875rem; line-height: 1.7;" id="tree-container">
    <div set:html={treeHtml} />
  </div>
</div>

<style>
  .tree-node summary {
    line-height: 1.6;
    transition: background-color 0.15s, color 0.15s;
    user-select: none;
  }
  .tree-node summary:hover {
    background-color: var(--color-surface);
    color: var(--color-link);
  }
  .tree-node summary:focus {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
    border-radius: 4px;
  }
  .tree-node[open] > summary {
    color: var(--color-heading);
  }
  .tree-node.selected > summary,
  .tree-leaf.selected {
    background-color: var(--color-highlight) !important;
    color: var(--color-surface) !important;
    border-radius: 4px;
  }
  .tree-container {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  .badge-living {
    background: var(--color-success);
    color: white;
    padding: 0.125rem 0.5rem;
    border-radius: 9999px;
    font-weight: 500;
  }
  .tree-cycle {
    color: var(--color-warning);
  }

  @media (max-width: 639px) {
    .tree-view {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    .tree-container {
      font-size: 0.8rem;
      min-width: max-content;
    }
    .tree-node summary {
      padding: 0.75rem 1rem;
      min-height: 44px;
      display: flex;
      align-items: center;
      flex-wrap: wrap;
    }
    .tree-node summary strong.truncate {
      flex-shrink: 1;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      max-width: 300px;
    }
  }
</style>

<script>
  // Handle person clicks in tree — dispatch event for detail panel
  document.querySelectorAll('.tree-node summary[class*="cursor-pointer"], .tree-leaf').forEach(el => {
    el.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const personId = target.dataset.personId;
      const personSlug = target.dataset.personSlug;
      const personName = target.dataset.personName;

      if (personId || personSlug) {
        // Highlight selected
        document.querySelectorAll('.tree-node, .tree-leaf').forEach(n => n.classList.remove('selected'));
        target.closest('.tree-node')?.classList.add('selected');
        if (target.classList.contains('tree-leaf')) target.classList.add('selected');

        // Navigate to detail panel (update URL hash for deep linking)
        const slug = personSlug || personId;
        window.location.hash = `person/${slug}`;

        // Dispatch custom event for detail panel component
        window.dispatchEvent(new CustomEvent('person-selected', {
          detail: { id: personId, slug: personSlug, name: personName }
        }));
      }
    });

    // Keyboard support
    el.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        el.click();
      }
    });
  });

  // Deep link from hash on load
  window.addEventListener('load', () => {
    const hash = window.location.hash;
    if (hash.startsWith('#person/')) {
      const slug = hash.slice(8);
      const personLink = document.querySelector(`[data-person-slug="${slug}"]`);
      if (personLink) personLink.click();
    }
  });
</script>