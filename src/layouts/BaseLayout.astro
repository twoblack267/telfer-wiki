<script>

  // ── Dark mode toggle ──
  const themeToggle = document.getElementById('theme-toggle');
  const sunIcon = document.getElementById('theme-icon-sun');
  const moonIcon = document.getElementById('theme-icon-moon');

  function setTheme(theme) {
    if (theme === 'dark') {
      document.documentElement.setAttribute('data-theme', 'dark');
      if (sunIcon) sunIcon.classList.add('hidden');
      if (moonIcon) moonIcon.classList.remove('hidden');
    } else {
      document.documentElement.removeAttribute('data-theme');
      if (sunIcon) sunIcon.classList.remove('hidden');
      if (moonIcon) moonIcon.classList.add('hidden');
    }
    localStorage.setItem('telfer-wiki-theme', theme);
  }

  if (themeToggle) {
    var currentTheme = document.documentElement.getAttribute('data-theme');
    if (currentTheme === 'dark') {
      if (sunIcon) sunIcon.classList.add('hidden');
      if (moonIcon) moonIcon.classList.remove('hidden');
    }

    themeToggle.addEventListener('click', function() {
      var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      setTheme(isDark ? 'light' : 'dark');
    });

    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
      if (!localStorage.getItem('telfer-wiki-theme')) {
        setTheme(e.matches ? 'dark' : 'light');
      }
    });
  }

  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('nav-desktop');
  const iconOpen = document.getElementById('nav-icon-open');
  const iconClose = document.getElementById('nav-icon-close');

  if (toggle && panel) {
    // Publish the real header height so the drawer's fixed-position scrim starts
    // exactly under the header instead of at a guessed 4.75rem. Re-measured on
    // open and on resize (mobile URL bars change viewport height).
    const navEl = panel.closest('nav');
    const syncNavH = () => {
      if (!navEl) return;
      document.documentElement.style.setProperty('--nav-h', navEl.getBoundingClientRect().height + 'px');
    };
    syncNavH();
    window.addEventListener('resize', syncNavH, { passive: true });

    // ONE code path opens and closes the drawer (2026-11-04). Three handlers
    // used to edit panel + icons + aria separately and drifted apart: Escape
    // still toggled Tailwind's `hidden` class while click used inline display,
    // so after Escape both glyphs were hidden and the button went blank.
    // Every path now funnels through setOpen.
    const setOpen = (isOpen) => {
      panel.classList.toggle('is-open', isOpen);
      document.body.classList.toggle('nav-open', isOpen);
      if (iconOpen) iconOpen.style.display = isOpen ? 'none' : 'block';
      if (iconClose) iconClose.style.display = isOpen ? 'block' : 'none';
      toggle.setAttribute('aria-expanded', String(isOpen));
      toggle.setAttribute('aria-label', isOpen ? 'Close navigation' : 'Open navigation');
    };
    setOpen(false);

    toggle.addEventListener('click', () => setOpen(!panel.classList.contains('is-open')));

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (panel.classList.contains('is-open') && !toggle.contains(e.target) && !panel.contains(e.target)) {
        setOpen(false);
      }
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && panel.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>

<style is:global>
  @import "tailwindcss";

  /* ── ROOT CANVAS + COLOR-SCHEME (2026-11-04, second pass). ──
     Everything in this file was painted on <nav>, <main>, <footer> — but
     nothing on the canvas itself. Two consequences, both visible on Mark's
     MacBook:
       1. The <html> canvas was unpainted, so anything translucent (the nav's
          85% bg + backdrop-blur-sm) composited over Chrome's dark default.
       2. Inline <style> is emitted BEFORE the Tailwind import at line 729, so
          the earlier `html{background-color:var(--color-paper)}` rules lost to
          `.bg-[...]` on source order and were dead letters. These live in the
          Tailwind-layer style block now — after the import — so they win.
     `color-scheme` is the other half: it tells the UA what the canvas, scroll
     bars, and form controls should default to. Without it a light page in a
     dark-themed Chrome renders its unpainted areas dark. */
  html{color-scheme:light;background-color:var(--color-paper)}
  body{background-color:var(--color-paper);color:var(--color-ink)}

  /* ── THE RIGHT-HAND GAP (2026-11-04, fourth pass — the real one). ──
     <main> carried Tailwind's `max-w-5xl`, which is 64rem = 1024px. At every
     MacBook width (1440, 1512, 1728) the content column was hard-capped at
     1024px and centred by `mx-auto`, so 200-350px of empty cream sat between
     the content and the right wall. The <header> was made full-bleed in an
     earlier pass, which is why the top looked right while the body below it
     was still a narrow island - the two no longer shared a grid.
     `dashboard-main` replaces the cap: the main column fills its parent and
     shares the header's 2rem gutters. Applied to the layout wrapper rather
     than per-page so all 2,311 routes agree. Footer gets the same treatment so
     its rule runs the full width too.
     FIFTH PASS (2026-11-04): "making the stream full". Filling the viewport
     put the prose edge-to-edge, which is unreadable at 1500px - Mark asked for
     the flow to be full-width, not the text. Ultra-wide line lengths are the
     real defect underneath his complaint. So: the CONTAINER is full-bleed
     (sections, cards, grids, rules all run wall to wall), but the prose inside
     a section is capped with the ch unit - a measure that tracks the font, so
     it stays honest at any zoom or window size. `--measure` is 68ch with the
     text left-aligned in the flow, never centred as a narrow island. */
  @media(min-width:1024px){
