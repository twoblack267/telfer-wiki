---
interface Props {
  title: string;
  description?: string;
  // Optional SEO enhancement props (all optional — existing callers unaffected)
  canonicalPath?: string;          // e.g. "/people/elizabeth-beattie"
  ogType?: string;                 // "website" | "article" | "profile"
  ogImage?: string;                // absolute or relative URL to share thumbnail
  schema?: object;                 // JSON-LD structured data (e.g. Schema.org Person)
}
const { title, description, canonicalPath, ogType, ogImage, schema } = Astro.props;
const currentPath = Astro.url.pathname;
const canonicalUrl = canonicalPath ? `https://telferwiki.com${canonicalPath}` : Astro.url.origin + Astro.url.pathname;
const defaultDescription = "The Telfer Family Wiki — a digital family history archive tracing nine generations of Telfers from Scotland to South Australia. A living record of the family line from John Telfer of Castleton to the present day.";
const resolvedOgType = ogType || "website";
const resolvedOgImage = ogImage || "https://telferwiki.com/telferwiki-og.png";
const jsonLd = schema ? JSON.stringify(schema) : null;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Telfer Wiki</title>
    <meta name="description" content={description || defaultDescription} />
    <link rel="icon" type="image/svg+xml" href={import.meta.env.BASE_URL + "favicon.svg"} />

    <!-- Canonical URL (prevents duplicate-content across URL variants) -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / social sharing -->
    <meta property="og:type" content={resolvedOgType} />
    <meta property="og:site_name" content="Telfer Wiki" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description || defaultDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description || defaultDescription} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- Structured data (JSON-LD) -->
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}


    <!-- Fonts: Playfair Display for headings (elegant heritage serif), Inter for body (clean, readable) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&display=swap" rel="stylesheet" />
  <script is:inline>
      (function() {
        var saved = localStorage.getItem('telfer-wiki-theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (saved === 'dark' || (!saved && prefersDark)) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Navigation -->
    <nav class="border-b-2 border-[var(--color-border)] bg-[var(--color-nav-bg)] backdrop-blur-sm sticky top-0 z-50 no-print">
      <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href={import.meta.env.BASE_URL} class="nav-link text-lg sm:text-xl font-serif font-bold text-[var(--color-heading)] hover:text-[var(--color-heading-hover)] no-underline flex items-center gap-2">
          <span class="text-[var(--color-highlight)] text-xl sm:text-2xl">🌳</span>
          Telfer Wiki
        </a>

        <!-- Desktop nav -->
        <div class="hidden md:flex gap-1 items-center">
          <a href={import.meta.env.BASE_URL} class="nav-link px-3 py-2 rounded-lg" class:list={[currentPath === import.meta.env.BASE_URL && "active"]}>Home</a>
          <a href={import.meta.env.BASE_URL + "people"} class="nav-link px-3 py-2 rounded-lg" class:list={[currentPath.startsWith(import.meta.env.BASE_URL + "people") && "active"]}>People</a>
          <a href={import.meta.env.BASE_URL + "timeline"} class="nav-link px-3 py-2 rounded-lg" class:list={[currentPath.startsWith(import.meta.env.BASE_URL + "timeline") && "active"]}>Timeline</a>
          <a href={import.meta.env.BASE_URL + "people/full-tree"} class="nav-link px-3 py-2 rounded-lg" class:list={[currentPath.startsWith(import.meta.env.BASE_URL + "people/full-tree") && "active"]}>Full Tree</a>
          <a href={import.meta.env.BASE_URL + "search"} class="nav-link px-3 py-2 rounded-lg" class:list={[currentPath.startsWith(import.meta.env.BASE_URL + "search") && "active"]}>Search</a>
          <a href={import.meta.env.BASE_URL + "people/families"} class="nav-link px-3 py-2 rounded-lg" class:list={[currentPath.startsWith(import.meta.env.BASE_URL + "people/families") && "active"]}>Families</a>
          <a href={import.meta.env.BASE_URL + "people/dna"} class="nav-link px-3 py-2 rounded-lg" class:list={[currentPath.startsWith(import.meta.env.BASE_URL + "people/dna") && "active"]}>DNA</a>
          <a href={import.meta.env.BASE_URL + "ballads"} class="nav-link px-3 py-2 rounded-lg" class:list={[currentPath.startsWith(import.meta.env.BASE_URL + "ballads") && "active"]}>Ballads</a>
          <a href={import.meta.env.BASE_URL + "about"} class="nav-link px-3 py-2 rounded-lg" class:list={[currentPath.startsWith(import.meta.env.BASE_URL + "about") && "active"]}>About</a>
        </div>

        <!-- Dark Mode Toggle -->
        <button id="theme-toggle" class="min-w-[44px] min-h-[44px] p-3 rounded-lg text-[var(--color-ink-light)] hover:text-[var(--color-heading)] hover:bg-[var(--color-surface)] transition-colors" aria-label="Toggle dark mode" title="Toggle dark/light mode">
          <svg id="theme-icon-sun" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
          <svg id="theme-icon-moon" class="hidden" xmlns="http://www.w3.org/0000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
                <!-- Hamburger button -->
        <button id="nav-toggle" class="md:hidden min-w-[44px] min-h-[44px] p-3 rounded-lg text-[var(--color-ink-light)] hover:text-[var(--color-heading)] hover:bg-[var(--color-surface)] transition-colors" aria-label="Toggle navigation">
          <svg id="nav-icon-open" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          <svg id="nav-icon-close" class="hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>

      <!-- Mobile nav panel -->
      <div id="nav-panel" class="hidden md:hidden border-t border-[var(--color-border)] bg-[var(--color-nav-bg)] shadow-lg">
        <div class="max-w-5xl mx-auto px-4 py-3 flex flex-col gap-1">
          <a href={import.meta.env.BASE_URL} class="nav-link block py-2.5 px-3 rounded-lg hover:bg-[var(--color-surface)] transition-colors" class:list={[currentPath === import.meta.env.BASE_URL && "active"]}>🏠 Home</a>
          <a href={import.meta.env.BASE_URL + "people"} class="nav-link block py-2.5 px-3 rounded-lg hover:bg-[var(--color-surface)] transition-colors" class:list={[currentPath.startsWith(import.meta.env.BASE_URL + "people") && "active"]}>👤 People</a>
          <a href={import.meta.env.BASE_URL + "timeline"} class="nav-link block py-2.5 px-3 rounded-lg hover:bg-[var(--color-surface)] transition-colors" class:list={[currentPath.startsWith(import.meta.env.BASE_URL + "timeline") && "active"]}>📅 Timeline</a>
          <a href={import.meta.env.BASE_URL + "people/full-tree"} class="nav-link block py-2.5 px-3 rounded-lg hover:bg-[var(--color-surface)] transition-colors" class:list={[currentPath.startsWith(import.meta.env.BASE_URL + "people/full-tree") && "active"]}>🕰 Full Tree</a>
          <a href={import.meta.env.BASE_URL + "search"} class="nav-link block py-2.5 px-3 rounded-lg hover:bg-[var(--color-surface)] transition-colors" class:list={[currentPath.startsWith(import.meta.env.BASE_URL + "search") && "active"]}>🔍 Search</a>
          <a href={import.meta.env.BASE_URL + "people/families"} class="nav-link block py-2.5 px-3 rounded-lg hover:bg-[var(--color-surface)] transition-colors" class:list={[currentPath.startsWith(import.meta.env.BASE_URL + "people/families") && "active"]}>👪 Families</a>
          <a href={import.meta.env.BASE_URL + "people/dna"} class="nav-link block py-2.5 px-3 rounded-lg hover:bg-[var(--color-surface)] transition-colors" class:list={[currentPath.startsWith(import.meta.env.BASE_URL + "people/dna") && "active"]}>🧬 DNA</a>
          <a href={import.meta.env.BASE_URL + "ballads"} class="nav-link block py-2.5 px-3 rounded-lg hover:bg-[var(--color-surface)] transition-colors" class:list={[currentPath.startsWith(import.meta.env.BASE_URL + "ballads") && "active"]}>🎵 Ballads</a>
          <a href={import.meta.env.BASE_URL + "about"} class="nav-link block py-2.5 px-3 rounded-lg hover:bg-[var(--color-surface)] transition-colors" class:list={[currentPath.startsWith(import.meta.env.BASE_URL + "about") && "active"]}>📖 About</a>
        </div>
      </div>
    </nav>

    <!-- Main content -->
    <main class="max-w-5xl mx-auto px-3 sm:px-4 py-4 sm:py-8 flex-1 w-full">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-[var(--color-border)] bg-[var(--color-surface)] no-print">
      <div class="max-w-5xl mx-auto px-4 py-4 sm:py-6 text-center text-sm text-[var(--color-muted)]">
        <p class="font-serif italic">Telfer Wiki — a living family history archive. From the Scottish lowlands to the South Australian plains.</p>
        <p class="mt-1">
          Data sourced from the Telfer Family History archive.
          <span class="text-xs">Built by Skippy the Magnificent &amp; The Librarian.</span>
        </p>
      </div>
    </footer>
  </body>
</html>

<script>

  // ── Dark mode toggle ──
  const themeToggle = document.getElementById('theme-toggle');
  const sunIcon = document.getElementById('theme-icon-sun');
  const moonIcon = document.getElementById('theme-icon-moon');

  function setTheme(theme) {
    if (theme === 'dark') {
      document.documentElement.setAttribute('data-theme', 'dark');
      if (sunIcon) sunIcon.classList.add('hidden');
      if (moonIcon) moonIcon.classList.remove('hidden');
    } else {
      document.documentElement.removeAttribute('data-theme');
      if (sunIcon) sunIcon.classList.remove('hidden');
      if (moonIcon) moonIcon.classList.add('hidden');
    }
    localStorage.setItem('telfer-wiki-theme', theme);
  }

  if (themeToggle) {
    var currentTheme = document.documentElement.getAttribute('data-theme');
    if (currentTheme === 'dark') {
      if (sunIcon) sunIcon.classList.add('hidden');
      if (moonIcon) moonIcon.classList.remove('hidden');
    }

    themeToggle.addEventListener('click', function() {
      var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      setTheme(isDark ? 'light' : 'dark');
    });

    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
      if (!localStorage.getItem('telfer-wiki-theme')) {
        setTheme(e.matches ? 'dark' : 'light');
      }
    });
  }

  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('nav-panel');
  const iconOpen = document.getElementById('nav-icon-open');
  const iconClose = document.getElementById('nav-icon-close');

  if (toggle && panel) {
    toggle.addEventListener('click', () => {
      const isOpen = !panel.classList.contains('hidden');
      panel.classList.toggle('hidden');
      iconOpen?.classList.toggle('hidden');
      iconClose?.classList.toggle('hidden');
      toggle.setAttribute('aria-expanded', String(!isOpen));
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (!panel.classList.contains('hidden') && !toggle.contains(e.target) && !panel.contains(e.target)) {
        panel.classList.add('hidden');
        iconOpen?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
      }
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.classList.contains('hidden')) {
        panel.classList.add('hidden');
        iconOpen?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.focus();
      }
    });
  }
</script>

<style is:global>
  @import "tailwindcss";

  @theme {
    --color-paper: #faf8f3;
    --color-paper-dark: #f0ebe0;
    --color-ink: #2d2926;
    --color-ink-light: #5a5448;
    --color-accent: #a67c52;
    --color-accent-hover: #b88d5e;
    --color-heading: #7b2d2d;
    --color-heading-hover: #8b3a3a;
    --color-secondary: #6b7a8f;
    --color-secondary-hover: #7a8ba8;
    --color-link: #6b7a8f;
    --color-link-hover: #7b2d2d;
    --color-highlight: #b8860b;
    --color-highlight-light: #c9961a;
    --color-border: #c9b896;
    --color-surface: #f0ebe0;
    --color-muted: #9a8f7a;
    --font-serif: "Playfair Display", Georgia, "Times New Roman", serif;
    --font-sans: Inter, system-ui, -apple-system, sans-serif;
    --font-mono: "JetBrains Mono", "Fira Code", monospace;
    --leading-relaxed: 1.6;
    --leading-loose: 1.7;
  }

  /* ── Light mode CSS custom properties (Heritage Parchment) ── */
  :root {
    --color-paper: #faf8f3;
    --color-paper-dark: #f0ebe0;
    --color-ink: #2d2926;
    --color-ink-light: #5a5448;
    --color-accent: #a67c52;
    --color-accent-hover: #b88d5e;
    --color-heading: #7b2d2d;
    --color-heading-hover: #8b3a3a;
    --color-secondary: #6b7a8f;
    --color-secondary-hover: #7a8ba8;
    --color-link: #6b7a8f;
    --color-link-hover: #7b2d2d;
    --color-highlight: #b8860b;
    --color-highlight-light: #c9961a;
    --color-border: #c9b896;
    --color-surface: #f0ebe0;
    --color-muted: #9a8f7a;
    --color-card-bg: #ffffff;
    --color-input-bg: #fdfcf8;
    --color-nav-bg: rgba(250, 248, 243, 0.85);
  }

  body {
    background-color: var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-sans);
    line-height: 1.4;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-serif);
    color: var(--color-heading);
    line-height: 1.15;
  }
  h1 { font-size: 1.75rem; font-weight: 700; letter-spacing: -0.02em; }
  h2 { font-size: 1.35rem; font-weight: 600; margin-top: 0.4rem; }
  h3 { font-size: 1.1rem; font-weight: 600; }

  @media (min-width: 640px) {
    h1 { font-size: 2.5rem; }
    h2 { font-size: 1.75rem; margin-top: 0.6rem; }
    h3 { font-size: 1.25rem; }
  }

  /* Links: gold underline only in prose/content areas */
  .wiki-content a {
    color: var(--color-link);
    text-decoration: underline;
    text-decoration-color: var(--color-highlight);
    text-underline-offset: 3px;
    text-decoration-thickness: 2px;
    transition: color 0.15s, text-decoration-color 0.15s;
  }
  .wiki-content a:hover {
    color: var(--color-link-hover);
    text-decoration-color: var(--color-highlight-light);
  }

  /* Nav links, person cards, buttons - no gold underline */
  .nav-link,
  .person-card a,
  button a,
  .no-underline,
  a.no-underline {
    text-decoration: none;
  }
  .nav-link:hover,
  .person-card a:hover {
    text-decoration: none;
  }

  .wiki-content {
    font-size: 1rem;
    line-height: 1.35;
  }

  @media (min-width: 640px) {
    .wiki-content { font-size: 1.05rem; }
  }

  .wiki-content p { margin-bottom: 0.15rem; }
  @media (min-width: 640px) {
    .wiki-content p { margin-bottom: 0.25rem; }
  }

  /* Tables: horizontally scrollable on mobile */
  .wiki-content table {
    width: 100%; border-collapse: collapse; margin: 0.5rem 0; font-size: 0.85rem;
  }
  @media (min-width: 640px) {
    .wiki-content table { font-size: 0.95rem; }
  }

  /* Wrap tables in a scrollable container */
  .wiki-content :not(.table-wrapper) > table {
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    white-space: nowrap;
  }

  .wiki-content th {
    background-color: var(--color-heading); color: white;
    font-family: var(--font-sans); font-weight: 600;
    text-align: left; padding: 0.4rem 0.5rem;
  }
  @media (min-width: 640px) {
    .wiki-content th { padding: 0.5rem 0.75rem; }
  }
  .wiki-content td {
    padding: 0.3rem 0.5rem; border-bottom: 1px solid var(--color-border);
  }
  @media (min-width: 640px) {
    .wiki-content td { padding: 0.4rem 0.75rem; }
  }
  .wiki-content tr:nth-child(even) td { background-color: var(--color-surface); }
  .wiki-content blockquote {
    border-left: 3px solid var(--color-highlight); padding-left: 0.75rem;
    margin: 0.4rem 0; color: var(--color-ink-light); font-style: italic;
  }
  .wiki-content hr {
    border: none; border-top: 1px solid var(--color-border); margin: 0.5rem 0;
  }
  .wiki-content ul, .wiki-content ol { padding-left: 1.25rem; margin-bottom: 0.25rem; }
  .wiki-content li { margin-bottom: 0.1rem; }
  .wiki-content code {
    background-color: var(--color-surface); padding: 0.15rem 0.4rem;
    border-radius: 3px; font-family: var(--font-mono); font-size: 0.9em;
  }

  .nav-link {
    position: relative;
    color: var(--color-ink-light);
    text-decoration: none;
    font-family: var(--font-serif);
    font-weight: 500;
    padding: 0.25rem 0;
    transition: color 0.15s;
  }
  .nav-link:hover {
    color: var(--color-heading);
    text-decoration: none;
  }
  .person-card { 
    background: var(--color-card-bg); 
    border: 2px solid var(--color-border); 
    border-radius: 12px;
    transition: box-shadow 0.25s, border-color 0.25s, transform 0.15s; 
  }
  .person-card:hover { 
    border-color: var(--color-heading); 
    box-shadow: 0 8px 24px rgba(45, 41, 38, 0.12);
    transform: translateY(-2px);
  }

  .badge-living { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
  .badge-deceased { background: var(--color-surface); color: var(--color-muted); border: 1px solid var(--color-border); }

  .timeline-line { position: relative; }
  .timeline-line::before {
    content: ""; position: absolute; left: 0; top: 0.5rem; bottom: 0;
    width: 2px; background: var(--color-border);
  }
  .timeline-line::after {
    content: ""; position: absolute; left: -5px; top: 0.5rem;
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--color-accent); border: 3px solid var(--color-paper);
  }
  .timeline-line:last-child::before { display: none; }

  .nav-link.active { color: var(--color-heading); font-weight: 600; }
  .nav-link.active::after {
    content: ""; position: absolute; bottom: -2px; left: 0; right: 0;
    height: 2px; background: var(--color-highlight);
  }

  /* Mobile nav: active state with background instead of underline */
  @media (max-width: 767px) {
    .nav-link.active {
      background-color: var(--color-surface);
      border-left: 3px solid var(--color-highlight);
    }
    .nav-link.active::after {
      display: none;
    }
  }

  @media print {
    body { background: white; }
    nav { display: none; }
    .no-print { display: none; }
  }

  /* ── Dark mode overrides (Heritage Candlelight) ───────── */
  [data-theme="dark"] {
    --color-paper: #1a1612;
    --color-paper-dark: #15110f;
    --color-ink: #e8dcc8;
    --color-ink-light: #c4b8a0;
    --color-accent: #c49a6c;
    --color-accent-hover: #d4aa7a;
    --color-heading: #c97b7b;
    --color-heading-hover: #d49696;
    --color-secondary: #8aa8c4;
    --color-secondary-hover: #9db8d4;
    --color-link: #8aa8c4;
    --color-link-hover: #c97b7b;
    --color-highlight: #d4a843;
    --color-highlight-light: #e0b85a;
    --color-border: #4a4235;
    --color-surface: #231e18;
    --color-muted: #8a7f6f;
    --color-card-bg: #1f1a15;
    --color-input-bg: #231e18;
    --color-nav-bg: rgba(26, 22, 18, 0.85);
  }
  [data-theme="dark"] body {
    background-color: var(--color-paper);
    color: var(--color-ink);
  }
  [data-theme="dark"] .person-card {
    background: var(--color-card-bg);
  }
  [data-theme="dark"] .person-card:hover {
    box-shadow: 0 2px 12px rgba(0,0,0,0.25);
  }
  [data-theme="dark"] .search-input {
    background: var(--color-input-bg);
    color: var(--color-ink);
  }
  [data-theme="dark"] .badge-living {
    background: #1a3a1a;
    color: #7fd18f;
    border-color: #2a5a2a;
  }
  [data-theme="dark"] .badge-deceased {
    background: var(--color-surface);
    color: var(--color-muted);
    border-color: var(--color-border);
  }
  [data-theme="dark"] img {
    opacity: 0.9;
  }
  [data-theme="dark"] ::selection {
    background: var(--color-heading);
    color: white;
