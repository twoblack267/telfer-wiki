    --color-paper-dark: #f0ebe0;
    --color-ink: #2d2926;
    --color-ink-light: #5a5448;
    --color-accent: #a67c52;
    --color-accent-hover: #b88d5e;
    --color-heading: #7b2d2d;
    --color-heading-hover: #8b3a3a;
    --color-secondary: #6b7a8f;
    --color-secondary-hover: #7a8ba8;
    --color-link: #5f6f84;
    --color-link-hover: #7b2d2d;
    --color-highlight: #b8860b;
    --color-highlight-light: #c9961a;
    --color-border: #c9b896;
    --color-surface: #f0ebe0;
