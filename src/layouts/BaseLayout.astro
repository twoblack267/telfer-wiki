    </svg>
    <style is:inline>
      /* Brand ink sampled from the banyan logo (#8A1B3B), not the theme's
         #7b2d2d heading colour - the logo is the reference. */
      :root{--nav-ink:#8A1B3B;--nav-ink-hover:#6d1430}
      [data-theme="dark"]{--nav-ink:#d98aa4;--nav-ink-hover:#ecb3c5}
      svg.nav-ico{width:22px;height:22px;flex:0 0 auto;stroke:currentColor;stroke-width:1.5;fill:none;transition:transform .2s ease}
      /* Page-body icons (titles, tabs, lists, inputs): same engraving weight and
         brand ink as the nav, but sized to their own context. */
      svg.pg-ico{stroke:var(--nav-ink);color:var(--nav-ink);stroke-width:1.5;fill:none;flex:0 0 auto}
      svg.pg-ico[width="48"]{stroke-width:1.4}
      /* Vault evidence marks rendered as inline SVG (see utils/vault-marks.mjs).
         Sized in em so they track whatever text they sit in - prose, a table
         cell, or an H2 heading. */
      svg.vault-mark{display:inline-block;vertical-align:-0.12em;margin-right:.34em;flex:0 0 auto}
      /* A mark opening a heading needs the gap on its leading side too, or it
         presses against the first letter. */
      h1>svg.vault-mark:first-child,h2>svg.vault-mark:first-child,h3>svg.vault-mark:first-child{margin-left:.06em}
      @media (max-width:640px){svg.vault-mark{width:1.05em;height:1.05em}}
      .nav-link:hover svg.nav-ico{transform:translateY(-1px)}
      .nav-link.active svg.nav-ico{stroke-width:1.9}
      /* Layout is inline so it cannot be lost if Tailwind's content scan misses
         these utility classes again (it did - flex/gap/px were dropped). */
      /* Tailwind's lg: utilities for these buttons are not in the compiled CSS,
         so pin their visibility here instead of trusting the class list. */
      /* Header stacking (2026-11-04). The drawer is a left panel that starts
         below the header, and the scrim now dims everything else including the
         header strip. Without an explicit z-index on the header the close button
         ended up UNDER the scrim and could not be clicked. 60 puts the header
         above the scrim (40) and above the panel (45). */
      body>nav.no-print{position:sticky;z-index:60}
      /* 44px hit area is the accessibility floor; the button was 24px of icon
         with padding inside a flex row that clipped it on narrow screens. */
      #nav-toggle{display:inline-flex;align-items:center;justify-content:center;
        min-width:44px;min-height:44px;padding:0;background:none;border:0;cursor:pointer;
        color:inherit;border-radius:.5rem}
      #nav-toggle:focus-visible{outline:2px solid var(--color-heading);outline-offset:2px}
      @media(min-width:1024px){#nav-toggle{display:none}}
      /* nav-desktop below lg (2026-11-04). It previously carried Tailwind's
         `hidden` class, which is emitted into the external stylesheet as
         `.hidden{display:none}` — and an external rule beats an inline one on
         specificity ties, so `#nav-desktop.is-open{display:flex}` lost and the
         drawer NEVER appeared. Pinned inline here instead; the `hidden` class
         was removed from the element in the same pass. */
      #nav-desktop{display:none;align-items:center;gap:.25rem}
      @media(min-width:1024px){#nav-desktop{display:flex}}
      /* Mobile drawer (2026-11-04). Two defects fixed here:
         1. --color-nav-bg is #1a1612d9 — 8-digit hex, alpha d9 = 85% opaque. That
            translucency is deliberate for the sticky header (backdrop-blur reads
            through it), but the drawer inherited the same token, so timeline
            entries were legible THROUGH the open menu. It looked like a menu
            floating mid-page over washed-out content. The drawer now gets an
            opaque surface derived from the same palette.
         2. There was no backdrop behind the open drawer, so the page stayed
            fully lit around it. A scrim is now drawn below the panel. */
      #nav-desktop.is-open{display:flex;flex-direction:column;
        position:fixed;left:0;top:var(--nav-h,4.75rem);
        /* Two rounds of fixes (2026-11-04). This panel lives inside <nav>,
           which carries backdrop-blur-sm - and a backdrop-filter makes the nav
           a containing block for position:fixed descendants. With bottom:0 the
           panel resolved against the 77px header and collapsed to 44px.
           Round 1 gave it a calc() dvh height, which fixed desktop emulation
           but is still a VIEWPORT-CLAMPED value: on a phone where the URL bar
           is showing, dvh can shrink below the content and clip the menu.
           Round 2 lets the panel size to its CONTENT with a viewport cap, so
           it stops a comfortable gap below the last link instead of running to
           the bottom of the screen. max-height keeps it scrollable on short
           landscape viewports; it never shrinks below the content that fits. */
        height:auto;
        max-height:calc(100vh - var(--nav-h,4.75rem) - 1.25rem);
        max-height:calc(100dvh - var(--nav-h,4.75rem) - 1.25rem);
        width:min(19rem,82vw);
        gap:.15rem;padding:.75rem 1rem 1.25rem;align-items:stretch;
        background:var(--color-nav-solid, var(--color-surface));
        border-right:1px solid var(--color-border);
        box-shadow:8px 0 24px rgba(0,0,0,.55);
        overflow-y:auto;overscroll-behavior:contain;z-index:45}
      /* Rows fill the panel and read left-to-right. Without this each link was
         only as wide as its own label, so the icons never lined up in a column
         and the active pill looked like a stray floating button. */
      #nav-desktop.is-open>a.nav-link{display:flex;width:100%;justify-content:flex-start;text-align:left}
      /* The scrim (2026-11-04). It lives OUTSIDE <nav> as a body child, because
         the sticky header's backdrop-filter makes the nav a containing block for
         fixed-position descendants — inside it, this element filled only the
         77px header and measured 0px tall. Revealed by body.nav-open, set by the
         same setOpen() that drives the panel.
         It now covers the header too (top:0), because the drawer is a left
         side panel: leaving the header bright above a dimmed page looked like
         two unrelated layers. z-index 40 sits under the panel's 45 and under
         nothing else.
         THE NOV 2026 BLACK BAR (fixed). The rule below used to be
         `opacity:0` only. An element at opacity 0 still takes part in layout,
         and #nav-scrim is a position:fixed body child with all four offsets
         set - so its static position resolved to the top-left corner and it
         behaved as an in-flow flex ITEM of <body> (which is a flex column).
         That gave the body a phantom full-width first row, pushed the page
         right (dead strip up the left edge) and made the top bar stop short
         of the right edge. `display:none` removes it from flow entirely; it
         is only ever needed below the lg breakpoint, where
         `body.nav-open #nav-scrim` flips it back to display:block. */
      #nav-scrim{display:none}
      body.nav-open #nav-scrim{display:block;position:fixed;top:0;right:0;bottom:0;left:0;
        background:rgba(0,0,0,.55);z-index:40;opacity:1;pointer-events:auto;
        transition:opacity .18s ease}
      /* Scrim styling lives ONLY under body.nav-open (see the rule above).
         WHY (2026-11-04, the gap that would not close): this block used to
         give the scrim `top:0;right:0;bottom:0;left:0`. `display:none` does
         remove it from flow, but a position:fixed element with all four
         offsets set ALSO contributes its scrollable overflow rectangle to the
         document — so the page's scrollWidth jumped to
           window width + left inset + right inset
         That extra width is what stopped the header short of the right wall
         and what made the content look pinched: the viewport was scrolled
         0..N with the real page only filling the left part. Nothing visible
         was painting the gap, which is why pixel probes and CSS greps all came
         back clean. Removing the four offsets from the hidden state is what
         actually closes it. Do not restore them here. */
      @media(min-width:1024px){#nav-desktop.is-open{position:static;flex-direction:row;box-shadow:none;border-top:0;padding:0;max-height:none}}
      /* THE TOP BAR NOT SPANNING (fixed). Why the header read as a strip rather
         than a full-width bar: <nav> is painted with --color-nav-bg, which is
         rgba(...,0.85) - an 85% opaque surface over whatever is behind it. With
         nothing painted on <html>/<body> there IS nothing behind it, so the
         15% transparency composited to black in light mode. The bar looked dark
         and half-width because the only place the page paper showed through was
         the max-w-5xl content column. Paint the paper on the root so the bar has
         the page behind it, as the token always assumed. */
      html{background-color:var(--color-paper)}
      body{background-color:var(--color-paper)}
      body>nav.no-print{background-color:var(--color-nav-bg)}
      /* FULL-BLEED BAR (2026-11-04, Mark's "top isn't going across properly").
         The bar has always been background-painted edge to edge, but its INNER
         CONTENT lived in a max-w-5xl (1024px) centred wrapper - so on a MacBook
         (~1440-1512px) the painted strip ran full width while the logo and links
         sat in a 1024px island with 200-250px of empty bar either side. That
         reads as "not going across": the eye measures the content, not the paint.
         The bar's content is now aligned to the same gutters as <main> at every
         width below 1024px and allowed to use the full width above it, so the
         header content and the page content share one grid. Main keeps its
         readable measure and is aligned the same way by the rule below. */
      @media(min-width:1024px){
        body>nav.no-print>div{max-width:none;padding-left:2rem;padding-right:2rem}
      }
      /* Overflow containment (2026-11-04). The bar previously burst its container:
         14 items needed 1347px inside a 1024px max-w-5xl wrapper, nothing wrapped,
         so the document grew to 1641px wide and the whole page scrolled sideways.
         flex-wrap keeps any future growth INSIDE the bar rather than off-document. */
      nav>div{min-width:0}
      /* Desktop-only containment (2026-11-04). This rule ran globally, which was
         a defect in its own right: the mobile drawer inherits #nav-desktop, so
         justify-content:flex-end threw every drawer link to the RIGHT edge of a
         full-width panel. Measured link left edges were 145/144/137/137/139/144/
         142/133/151px — a ragged column floating in the middle of the screen,
         which is exactly how it looked. Scoped to desktop. */
      @media(min-width:1024px){#nav-desktop{flex-wrap:wrap;justify-content:flex-end;min-width:0;max-width:100%}}
      nav a.nav-link{display:inline-flex;align-items:center;gap:.4rem;padding:.5rem .6rem;border-radius:.5rem;text-decoration:none;
        color:var(--nav-ink);font-size:.875rem;letter-spacing:.01em}
      nav a.nav-link:hover{color:var(--nav-ink-hover);background:var(--color-surface)}
      nav a.nav-link.active{color:var(--nav-ink);background:var(--color-surface)}
      @media(max-width:1023px){
        svg.nav-ico{width:24px;height:24px}
        nav a.nav-link{gap:.65rem;padding:.6rem .75rem;justify-content:flex-start}
      }
    </style>

    <!-- Navigation -->
    <nav class="border-b-2 border-[var(--color-border)] bg-[var(--color-nav-bg)] backdrop-blur-sm sticky top-0 z-50 no-print">
      <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href={import.meta.env.BASE_URL} class="nav-link text-lg sm:text-xl font-serif font-bold text-[var(--color-heading)] hover:text-[var(--color-heading-hover)] no-underline flex items-center gap-2">
          <img
            src={import.meta.env.BASE_URL + "images/brand/telfer-fig-80.png"}
            srcset={`${import.meta.env.BASE_URL}images/brand/telfer-fig-80.png 80w, ${import.meta.env.BASE_URL}images/brand/telfer-fig-96.png 96w`}
            sizes="40px"
            alt=""
            aria-hidden="true"
            width="40"
            height="40"
            loading="eager"
            decoding="async"
            class="h-8 w-8 sm:h-10 sm:w-10 object-contain shrink-0"
          />
          Telfer Wiki
        </a>

        <!-- THE site menu (2026-11-03) — the only <nav> link list in the DOM.
             It renders as a row on desktop and as a stacked panel on mobile, so
             a page never carries two copies of the same links. The hamburger
             above only toggles this one element's visibility below the lg
             breakpoint; nothing is duplicated for a second breakpoint.
             Guarded by scripts/guard-presentation-integrity.mjs (rule P2b). -->
        <div id="nav-desktop" class="lg:flex gap-1 items-center">
          {/* `hidden` items stay in NAV (so the route and its active-state match
              still work) but are not advertised. DNA is hidden while its page is
              a stub — see NAV comment. */}
          {NAV.filter((n) => !n.hidden).map((n) => (
            <a
              href={import.meta.env.BASE_URL + n.href}
              class="nav-link flex items-center gap-1.5 px-2.5 py-2 rounded-lg"
              class:list={[navIsActive(n) && "active"]}
              title={n.href === "downloads/" ? "Family Resource Downloads" : n.label}
            >
              <svg class="nav-ico" aria-hidden="true" focusable="false"><use href={`#${n.icon}`}></use></svg><span>{n.label}</span>
            </a>
          ))}
        </div>


        <!-- Header actions. These two buttons were siblings of a
             justify-content:space-between row, so the theme toggle drifted to
             the middle of the bar on a phone with a large dead gap either side
             of it. They are now one grouped cluster pinned to the right, which
             is where a user expects secondary actions. -->
        <div class="flex items-center gap-1 shrink-0">
        <!-- Dark Mode Toggle -->
        <button id="theme-toggle" class="min-w-[44px] min-h-[44px] p-3 rounded-lg text-[var(--color-ink-light)] hover:text-[var(--color-heading)] hover:bg-[var(--color-surface)] transition-colors" aria-label="Toggle dark mode" title="Toggle dark/light mode">
          <svg id="theme-icon-sun" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
          <svg id="theme-icon-moon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
                <!-- Hamburger button -->
        <button id="nav-toggle" class="lg:hidden min-w-[44px] min-h-[44px] p-3 rounded-lg text-[var(--color-ink-light)] hover:text-[var(--color-heading)] hover:bg-[var(--color-surface)] transition-colors" aria-label="Toggle navigation">
          <svg id="nav-icon-open" style="display:block" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          <svg id="nav-icon-close" style="display:none" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
        </div>
      </div>

    </nav>

    <!-- Main content -->
    <main class="dashboard-main max-w-5xl mx-auto px-3 sm:px-4 py-4 sm:py-8 flex-1 w-full">
      <!-- The page's own content (person title, biography, etc.) renders FIRST so a
           viewer always sees the person's name/heading before any SEO helper blocks. -->
      <slot />
      <!-- SEO helper blocks (story blurb + FAQ) are appended AFTER the page content
           so they never push the person's title below the fold on mobile. -->
      {storyBlurb && (
        <section aria-label="Story blurb" class="person-card rounded-xl p-3 md:p-4 mt-4">
          <h2 class="text-lg md:text-xl font-bold font-serif text-[var(--color-heading)] mb-2">Their Story</h2>
          <p class="wiki-content leading-relaxed">{storyBlurb}</p>
        </section>
      )}
      {faqItems && faqItems.length > 0 && (
        <section aria-label="Frequently asked questions" class="person-card rounded-xl p-3 md:p-4 mt-4">
          <h2 class="text-lg md:text-xl font-bold font-serif text-[var(--color-heading)] mb-2">Common Questions</h2>
          <dl class="wiki-content divide-y divide-[var(--color-border)]">
            {faqItems.map((f) => (
              <div class="py-2">
                <dt class="font-semibold text-[var(--color-heading)]">{f.q}</dt>
                <dd class="mt-0.5">{f.a}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}
      {curatedMap ? (
        <section aria-label={curatedMap.title} class="person-card rounded-xl p-3 md:p-4 mt-4">
          <h2 class="text-lg md:text-xl font-bold font-serif text-[var(--color-heading)] mb-2">{curatedMap.label}</h2>
          <iframe
            title={curatedMap.title}
            src={`https://www.google.com/maps?q=${curatedMap.latlng}&z=${curatedMap.z}&output=embed`}
            width="100%"
            height="380"
            style={{ border: 0 }}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
          <p class="mt-1 text-xs text-[var(--color-muted)]">{curatedMap.caption} <a href={`https://www.google.com/maps?q=${curatedMap.latlng}`} class="text-[var(--color-link)]" target="_blank" rel="noopener">Open in Google Maps →</a></p>
        </section>
      ) : null}

      <!-- Navigation footer (Back to all people / Descendant Chart / Family Sheet)
           rendered as the LAST block on the page, after Common Questions + map,
           so these three links are always at the very bottom (Mark 2026-08-30). -->
      {navState && (
        <div class="mt-3 flex justify-between items-center border-t border-[var(--color-border)] pt-2 text-sm">
          <a href={import.meta.env.BASE_URL + "people/"} class="text-[var(--color-link)]">← Back to all people</a>
          <div class="flex items-center gap-4">
            {navState.showDescendants && (
              <a href={import.meta.env.BASE_URL + "people/" + navState.slug + "/descendants/"} class="text-[var(--color-link)] hover:underline text-right">
                <svg class="pg-ico" width="17" height="17" aria-hidden="true" focusable="false" style="vertical-align:-2px;margin-right:.3rem;display:inline-block"><use href="#i-timeline"></use></svg>Descendant Chart →
