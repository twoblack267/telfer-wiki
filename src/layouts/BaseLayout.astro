      <symbol id="i-families" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="6.2" cy="6.4" r="2.2"/><path d="M2.8 14.6v-1.1c0-1.8 1.5-2.9 3.4-2.9s3.4 1.1 3.4 2.9v1.1"/><circle cx="17.8" cy="6.4" r="2.2"/><path d="M14.4 14.6v-1.1c0-1.8 1.5-2.9 3.4-2.9s3.4 1.1 3.4 2.9v1.1"/><path d="M6.2 12.2h11.6"/><path d="M12 12.2v2.2"/><circle cx="12" cy="17.6" r="1.8"/></symbol>
      <symbol id="i-dna" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.4L12.93 3.83L13.82 4.26L14.6 4.69L15.24 5.12L15.7 5.55L15.95 5.98L15.99 6.41L15.8 6.84L15.41 7.27L14.83 7.7L14.09 8.13L13.24 8.56L12.31 8.99L11.37 9.42L10.47 9.85L9.65 10.28L8.96 10.71L8.44 11.14L8.11 11.57L8 12L8.11 12.43L8.44 12.86L8.96 13.29L9.65 13.72L10.47 14.15L11.37 14.58L12.31 15.01L13.24 15.44L14.09 15.87L14.83 16.3L15.41 16.73L15.8 17.16L15.99 17.59L15.95 18.02L15.7 18.45L15.24 18.88L14.6 19.31L13.82 19.74L12.93 20.17L12 20.6"/><path d="M12 3.4L11.07 3.83L10.18 4.26L9.4 4.69L8.76 5.12L8.3 5.55L8.05 5.98L8.01 6.41L8.2 6.84L8.59 7.27L9.17 7.7L9.91 8.13L10.76 8.56L11.69 8.99L12.63 9.42L13.53 9.85L14.35 10.28L15.04 10.71L15.56 11.14L15.89 11.57L16 12L15.89 12.43L15.56 12.86L15.04 13.29L14.35 13.72L13.53 14.15L12.63 14.58L11.69 15.01L10.76 15.44L9.91 15.87L9.17 16.3L8.59 16.73L8.2 17.16L8.01 17.59L8.05 18.02L8.3 18.45L8.76 18.88L9.4 19.31L10.18 19.74L11.07 20.17L12 20.6"/><path d="M14.83 7.7h-5.66"/><path d="M14.83 16.3h-5.66"/></symbol>
      <symbol id="i-ballads" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="7.4" cy="18" rx="2.5" ry="1.9"/><ellipse cx="16.6" cy="16.4" rx="2.5" ry="1.9"/><path d="M9.9 18V7.4"/><path d="M19.1 16.4V5.8"/><path d="M9.9 7.4 19.1 5.8"/><path d="M9.9 10.1 19.1 8.5"/></symbol>
