---
interface Props {
  title: string;
  description?: string;
  // Optional SEO enhancement props (all optional — existing callers unaffected)
  canonicalPath?: string;          // e.g. "/people/elizabeth-beattie"
  ogType?: string;                 // "website" | "article" | "profile"
  ogImage?: string;                // absolute or relative URL to share thumbnail
  schema?: object | object[];      // single Schema.org object, OR array for multiple JSON-LD blocks (e.g. Person + FAQPage)
  faqItems?: { q: string; a: string }[];   // visible FAQ section on the page (also emits FAQPage schema via `schema`)
  storyBlurb?: string;                       // optional AI/SEO story blurb for curated ancestors
  noindex?: boolean;                         // privacy: emit robots noindex, nofollow + suppress JSON-LD
  navState?: {                              // person-page nav footer data — renders the three links
    slug: string;                            //   at the VERY BOTTOM of the page (after FAQ/map)
    showDescendants: boolean;                //   Back to all people / Descendant Chart / Family Sheet
    showFamily: boolean;
  } | null;
}
const { title, description, canonicalPath, ogType, ogImage, schema, faqItems, storyBlurb, noindex, navState } = Astro.props;
import { clampDescription, decodeDescriptionEntities, META_DESCRIPTION_MAX } from "../utils/meta-description.mjs";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
const currentPath = Astro.url.pathname;
const canonicalUrl = canonicalPath ? `https://telferwiki.com${canonicalPath}` : Astro.url.origin + Astro.url.pathname;
const defaultDescription = clampDescription("The Telfer Family Wiki — a digital family history archive tracing nine generations of Telfers from Scotland to South Australia. A living record of the family line from John Telfer of Castleton to the present day.");
// Decode entities HERE, in the layout, because this is the exact point the value becomes
// HTML: Astro escapes whatever string it is given, so a description that already contains
// a real '"' would be re-encoded to &#34; and Google shows the escape instead of the quote.
// Decoding at the source cannot survive that round trip — 22 pages shipped raw &#34;
// (card itc-20261026-2). Do it once, at the boundary, for every page in the wiki.
const resolvedDescription = decodeDescriptionEntities(clampDescription(description || defaultDescription));
// Astro's attribute writer re-encodes a `"` inside a content= value to the numeric form
// `&#34;`, which some crawlers and social scrapers then show literally — 45+ pages shipped
// `known as &#34;Mimie&#34;` (card tw-2026-10-31-002). Emit the attribute ourselves with a single
// correct escape pass so a quote becomes a real quote character in the delivered string.
// DOUBLE-ENCODING IS THE SAME DEFECT AS NO ENCODING. The description built by the person
// template usually arrives already entity-encoded upstream ("known as &quot;Cliff&quot;"), and
// escaping that a second time produced `&amp;quot;` — the browser then shows a literal
// `&quot;` in the snippet on 29 person pages. Decode to plain text first, then escape once.
const escapeAttr = (t) => String(t == null ? "" : t)
  .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
// A `"` inside content="…" is DELIVERED as the named entity (&quot;), which is valid HTML and
// is what the browser decodes to a real quote. Numeric forms are what scrapers mishandle, so
// they stay banned (the hygiene gate enforces that); the named form is correct output.
const descAttr = escapeAttr(decodeDescriptionEntities(resolvedDescription));
const descCharsAttr = escapeAttr(String(resolvedDescription.length));
const resolvedOgType = ogType || "website";
const resolvedOgImage = ogImage || "https://telferwiki.com/telferwiki-og.png";
// When a page is noindexed for privacy, drop structured data entirely (no schema
// signal for Google/AI to latch onto) and suppress Open Graph/JSON-LD bloat.
const jsonLd = (!noindex && schema) ? (Array.isArray(schema) ? schema : [schema]) : null;

// ── Last revision (added 2026-11-03) ────────────────────────────────────────
// The visible "Last revision" line in the footer. Source of truth is
// src/data/lastmod.json — git last-commit dates of the Obsidian vault files,
// generated by scripts/gen-lastmod.mjs. Same data the sitemap uses for
// <lastmod>, so the page and the sitemap can never disagree.
//
// Person pages get THEIR OWN file's date. Everything else (indexes, static
// pages) has no vault file of its own, so it shows the newest date in the map
// and the label says "archive" rather than implying that page alone changed.
//
// If lastmod.json is missing or empty, the line is omitted entirely. It is
// never backfilled with build time — that would claim the whole site changed
// on every deploy, which is the exact false signal this is meant to avoid.
const lastmodMap: Record<string, string> = (() => {
  try {
    const raw = readFileSync(resolve(process.cwd(), "src/data/lastmod.json"), "utf-8");
    const parsed = JSON.parse(raw) as { people?: Record<string, string> };
    return parsed.people || {};
  } catch {
    return {};
  }
})();

const personSlugMatch = currentPath.match(/\/people\/([^/]+)\/?$/);
const ownDate = personSlugMatch ? lastmodMap[personSlugMatch[1]] : undefined;
const newestDate = (() => {
  let best = "";
  let bestTime = 0;
  for (const iso of Object.values(lastmodMap)) {
    const t = new Date(iso).getTime();
    if (!Number.isNaN(t) && t > bestTime) {
      bestTime = t;
      best = iso;
    }
  }
  return best;
})();
const revisionIso = ownDate || newestDate;
const revisionDate = revisionIso
  ? new Date(revisionIso).toLocaleDateString("en-AU", {
      day: "numeric",
      month: "short",
      year: "numeric",
      timeZone: "Australia/Brisbane",
    })
  : "";

// src/data/verified.json — slug -> { by, on }, mirrored from `verified_by` and
// `verified_on` in the person's OWN vault frontmatter by gen-verified.mjs.
//
// WHY THIS IS SEPARATE FROM THE REVISION DATE
// The revision date says "a file changed". This says "a person read it and
// stands behind it". Google's 2026 guidance on machine-generated content is
// about accountability — a named human and a date they own. A page with no
// signature renders no signature block: absence is the honest signal, and
// there is deliberately no default, no fallback to the revision date and no
// nightly stamp that would manufacture one.
const verifiedMap: Record<string, { by: string; on: string }> = (() => {
  try {
    const raw = readFileSync(resolve(process.cwd(), "src/data/verified.json"), "utf-8");
    const parsed = JSON.parse(raw) as { people?: Record<string, { by: string; on: string }> };
    return parsed.people || {};
  } catch {
    return {};
  }
})();

const verifiedEntry = personSlugMatch ? verifiedMap[personSlugMatch[1]] : undefined;
// A signature only means something if the signer is not the compiler. Both
// ledgers can carry the compiler's own name (an old vault note, a hand-edited
// file, a bad merge); neither may render as a review. Guarded here so the
// footer cannot print a second pair of eyes that does not exist.
const SELF_NAMES = [/^mark\s*telfer$/i, /^skippy/i, /\bai\b/i, /\bbot\b/i, /language model/i, /^hermes/i];
const isSelfSignature = Boolean(
  verifiedEntry?.by && SELF_NAMES.some((re) => re.test(verifiedEntry.by))
);
const verifiedDate = verifiedEntry?.on
  ? new Date(verifiedEntry.on + "T00:00:00+10:00").toLocaleDateString("en-AU", {
      day: "numeric",
      month: "short",
      year: "numeric",
      timeZone: "Australia/Brisbane",
    })
  : "";

// Curated-place map cards. Each person page that earns a map gets one entry
// here (verified place only — see references/google-maps-embed-seo-overrides.md
// in the telfer-wiki skill). Rendered at a FIXED slot in the template (below
// Common Questions, above the nav footer) for every matching slug — one set way.
const CURATED_MAPS = {
  "james-telfer-1761": {
    label: "Where the Telfers came from — Newcastleton (formerly Castleton)",
    title: "Map of Newcastleton, formerly Castleton, Scottish Borders",
    latlng: "55.1793,-2.8136",
    z: 15,
    caption: "Newcastleton (Copshaw Holm) is the modern village on the site of the old parish of Castleton, in the Liddesdale valley of the Scottish Borders.",
  },
  "john-telfer-of-castleton": {
    label: "Where the Telfers came from — Newcastleton (formerly Castleton)",
    title: "Map of Newcastleton, formerly Castleton, Scottish Borders",
    latlng: "55.1793,-2.8136",
    z: 15,
    caption: "Newcastleton (Copshaw Holm) is the modern village on the site of the old parish of Castleton, in the Liddesdale valley of the Scottish Borders.",
  },
  "allen-merrick": {
    label: "Where Allen lived — Glasshouse Mountains, Queensland",
    title: "Map of Glasshouse Mountains, Sunshine Coast hinterland, Queensland",
    latlng: "-26.9054,152.9239",
    z: 13,
    caption: 'Allen Russell Merrick spent his later years in the Glass House Mountains area of Queensland\'s Sunshine Coast hinterland — his April 2015 funeral notice named him "late of Glasshouse Camping Ground."',
  },
  "john-telfer-1840": {
    label: "Where John Telfer is buried — Tantanoola Cemetery, South Australia",
    title: "Map of Tantanoola Cemetery, South Australia",
    latlng: "-37.68028,140.47338",
    z: 14,
    caption: "John Telfer, who died at Tantanoola on 5 January 1913, is buried in the Tantanoola Cemetery in the South East of South Australia, alongside his second wife Martha Clara (Henstridge). The town was known as Lucieton when the family settled there in 1874.",
  },
  "martha-henstridge-1854": {
    label: "Where Martha Clara is buried — Tantanoola Cemetery, South Australia",
    title: "Map of Tantanoola Cemetery, South Australia",
    latlng: "-37.68028,140.47338",
    z: 14,
    caption: "Martha Clara (Henstridge) Telfer, who died at Tantanoola on 13 November 1921 aged 67, is buried in the Tantanoola Cemetery beside her husband John Telfer.",
  },
  "john-telfer-1847": {
    label: "Where John and Caroline are buried — Clare General Cemetery, South Australia",
    title: "Map of Clare General Cemetery, South Australia",
    latlng: "-33.842625,138.6026778",
    z: 18,
    caption: "John Telfer (1847–1929) and his wife Caroline Amelia (née Masters, 1842–1929) share one headstone at Clare General Cemetery. John died on 23 August 1929 and Caroline the following day; both had lived at Willow Plains near Clare since the late 1870s, where John farmed for 47 years. The pin marks the recorded position of the grave.",
  },
  "caroline-telfer-1842": {
    label: "Where Caroline is buried — Clare General Cemetery, South Australia",
    title: "Map of Clare General Cemetery, South Australia",
    latlng: "-33.842625,138.6026778",
    z: 18,
    caption: "Caroline Amelia (née Masters) Telfer, who died at Clare on 24 August 1929 aged 87, is buried beside her husband John Telfer (1847–1929) under one joint headstone. She had come to South Australia from Warwickshire on the Templar in 1845, and taught at Tarlee before her marriage in 1874.",
  },
  "robert-campbell": {
    label: "Where the Campbells lived and died — Millicent and Mount Gambier, South Australia",
    title: "Map of Millicent, South Australia — birthplace of Robert Mewett Campbell",
    latlng: "-37.62227,140.38200",
    z: 13,
    caption: "Robert Mewett Campbell was born at Millicent, South Australia, on 20 December 1878, the son of John Campbell and Emily Mewett. Both of his parents died at Mount Gambier — his father John on 27 January 1892, his mother Emily on 13 September 1925.",
  },
};
const curatedMapSlug = Object.keys(CURATED_MAPS).find((s) => currentPath.includes(`/people/${s}/`));
const curatedMap = curatedMapSlug ? CURATED_MAPS[curatedMapSlug] : null;

/**
 * NAV — the ONE list of site links (2026-11-03).
 *
 * Why this exists: the header and the mobile panel each used to hard-code a
 * full copy of these links, so every page carried two identical menus in the
 * DOM. One array, rendered twice with different presentation, makes a second
 * divergent menu structurally impossible. Add a page here, once.
 *
 * `match` is the path prefix used to mark the current section active. Empty
 * string means "exact match on home".
 */
/**
 * NAV — the PRIMARY top-bar menu only.
 *
 * 2026-11-04: this list had grown to 14 items needing 1347px inside a 1024px
 * container (max-w-5xl). Nothing wrapped or overflowed gracefully, so the bar
 * burst its container and dragged the whole page into horizontal scroll —
 * that was the "menu floating in the middle" defect, and it took the All People
 * page down with it because the overflow is page-wide, not page-local.
 *
 * The fix is editorial, not cosmetic: the top bar carries research destinations.
 * Policy pages (Downloads / About / Contact / Privacy / Terms) live in the footer,
 * where they were ALREADY linked (see FOOTER_LINKS below) — so no destination is
 * lost and the visitor still reaches every page. Budget: 9 items ≈ 832px, which
 * fits the 1024px container with the logo and theme toggle.
 *
 * Guarded by scripts/guard-presentation-integrity.mjs (rules P9/P10).
 */
const NAV = [
  { href: "",                       label: "Home",       icon: "i-home",      match: "" },
  { href: "people/",                label: "People",     icon: "i-people",    match: "people/" },
  { href: "people/full-tree/",      label: "Full Tree",  icon: "i-full-tree", match: "people/full-tree" },
  { href: "timeline/",              label: "Timeline",   icon: "i-timeline",  match: "timeline" },
  { href: "people/families/",       label: "Families",   icon: "i-families",  match: "people/families" },
  { href: "search/",                label: "Search",     icon: "i-search",    match: "search" },
  { href: "ballads/",               label: "Ballads",    icon: "i-ballads",   match: "ballads" },
  { href: "telfer-name/",           label: "The Name",   icon: "i-about",     match: "telfer-name" },
  { href: "people/dna/",            label: "DNA",        icon: "i-dna",       match: "people/dna", hidden: true },
] as const;

/** Secondary destinations — footer only. Kept here as the canonical list so the
 *  footer and the guard agree on what must remain reachable somewhere. */
const FOOTER_ONLY = [
  { href: "downloads/", label: "Family Resource Downloads" },
  { href: "about/",     label: "About this archive" },
  { href: "contact/",   label: "Contact" },
  { href: "privacy/",   label: "Privacy" },
  { href: "terms/",     label: "Terms" },
] as const;

/**
 * Which nav item is "current".
 *
 * Fixed 2026-11-05. Mark: "I press a button it stays on as a different colour
 * when I go back". The old rule was `currentPath.startsWith(match)`, evaluated
 * per item with no knowledge of the others, so parent and child both lit up:
 * on /people/full-tree/ BOTH "People" and "Full Tree" were highlighted, and on
 * /people/families/ BOTH "People" and "Families" were. The menu was telling him
 * he was in two places at once.
 *
 * The fix is a single winner, not a filter: collect every item whose prefix
 * matches and award the LONGEST match — the most specific destination. "People"
 * loses to "Full Tree" on the full-tree page because that is genuinely where
 * he is, and a parent section is not a location you can be standing in while
 * also standing in its child.
 */
function navActiveMatch(): string {
  const base = import.meta.env.BASE_URL;
  const rest = currentPath.startsWith(base) ? currentPath.slice(base.length) : currentPath;
  let best = null as null | { href: string; match: string };
  for (const entry of NAV) {
    if ((entry as { hidden?: boolean }).hidden) continue;
    if (entry.href === "") {
      if (rest === "" && !best) best = entry;
      continue;
    }
    // Boundary-aware: "people/" must not match "peoplex/". The trailing slash
    // on directory matches already prevents that, but timeline/search/ballads
    // have none, so require either end-of-path or a "/" after the match.
    const m = entry.match;
    const hit = rest === m || rest === m + "/" || rest.startsWith(m + "/");
    if (hit && (!best || m.length > best.match.length)) best = entry;
  }
  return best ? best.href : "";
}

function navIsActive(entry: { href: string; match: string }): boolean {
  return navActiveMatch() === entry.href;
}


---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Telfer Wiki</title>
    <Fragment set:html={`<meta name="description" content="${descAttr}" />`} />
    <Fragment set:html={`<meta name="description-chars" content="${descCharsAttr}" data-encoding="decoded" />`} />
    <!-- Icons. Google's SERP icon comes from /favicon.ico and it does NOT reliably read SVG,
         so favicon.ico (multi-size 16-256px) is the one that actually matters. -->
    <link rel="icon" href={import.meta.env.BASE_URL + "favicon.ico"} sizes="any" />
    <link rel="icon" type="image/png" sizes="96x96" href={import.meta.env.BASE_URL + "favicon-96.png"} />
    <link rel="icon" type="image/png" sizes="32x32" href={import.meta.env.BASE_URL + "favicon-32.png"} />
    <link rel="icon" type="image/png" sizes="16x16" href={import.meta.env.BASE_URL + "favicon-16.png"} />
    <link rel="icon" type="image/svg+xml" href={import.meta.env.BASE_URL + "favicon.svg"} sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href={import.meta.env.BASE_URL + "apple-touch-icon.png"} />

    <!-- Google AdSense — site ownership verification (ad client ca-pub-8950658490247877) -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8950658490247877" crossorigin="anonymous"></script>

    <!-- Canonical URL (prevents duplicate-content across URL variants) -->
    <link rel="canonical" href={canonicalUrl} />

    {/* Comment is CONDITIONAL, deliberately. Emitted unconditionally it claimed a
        privacy intent on /tree/ (which never passed noindex), so the document
        advertised an exclusion it did not carry — card tw-2026-10-20-001. A
        comment that describes an action must not be able to outlive the action. */}
    {noindex && <Fragment>
    <!-- Privacy: this page IS excluded from search engine indexes (living persons) -->
    <meta name="robots" content="noindex, nofollow" />
    </Fragment>}

    <!-- Open Graph / social sharing -->
    <meta property="og:type" content={resolvedOgType} />
    <meta property="og:site_name" content="Telfer Wiki" />
    <meta property="og:title" content={title} />
    <Fragment set:html={`<meta property="og:description" content="${descAttr}" />`} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <Fragment set:html={`<meta name="twitter:description" content="${descAttr}" />`} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- Structured data (JSON-LD) — one or more blocks -->
    {jsonLd && jsonLd.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}


    <!-- Fonts: Playfair Display for headings (elegant heritage serif), Inter for body (clean, readable) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&display=swap" rel="stylesheet" />
  <script is:inline>
      (function() {
        var saved = localStorage.getItem('telfer-wiki-theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (saved === 'dark' || (!saved && prefersDark)) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>

    <!-- Cloudflare Web Analytics (privacy-first: no cookies, measures human visitors) -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "0ce0c7208ace4231896da966591d35d4"}'></script>
  </head>
  <body class="min-h-screen flex flex-col">

    <!-- Scrim behind the open mobile drawer. MUST be a direct child of <body>,
         not of <nav>: the sticky header uses `backdrop-blur-sm`, and a
         backdrop-filter establishes a containing block for position:fixed
         descendants. Inside <nav> this element was fixed to the 77px header and
         measured 0px tall (top:77px, bottom:0px, within a 77px box). As a body
         child it fills the viewport correctly. Revealed by body.nav-open. -->
    <div id="nav-scrim" aria-hidden="true"></div>

    <!-- Nav icon sprite (generated by scripts/build-nav-icons.py - do not hand-edit) -->
    <svg xmlns="http://www.w3.org/2000/svg" style="position:absolute;width:0;height:0;overflow:hidden" aria-hidden="true" focusable="false">
      <symbol id="i-home" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11.2 12 3.6l9 7.6"/><path d="M5 10.4V20.4h14V10.4"/><path d="M9.8 20.4v-5.2h4.4v5.2"/><path d="M16.6 6.4V4.9h1.8v3.2"/></symbol>
      <symbol id="i-people" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.3"/><path d="M3.2 20.2v-.6c0-2.7 2.2-4.4 5.8-4.4s5.8 1.7 5.8 4.4v.6"/><circle cx="16.2" cy="7.1" r="2.6"/><path d="M14.1 4.9c-.9.5-1.4 1.3-1.6 2.2"/><path d="M19.9 15.6c1.1.9 1.7 2.2 1.7 3.9v.7"/></symbol>
      <symbol id="i-timeline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6.4 3v18"/><path d="M6.4 6.4h2.6"/><path d="M12.6 4.3l-2.4 2.1 2.4 2.1"/><path d="M16.2 6.4h4.4"/><path d="M6.4 12h2.6"/><path d="M12.6 9.9l-2.4 2.1 2.4 2.1"/><path d="M16.2 12h4.4"/><path d="M6.4 17.6h2.6"/><path d="M12.6 15.5l-2.4 2.1 2.4 2.1"/><path d="M16.2 17.6h4.4"/></symbol>
      <symbol id="i-full-tree" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="4.2" r="2.2"/><path d="M12 6.4v3"/><path d="M5 9.4h14"/><path d="M5 9.4v6.9"/><circle cx="5" cy="18.2" r="1.9"/><path d="M12 9.4v6.9"/><circle cx="12" cy="18.2" r="1.9"/><path d="M19 9.4v6.9"/><circle cx="19" cy="18.2" r="1.9"/></symbol>
      <symbol id="i-search" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="10.4" cy="10.4" r="6.3"/><path d="M15 15 20.6 20.6"/><path d="M12.9 16.6 16.6 12.9"/></symbol>
      <symbol id="i-families" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="6.2" cy="6.4" r="2.2"/><path d="M2.8 14.6v-1.1c0-1.8 1.5-2.9 3.4-2.9s3.4 1.1 3.4 2.9v1.1"/><circle cx="17.8" cy="6.4" r="2.2"/><path d="M14.4 14.6v-1.1c0-1.8 1.5-2.9 3.4-2.9s3.4 1.1 3.4 2.9v1.1"/><path d="M6.2 12.2h11.6"/><path d="M12 12.2v2.2"/><circle cx="12" cy="17.6" r="1.8"/></symbol>
