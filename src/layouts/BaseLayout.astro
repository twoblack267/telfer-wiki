---
interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Telfer Wiki</title>
    <meta name="description" content={description || "The Telfer Family Wiki — a digital genealogy for the Telfer line"} />
    <link rel="icon" type="image/svg+xml" href="/telfer-wiki/favicon.svg" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Navigation -->
    <nav class="border-b border-[var(--color-border)] bg-white/80 backdrop-blur-sm sticky top-0 z-50 no-print">
      <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href="/telfer-wiki/" class="nav-link text-lg sm:text-xl font-serif font-bold !text-[var(--color-burgundy)] hover:!text-[var(--color-burgundy-light)] no-underline flex items-center gap-2">
          <span class="text-[var(--color-gold)] text-xl sm:text-2xl">🌳</span>
          Telfer Wiki
        </a>

        <!-- Desktop nav -->
        <div class="hidden md:flex gap-6 items-center">
          <a href="/telfer-wiki/" class="nav-link" class:list={[currentPath === "/telfer-wiki/" && "active"]}>Home</a>
          <a href="/telfer-wiki/people" class="nav-link" class:list={[currentPath.startsWith("/telfer-wiki/people") && "active"]}>People</a>
          <a href="/telfer-wiki/timeline" class="nav-link" class:list={[currentPath.startsWith("/telfer-wiki/timeline") && "active"]}>Timeline</a>
          <a href="/telfer-wiki/search" class="nav-link" class:list={[currentPath.startsWith("/telfer-wiki/search") && "active"]}>Search</a>
        </div>

        <!-- Hamburger button -->
        <button id="nav-toggle" class="md:hidden p-2 rounded-lg text-[var(--color-ink-light)] hover:text-[var(--color-burgundy)] hover:bg-[var(--color-surface)] transition-colors" aria-label="Toggle navigation">
          <svg id="nav-icon-open" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          <svg id="nav-icon-close" class="hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>

      <!-- Mobile nav panel -->
      <div id="nav-panel" class="hidden md:hidden border-t border-[var(--color-border)] bg-white/95 backdrop-blur-sm shadow-lg">
        <div class="max-w-5xl mx-auto px-4 py-3 flex flex-col gap-1">
          <a href="/telfer-wiki/" class="nav-link block py-2.5 px-3 rounded-lg hover:bg-[var(--color-surface)] transition-colors" class:list={[currentPath === "/telfer-wiki/" && "active"]}>🏠 Home</a>
          <a href="/telfer-wiki/people" class="nav-link block py-2.5 px-3 rounded-lg hover:bg-[var(--color-surface)] transition-colors" class:list={[currentPath.startsWith("/telfer-wiki/people") && "active"]}>👤 People</a>
          <a href="/telfer-wiki/timeline" class="nav-link block py-2.5 px-3 rounded-lg hover:bg-[var(--color-surface)] transition-colors" class:list={[currentPath.startsWith("/telfer-wiki/timeline") && "active"]}>📅 Timeline</a>
          <a href="/telfer-wiki/search" class="nav-link block py-2.5 px-3 rounded-lg hover:bg-[var(--color-surface)] transition-colors" class:list={[currentPath.startsWith("/telfer-wiki/search") && "active"]}>🔍 Search</a>
        </div>
      </div>
    </nav>

    <!-- Main content -->
    <main class="max-w-5xl mx-auto px-3 sm:px-4 py-4 sm:py-8 flex-1 w-full">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-[var(--color-border)] bg-[var(--color-surface)] no-print">
      <div class="max-w-5xl mx-auto px-4 py-4 sm:py-6 text-center text-sm text-[var(--color-muted)]">
        <p class="font-serif italic">Telfer Wiki — a digital genealogy for the Telfer family line</p>
        <p class="mt-1">
          Data sourced from the Telfer Family History archive.
          <span class="text-xs">Built by Skippy the Magnificent & The Librarian.</span>
        </p>
      </div>
    </footer>
  </body>
</html>

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('nav-panel');
  const iconOpen = document.getElementById('nav-icon-open');
  const iconClose = document.getElementById('nav-icon-close');

  if (toggle && panel) {
    toggle.addEventListener('click', () => {
      const isOpen = !panel.classList.contains('hidden');
      panel.classList.toggle('hidden');
      iconOpen?.classList.toggle('hidden');
      iconClose?.classList.toggle('hidden');
      toggle.setAttribute('aria-expanded', String(!isOpen));
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (!panel.classList.contains('hidden') && !toggle.contains(e.target) && !panel.contains(e.target)) {
        panel.classList.add('hidden');
        iconOpen?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
      }
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.classList.contains('hidden')) {
        panel.classList.add('hidden');
        iconOpen?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.focus();
      }
    });
  }
</script>

<style is:global>
  @import "tailwindcss";

  @theme {
    --color-paper: #f7f3eb;
    --color-paper-dark: #ede5d6;
    --color-ink: #2c1810;
    --color-ink-light: #5a4030;
    --color-burgundy: #6b1d3a;
    --color-burgundy-light: #8b2d52;
    --color-navy: #1b3a5c;
    --color-navy-light: #2a5a8a;
    --color-gold: #c9a94e;
    --color-gold-light: #dcc87a;
    --color-link: #8b3a3a;
    --color-link-hover: #a64a4a;
    --color-border: #d4c9b8;
    --color-surface: #ede5d6;
    --color-muted: #8b7d6b;
    --font-serif: "Playfair Display", Georgia, "Times New Roman", serif;
    --font-sans: Inter, system-ui, -apple-system, sans-serif;
    --font-mono: "JetBrains Mono", "Fira Code", monospace;
    --leading-relaxed: 1.7;
    --leading-loose: 2;
  }

  body {
    background-color: var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-sans);
    line-height: var(--leading-relaxed);
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-serif);
    color: var(--color-burgundy);
    line-height: 1.3;
  }
  h1 { font-size: 1.75rem; font-weight: 700; letter-spacing: -0.02em; }
  h2 { font-size: 1.35rem; font-weight: 600; margin-top: 1.5rem; }
  h3 { font-size: 1.1rem; font-weight: 600; }

  @media (min-width: 640px) {
    h1 { font-size: 2.5rem; }
    h2 { font-size: 1.75rem; margin-top: 2rem; }
    h3 { font-size: 1.25rem; }
  }

  a {
    color: var(--color-link);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 2px;
    transition: color 0.15s, text-decoration-color 0.15s;
  }
  a:hover {
    color: var(--color-link-hover);
    text-decoration-color: var(--color-link-hover);
  }

  .wiki-content {
    font-size: 1rem;
    line-height: var(--leading-loose);
  }

  @media (min-width: 640px) {
    .wiki-content { font-size: 1.05rem; }
  }

  .wiki-content p { margin-bottom: 1rem; }
  @media (min-width: 640px) {
    .wiki-content p { margin-bottom: 1.25rem; }
  }

  /* Tables: horizontally scrollable on mobile */
  .wiki-content table {
    width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: 0.85rem;
  }
  @media (min-width: 640px) {
    .wiki-content table { font-size: 0.95rem; }
  }

  /* Wrap tables in a scrollable container */
  .wiki-content :not(.table-wrapper) > table {
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    white-space: nowrap;
  }

  .wiki-content th {
    background-color: var(--color-burgundy); color: white;
    font-family: var(--font-sans); font-weight: 600;
    text-align: left; padding: 0.4rem 0.5rem;
  }
  @media (min-width: 640px) {
    .wiki-content th { padding: 0.5rem 0.75rem; }
  }
  .wiki-content td {
    padding: 0.3rem 0.5rem; border-bottom: 1px solid var(--color-border);
  }
  @media (min-width: 640px) {
    .wiki-content td { padding: 0.4rem 0.75rem; }
  }
  .wiki-content tr:nth-child(even) td { background-color: var(--color-surface); }
  .wiki-content blockquote {
    border-left: 3px solid var(--color-gold); padding-left: 1rem;
    margin: 1.5rem 0; color: var(--color-ink-light); font-style: italic;
  }
  .wiki-content hr {
    border: none; border-top: 1px solid var(--color-border); margin: 2rem 0;
  }
  .wiki-content ul, .wiki-content ol { padding-left: 1.5rem; margin-bottom: 1.25rem; }
  .wiki-content li { margin-bottom: 0.3rem; }
  .wiki-content code {
    background-color: var(--color-surface); padding: 0.15rem 0.4rem;
    border-radius: 3px; font-family: var(--font-mono); font-size: 0.9em;
  }

  .nav-link {
    position: relative;
    color: var(--color-ink-light);
    text-decoration: none;
    font-family: var(--font-serif);
    font-weight: 500;
    padding: 0.25rem 0;
    transition: color 0.15s;
  }
  .nav-link:hover {
    color: var(--color-burgundy);
    text-decoration: none;
  }
  .person-card { background: white; border: 1px solid var(--color-border); transition: box-shadow 0.2s, border-color 0.2s; }
  .person-card:hover { border-color: var(--color-gold); box-shadow: 0 2px 12px rgba(0,0,0,0.06); }

  .badge-living { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
  .badge-deceased { background: var(--color-surface); color: var(--color-muted); border: 1px solid var(--color-border); }

  .timeline-line { position: relative; }
  .timeline-line::before {
    content: ""; position: absolute; left: 0; top: 0.4rem; bottom: 0;
    width: 1px; background: var(--color-border);
  }
  .timeline-line::after {
    content: ""; position: absolute; left: -3px; top: 0.4rem;
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--color-gold); border: 2px solid var(--color-paper);
  }
  .timeline-line:last-child::before { display: none; }

  .nav-link.active { color: var(--color-burgundy); font-weight: 600; }
  .nav-link.active::after {
    content: ""; position: absolute; bottom: -2px; left: 0; right: 0;
    height: 2px; background: var(--color-gold);
  }

  /* Mobile nav: active state with background instead of underline */
  @media (max-width: 767px) {
    .nav-link.active {
      background-color: var(--color-surface);
      border-left: 3px solid var(--color-gold);
    }
    .nav-link.active::after {
      display: none;
    }
  }

  @media print {
    body { background: white; }
    nav { display: none; }
    .no-print { display: none; }
  }
</style>
