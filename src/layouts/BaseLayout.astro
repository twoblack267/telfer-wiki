---
interface Props {
  title: string;
  description?: string;
  // Optional SEO enhancement props (all optional — existing callers unaffected)
  canonicalPath?: string;          // e.g. "/people/elizabeth-beattie"
  ogType?: string;                 // "website" | "article" | "profile"
  ogImage?: string;                // absolute or relative URL to share thumbnail
  schema?: object | object[];      // single Schema.org object, OR array for multiple JSON-LD blocks (e.g. Person + FAQPage)
  faqItems?: { q: string; a: string }[];   // visible FAQ section on the page (also emits FAQPage schema via `schema`)
  storyBlurb?: string;                       // optional AI/SEO story blurb for curated ancestors
  noindex?: boolean;                         // privacy: emit robots noindex, nofollow + suppress JSON-LD
  navState?: {                              // person-page nav footer data — renders the three links
    slug: string;                            //   at the VERY BOTTOM of the page (after FAQ/map)
    showDescendants: boolean;                //   Back to all people / Descendant Chart / Family Sheet
    showFamily: boolean;
  } | null;
}
const { title, description, canonicalPath, ogType, ogImage, schema, faqItems, storyBlurb, noindex, navState } = Astro.props;
import { clampDescription, META_DESCRIPTION_MAX } from "../utils/meta-description.mjs";
const currentPath = Astro.url.pathname;
const canonicalUrl = canonicalPath ? `https://telferwiki.com${canonicalPath}` : Astro.url.origin + Astro.url.pathname;
const defaultDescription = clampDescription("The Telfer Family Wiki — a digital family history archive tracing nine generations of Telfers from Scotland to South Australia. A living record of the family line from John Telfer of Castleton to the present day.");
const resolvedDescription = clampDescription(description || defaultDescription);
const resolvedOgType = ogType || "website";
const resolvedOgImage = ogImage || "https://telferwiki.com/telferwiki-og.png";
// When a page is noindexed for privacy, drop structured data entirely (no schema
// signal for Google/AI to latch onto) and suppress Open Graph/JSON-LD bloat.
const jsonLd = (!noindex && schema) ? (Array.isArray(schema) ? schema : [schema]) : null;

// Curated-place map cards. Each person page that earns a map gets one entry
// here (verified place only — see references/google-maps-embed-seo-overrides.md
// in the telfer-wiki skill). Rendered at a FIXED slot in the template (below
// Common Questions, above the nav footer) for every matching slug — one set way.
const CURATED_MAPS = {
  "james-telfer-1761": {
    label: "Where the Telfers came from — Newcastleton (formerly Castleton)",
    title: "Map of Newcastleton, formerly Castleton, Scottish Borders",
    latlng: "55.1793,-2.8136",
    z: 15,
    caption: "Newcastleton (Copshaw Holm) is the modern village on the site of the old parish of Castleton, in the Liddesdale valley of the Scottish Borders.",
  },
  "john-telfer-of-castleton": {
    label: "Where the Telfers came from — Newcastleton (formerly Castleton)",
    title: "Map of Newcastleton, formerly Castleton, Scottish Borders",
    latlng: "55.1793,-2.8136",
    z: 15,
    caption: "Newcastleton (Copshaw Holm) is the modern village on the site of the old parish of Castleton, in the Liddesdale valley of the Scottish Borders.",
  },
  "allen-merrick": {
    label: "Where Allen lived — Glasshouse Mountains, Queensland",
    title: "Map of Glasshouse Mountains, Sunshine Coast hinterland, Queensland",
    latlng: "-26.9054,152.9239",
    z: 13,
    caption: 'Allen Russell Merrick spent his later years in the Glass House Mountains area of Queensland\'s Sunshine Coast hinterland — his April 2015 funeral notice named him "late of Glasshouse Camping Ground."',
  },
  "john-telfer-1840": {
    label: "Where John Telfer is buried — Tantanoola Cemetery, South Australia",
    title: "Map of Tantanoola Cemetery, South Australia",
    latlng: "-37.68028,140.47338",
    z: 14,
    caption: "John Telfer, who died at Tantanoola on 5 January 1913, is buried in the Tantanoola Cemetery in the South East of South Australia, alongside his second wife Martha Clara (Henstridge). The town was known as Lucieton when the family settled there in 1874.",
  },
  "martha-henstridge-1854": {
    label: "Where Martha Clara is buried — Tantanoola Cemetery, South Australia",
    title: "Map of Tantanoola Cemetery, South Australia",
    latlng: "-37.68028,140.47338",
    z: 14,
    caption: "Martha Clara (Henstridge) Telfer, who died at Tantanoola on 13 November 1921 aged 67, is buried in the Tantanoola Cemetery beside her husband John Telfer.",
  },
  "john-telfer-1847": {
    label: "Where John and Caroline are buried — Clare General Cemetery, South Australia",
    title: "Map of Clare General Cemetery, South Australia",
    latlng: "-33.842625,138.6026778",
    z: 18,
    caption: "John Telfer (1847–1929) and his wife Caroline Amelia (née Masters, 1842–1929) share one headstone at Clare General Cemetery. John died on 23 August 1929 and Caroline the following day; both had lived at Willow Plains near Clare since the late 1870s, where John farmed for 47 years. The pin marks the recorded position of the grave.",
  },
  "caroline-telfer-1842": {
    label: "Where Caroline is buried — Clare General Cemetery, South Australia",
    title: "Map of Clare General Cemetery, South Australia",
    latlng: "-33.842625,138.6026778",
    z: 18,
    caption: "Caroline Amelia (née Masters) Telfer, who died at Clare on 24 August 1929 aged 87, is buried beside her husband John Telfer (1847–1929) under one joint headstone. She had come to South Australia from Warwickshire on the Templar in 1845, and taught at Tarlee before her marriage in 1874.",
  },
  "robert-campbell": {
    label: "Where the Campbells lived and died — Millicent and Mount Gambier, South Australia",
    title: "Map of Millicent, South Australia — birthplace of Robert Mewett Campbell",
    latlng: "-37.62227,140.38200",
    z: 13,
    caption: "Robert Mewett Campbell was born at Millicent, South Australia, on 20 December 1878, the son of John Campbell and Emily Mewett. Both of his parents died at Mount Gambier — his father John on 27 January 1892, his mother Emily on 13 September 1925.",
  },
};
const curatedMapSlug = Object.keys(CURATED_MAPS).find((s) => currentPath.includes(`/people/${s}/`));
const curatedMap = curatedMapSlug ? CURATED_MAPS[curatedMapSlug] : null;

---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Telfer Wiki</title>
    <meta name="description" content={resolvedDescription} />
    <meta name="description-chars" content={String(resolvedDescription.length)} data-encoding="decoded" />
    <!-- Icons. Google's SERP icon comes from /favicon.ico and it does NOT reliably read SVG,
         so favicon.ico (multi-size 16-256px) is the one that actually matters. -->
    <link rel="icon" href={import.meta.env.BASE_URL + "favicon.ico"} sizes="any" />
    <link rel="icon" type="image/png" sizes="96x96" href={import.meta.env.BASE_URL + "favicon-96.png"} />
    <link rel="icon" type="image/png" sizes="32x32" href={import.meta.env.BASE_URL + "favicon-32.png"} />
    <link rel="icon" type="image/png" sizes="16x16" href={import.meta.env.BASE_URL + "favicon-16.png"} />
    <link rel="icon" type="image/svg+xml" href={import.meta.env.BASE_URL + "favicon.svg"} sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href={import.meta.env.BASE_URL + "apple-touch-icon.png"} />

    <!-- Google AdSense — site ownership verification (ad client ca-pub-8950658490247877) -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8950658490247877" crossorigin="anonymous"></script>

    <!-- Canonical URL (prevents duplicate-content across URL variants) -->
    <link rel="canonical" href={canonicalUrl} />

    {/* Comment is CONDITIONAL, deliberately. Emitted unconditionally it claimed a
        privacy intent on /tree/ (which never passed noindex), so the document
        advertised an exclusion it did not carry — card tw-2026-10-20-001. A
        comment that describes an action must not be able to outlive the action. */}
    {noindex && <Fragment>
    <!-- Privacy: this page IS excluded from search engine indexes (living persons) -->
    <meta name="robots" content="noindex, nofollow" />
    </Fragment>}

    <!-- Open Graph / social sharing -->
    <meta property="og:type" content={resolvedOgType} />
    <meta property="og:site_name" content="Telfer Wiki" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- Structured data (JSON-LD) — one or more blocks -->
    {jsonLd && jsonLd.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}


    <!-- Fonts: Playfair Display for headings (elegant heritage serif), Inter for body (clean, readable) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&display=swap" rel="stylesheet" />
  <script is:inline>
      (function() {
        var saved = localStorage.getItem('telfer-wiki-theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (saved === 'dark' || (!saved && prefersDark)) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>

    <!-- Cloudflare Web Analytics (privacy-first: no cookies, measures human visitors) -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "0ce0c7208ace4231896da966591d35d4"}'></script>
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Nav icon sprite (generated by scripts/build-nav-icons.py - do not hand-edit) -->
    <svg xmlns="http://www.w3.org/2000/svg" style="position:absolute;width:0;height:0;overflow:hidden" aria-hidden="true" focusable="false">
      <symbol id="i-home" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11.2 12 3.6l9 7.6"/><path d="M5 10.4V20.4h14V10.4"/><path d="M9.8 20.4v-5.2h4.4v5.2"/><path d="M16.6 6.4V4.9h1.8v3.2"/></symbol>
