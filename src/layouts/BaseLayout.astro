    </svg>
    <style is:inline>
      /* Brand ink sampled from the banyan logo (#8A1B3B), not the theme's
         #7b2d2d heading colour - the logo is the reference. */
      :root{--nav-ink:#8A1B3B;--nav-ink-hover:#6d1430}
      [data-theme="dark"]{--nav-ink:#d98aa4;--nav-ink-hover:#ecb3c5}
      svg.nav-ico{width:22px;height:22px;flex:0 0 auto;stroke:currentColor;stroke-width:1.5;fill:none;transition:transform .2s ease}
      /* Page-body icons (titles, tabs, lists, inputs): same engraving weight and
         brand ink as the nav, but sized to their own context. */
      svg.pg-ico{stroke:var(--nav-ink);color:var(--nav-ink);stroke-width:1.5;fill:none;flex:0 0 auto}
      svg.pg-ico[width="48"]{stroke-width:1.4}
      .nav-link:hover svg.nav-ico{transform:translateY(-1px)}
      .nav-link.active svg.nav-ico{stroke-width:1.9}
      /* Layout is inline so it cannot be lost if Tailwind's content scan misses
         these utility classes again (it did - flex/gap/px were dropped). */
      /* Tailwind's lg: utilities for these buttons are not in the compiled CSS,
         so pin their visibility here instead of trusting the class list. */
      @media(min-width:1024px){#nav-toggle{display:none}}
      /* Desktop nav must be hidden below lg; the lg:flex class is not in the
         compiled CSS, so the list was rendering on phones above the drawer. */
      #nav-desktop{display:none;align-items:center;gap:.25rem}
      @media(min-width:1024px){#nav-desktop{display:flex}}
      #nav-panel > div{display:flex;flex-direction:column;gap:.15rem;max-width:64rem;margin:0 auto;padding:.75rem 1rem}
      #nav-panel{display:none}
      #nav-panel.is-open{display:block}
      @media(max-width:1023px){#nav-panel.is-open{display:block}}
      nav a.nav-link{display:inline-flex;align-items:center;gap:.4rem;padding:.5rem .6rem;border-radius:.5rem;text-decoration:none;
        color:var(--nav-ink);font-size:.875rem;letter-spacing:.01em}
      nav a.nav-link:hover{color:var(--nav-ink-hover);background:var(--color-surface)}
      nav a.nav-link.active{color:var(--nav-ink);background:var(--color-surface)}
      @media(max-width:1023px){
        svg.nav-ico{width:24px;height:24px}
        nav a.nav-link{gap:.65rem;padding:.6rem .75rem;justify-content:flex-start}
      }
    </style>

    <!-- Navigation -->
    <nav class="border-b-2 border-[var(--color-border)] bg-[var(--color-nav-bg)] backdrop-blur-sm sticky top-0 z-50 no-print">
      <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href={import.meta.env.BASE_URL} class="nav-link text-lg sm:text-xl font-serif font-bold text-[var(--color-heading)] hover:text-[var(--color-heading-hover)] no-underline flex items-center gap-2">
          <img
            src={import.meta.env.BASE_URL + "images/brand/telfer-fig.png"}
            alt=""
            aria-hidden="true"
            width="40"
            height="40"
            class="h-8 w-8 sm:h-10 sm:w-10 object-contain shrink-0"
          />
          Telfer Wiki
        </a>

        <!-- Desktop nav -->
        <div id="nav-desktop" class="hidden lg:flex gap-1 items-center">
          <a href={import.meta.env.BASE_URL} class="nav-link flex items-center gap-1.5 px-2.5 py-2 rounded-lg" class:list={[currentPath === import.meta.env.BASE_URL && "active"]}><svg class="nav-ico" aria-hidden="true" focusable="false"><use href="#i-home"></use></svg><span>Home</span></a>
          <a href={import.meta.env.BASE_URL + "people/"} class="nav-link flex items-center gap-1.5 px-2.5 py-2 rounded-lg" class:list={[currentPath.startsWith(import.meta.env.BASE_URL + "people") && "active"]}><svg class="nav-ico" aria-hidden="true" focusable="false"><use href="#i-people"></use></svg><span>People</span></a>
          <a href={import.meta.env.BASE_URL + "timeline/"} class="nav-link flex items-center gap-1.5 px-2.5 py-2 rounded-lg" class:list={[currentPath.startsWith(import.meta.env.BASE_URL + "timeline") && "active"]}><svg class="nav-ico" aria-hidden="true" focusable="false"><use href="#i-timeline"></use></svg><span>Timeline</span></a>
          <a href={import.meta.env.BASE_URL + "people/full-tree/"} class="nav-link flex items-center gap-1.5 px-2.5 py-2 rounded-lg" class:list={[currentPath.startsWith(import.meta.env.BASE_URL + "people/full-tree") && "active"]}><svg class="nav-ico" aria-hidden="true" focusable="false"><use href="#i-full-tree"></use></svg><span>Full Tree</span></a>
          <a href={import.meta.env.BASE_URL + "search/"} class="nav-link flex items-center gap-1.5 px-2.5 py-2 rounded-lg" class:list={[currentPath.startsWith(import.meta.env.BASE_URL + "search") && "active"]}><svg class="nav-ico" aria-hidden="true" focusable="false"><use href="#i-search"></use></svg><span>Search</span></a>
