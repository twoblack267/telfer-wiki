      word-break: normal;
      overflow-wrap: break-word;
      hyphens: manual;
    }
    /* Short headers are words, not sentences: never split them mid-word.
       Their column then takes its natural min-content width (widest single
       word) and the browser wraps on the space instead. */
    .wiki-content th {
      min-width: 3.5rem;
      word-break: keep-all;
