---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { PersonData } from "../utils/extract-data.mjs";

const people = (await import("../data/people.public.json")).default as PersonData[];
const telferPeople = people.filter((p) => (p.branch === "telfer" || !p.branch) && p.id);

// Build a timeline of all events
interface TimelineEvent {
  year: number;
  sortYear: number;
  dateLabel: string;
  type: "birth" | "death" | "marriage" | "event";
  personName: string;
  personSlug: string;
  detail: string;
}

const timeline: TimelineEvent[] = [];

// tw-2026-09-14-020: birth_year / death_year may be an APPROXIMATE string
// ("~1892", "~1885", "~1960") rather than a number — the vault marks estimates
// with a leading tilde. Pushing those straight into `year` produced
// Math.floor("~1892"/10)*10 = NaN, which built a literal 'NaNs' decade chip
// labelled "NaNs" pointing at href="#decade-NaN" (3 timeline entries: Leslie
// Frank Dillon, Charles Farrow Jr, Florence Nicholas). A non-numeric year must
// never mint a decade anchor — parse it, and fall back to the raw string only
// for display (new Date() keeps the entries sorted instead of collapsing).
function parseYearValue(value: unknown): number | null {
  if (typeof value === "number" && Number.isFinite(value)) return value;
  if (typeof value !== "string") return null;
  const match = value.match(/-?\d{3,4}/);
  if (!match) return null;
  const parsed = Number.parseInt(match[0], 10);
  return Number.isFinite(parsed) ? parsed : null;
}

function makeEvent(
  raw: unknown,
  display: unknown,
  type: TimelineEvent["type"],
  personName: string,
  personSlug: string,
  detail: string,
): TimelineEvent {
  const numeric = parseYearValue(raw);
  return {
    year: numeric ?? (raw as any),
    dateLabel: `${display}`,
    type,
    personName,
    personSlug,
    detail,
    sortYear: numeric ?? Number.MAX_SAFE_INTEGER,
  };
}

for (const p of telferPeople) {
  if (p.birth_year) {
    timeline.push(
      makeEvent(
        p.birth_year,
        p.birth_year,
        "birth",
        p.display_name,
        p.slug,
        "is born",
      ),
    );
  }

  if (p.death_year) {
    const birthNumeric = parseYearValue(p.birth_year);
    const deathNumeric = parseYearValue(p.death_year);
    const aged =
      birthNumeric !== null && deathNumeric !== null
        ? deathNumeric - birthNumeric
        : "?";
    timeline.push(
      makeEvent(
        p.death_year,
        p.death_year,
        "death",
        p.display_name,
        p.slug,
        aged === "?" ? "dies" : `dies, aged ${aged}`,
      ),
    );
  }
}

// Add key historical events from tree content
timeline.push({ year: 1839, sortYear: 1839, dateLabel: "1839", type: "event", personName: "Francis Telfer", personSlug: "francis-telfer-1809", detail: "emigrates to South Australia" });
timeline.push({ year: 1845, sortYear: 1845, dateLabel: "1845", type: "event", personName: "The Telfer family", personSlug: "", detail: "settles in the Tantanoola district, SA" });
timeline.push({ year: 1874, sortYear: 1874, dateLabel: "1874", type: "event", personName: "John Telfer", personSlug: "john-telfer-1847", detail: "marries Caroline Masters" });

// Sort by year (sortYear guarantees finite numerics; unparseable years sink to the end)
timeline.sort((a, b) => a.sortYear - b.sortYear);

// Group by decade for navigation
const decades: { label: string; year: number }[] = [];
const seenDecades = new Set<number>();
for (const t of timeline) {
  const decade = Math.floor(t.sortYear / 10) * 10;
  if (!Number.isFinite(decade)) continue;
  if (!seenDecades.has(decade)) {
    seenDecades.add(decade);
    decades.push({ label: `${decade}s`, year: decade });
  }
}
// ── Survivals column ──────────────────────────────────────────────────
// tw-2026-11-25-001: a second column beside each decade holding "things
// that could have ended the family line and didn't". Mark's scope, 25 Nov
// 2026: not only failed prophecies — real wars, epidemics and near-misses
// count, provided every one is real, dated and sourced. Decade alignment
// governs placement: a card sits in the decade it belongs to, and a decade
// with no card stays EMPTY. No artificial spreading, no fabricated scare.
// Overlap of two cards is allowed ONLY within the same decade (~8px).
interface Survival {
  decade: number;
  year: string;
  title: string;
  feared: string;
  detail: string;
  tone: "rose" | "sage" | "blue" | "lavender" | "peach";
}

const survivals: Survival[] = [
  { decade: 1780, year: "1789", title: "Smallpox reaches Sydney", tone: "rose",
    feared: "Up to 220,000 Aboriginal Australians dead",
    detail: "The First Fleet's smallpox swept the continent's original inhabitants. The colonists largely escaped it. The worst thing on this page." },
  { decade: 1870, year: "1870s", title: "One child in nine", tone: "lavender",
    feared: "111 deaths per 1,000 births",
    detail: "Australian infant mortality in 1870. Not a scare and not a prophecy — just the water, the milk and the winter." },
  { decade: 1910, year: "1914–18", title: "The Great War", tone: "sage",
    feared: "60,000 Australians killed from five million",
    detail: "Our own line: 2731 Private Arthur Clifford Stribling, 50th Battalion, died of wounds 25 April 1918 at Villers-Bretonneux, aged 28." },
  { decade: 1910, year: "1919", title: "Spanish flu", tone: "peach",
    feared: "15,000 Australians dead; 40% infected",
    detail: "Quarantine held the country back longer than any other nation. It got in anyway." },
  { decade: 1970, year: "1960 → 2026", title: "Doomsday: Friday 13 November", tone: "blue",
    feared: "Population reaches infinity",
    detail: "Von Foerster, Mora & Amiot, Science, 1960. The date has passed. The world did not go infinite." },
  { decade: 1980, year: "1980", title: "Smallpox eradicated", tone: "sage",
    feared: "A 3,000-year killer, gone",
    detail: "WHO certified eradication 8 May 1980 after the last natural case in Somalia, 1977. The one good rectangle on the page." },
  { decade: 2010, year: "21 Dec 2012", title: "The Mayan calendar ends", tone: "lavender",
    feared: "The 13th b'ak'tun",
    detail: "Mayanists had been saying for years it was a calendar reset, not a prophecy. It was a calendar reset." },
  { decade: 2020, year: "2020–22", title: "COVID-19", tone: "peach",
    feared: "Millions dead worldwide",
    detail: "No prophecy, no deadline. A real pandemic that killed people, and the line survived it." },
];

const survivalsByDecade = new Map<number, Survival[]>();
for (const s of survivals) {
  const list = survivalsByDecade.get(s.decade) ?? [];
  list.push(s);
  survivalsByDecade.set(s.decade, list);
}

// Every decade from the first event to the last, so the column keeps step
// with the timeline even where it holds nothing.
const firstDecade = Math.floor(timeline[0].sortYear / 10) * 10;
const lastDecade = Math.floor(timeline[timeline.length - 1].sortYear / 10) * 10;
const allDecades: number[] = [];
for (let d = firstDecade; d <= lastDecade; d += 10) allDecades.push(d);
---

<BaseLayout
  title="Timeline"
  description={`A chronological timeline of the Telfer family — births, deaths, marriages and events across nine generations, from John Telfer of Castleton (b. 1731) to the present day. Part of the Telfer Family Wiki.`}
>
  <div class="page-header">
    <h1>Timeline</h1>
    <p class="text-[var(--color-ink-light)] mt-2">
      {timeline.length} events across the Telfer family history
    </p>
  </div>

  <!-- Decade jump nav -->
  <div class="flex flex-wrap gap-2 mb-8">
    {decades.map((d) => (
      <a href={`#decade-${d.year}`} class="text-xs px-3 py-1.5 rounded-full border border-[var(--color-border)] no-underline text-[var(--color-ink-light)] hover:border-[var(--color-burgundy)] hover:text-[var(--color-burgundy)] transition-colors">
        {d.label}
      </a>
    ))}
  </div>

  <!-- Timeline + Survivals: one two-column layout, cards aligned to their decade -->
  <div class="tl-grid">
    <div class="tl-main space-y-0">
    {timeline.map((event, i) => {
      // Check if decade header needed
      const decade = Math.floor(event.sortYear / 10) * 10;
      const prevDecade = i > 0 ? Math.floor(timeline[i - 1].sortYear / 10) * 10 : -1;
      const showHeader = decade !== prevDecade && Number.isFinite(decade);

      return (
        <>
          {showHeader && (
            <div id={`decade-${decade}`} class="py-4 -ml-0">
              <h2 class="text-2xl font-bold font-serif text-[var(--color-navy)] border-b-2 border-[var(--color-gold)] pb-1 inline-block">
                {decade}s
              </h2>
            </div>
          )}
          <div class="timeline-line pl-7 sm:pl-10 pb-4 sm:pb-6 relative">
            <div class="flex items-start gap-2 sm:gap-3">
              <div class="text-xs sm:text-sm font-bold font-mono text-[var(--color-navy)] w-10 sm:w-12 shrink-0 pt-0.5">
                {event.year}
              </div>
              <div class="flex-1 min-w-0">
                {/* ONE SENTENCE PER EVENT (Mark, 4 Nov 2026).
                    This row used to print the badge (Born), then the person's name,
                    then a detail line that repeated the name again — "Born · John
                    Telfer · John Telfer born". Three renderings of the same fact in
                    one line. Now: the name is the link, the sentence ends it. */}
                <div class="text-xs sm:text-sm">
                  {event.personSlug ? (
                    <a href={`${import.meta.env.BASE_URL}people/${event.personSlug}/`} class="font-medium text-[var(--color-link)]">
                      {event.personName}
                    </a>
                  ) : (
                    <span class="font-medium text-[var(--color-ink)]">{event.personName}</span>
                  )}
                  <span class="text-[var(--color-ink-light)]"> {event.detail}</span>
                </div>
              </div>
            </div>
          </div>
        </>
      );
    })}
    </div>

    <!-- Survivals column: one row per decade. A decade with no card renders
         an empty cell — deliberately. Nothing is invented to fill a gap. -->
    <aside class="tl-side" aria-label="What the family survived">
      <div class="tl-side-head">
        <h2>What the family survived</h2>
        <p>Things that could have ended the line and didn't.</p>
      </div>
      {allDecades.map((d) => {
        const cards = survivalsByDecade.get(d) ?? [];
        return (
          <div class={`tl-side-row${cards.length ? "" : " is-empty"}`} data-decade={d}>
            {cards.map((s) => (
              <div class={`survival-card tone-${s.tone}`}>
                <div class="sc-year">{s.year}</div>
                <div class="sc-title">{s.title}</div>
                <div class="sc-feared">{s.feared}</div>
                <div class="sc-detail">{s.detail}</div>
              </div>
            ))}
          </div>
        );
      })}
      <div class="tl-side-foot">300 years. Still here.</div>
    </aside>
  </div>
</BaseLayout>

<style is:global>
  .timeline-line:first-of-type::before { top: 0.4rem; }

  /* ── Survivals column ─────────────────────────────────────────────── */
  .tl-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
    gap: 2.5rem;
    align-items: start;
  }

  /* Sticky column so the cards stay beside the decade you are reading. */
  .tl-side {
    position: sticky;
    top: 1.5rem;
    align-self: start;
    display: flex;
    flex-direction: column;
  }

  .tl-side-head {
    padding-bottom: .9rem;
    margin-bottom: .6rem;
    border-bottom: 2px solid var(--color-gold);
  }
  .tl-side-head h2 {
    font-family: var(--font-serif, serif);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-navy);
    margin: 0;
  }
  .tl-side-head p {
    font-size: .8rem;
    color: var(--color-ink-light);
    margin: .2rem 0 0;
  }

  /* Each decade gets a slot. Empty slots hold their height so the cards
     keep step with the timeline — an empty decade is shown empty. */
  .tl-side-row {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 3.6rem;
    padding: 0.35rem 0;
  }
  .tl-side-row.is-empty { min-height: 0; }

  /* Two cards in ONE decade may overlap by 8px — nothing else may. */
  .tl-side-row > .survival-card + .survival-card { margin-top: -8px; }

  .survival-card {
    border-radius: 14px;
    border: 1px solid var(--color-border);
    padding: .7rem .85rem;
    box-shadow: 0 1px 3px rgba(0,0,0,.05);
    color: var(--color-ink);
  }
  .sc-year {
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
    opacity: .75;
  }
  .sc-title {
    font-family: var(--font-serif, serif);
    font-weight: 700;
    font-size: .95rem;
    line-height: 1.25;
    margin: .15rem 0 .3rem;
  }
  .sc-feared {
    font-size: .78rem;
    font-weight: 600;
    margin-bottom: .3rem;
  }
  .sc-detail {
    font-size: .76rem;
    line-height: 1.45;
    color: var(--color-ink-light);
  }

  .tone-rose     { background: #f3d9d7; border-color: #c98a8a; }
  .tone-sage     { background: #dcead3; border-color: #8aa87a; }
  .tone-blue     { background: #dbe7f3; border-color: #7a9cc2; }
  .tone-lavender { background: #e8ddf3; border-color: #a88ac2; }
  .tone-peach    { background: #fde8c8; border-color: #d9a85a; }

  .tl-side-foot {
    margin-top: 1rem;
    padding-top: .7rem;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-serif, serif);
    font-style: italic;
    font-size: .85rem;
    color: var(--color-ink-light);
  }

  /* Phone: the column folds UNDER the timeline and the cards stack in
     decade order. Same cards, same dates, no second layout to maintain. */
  @media (max-width: 860px) {
    .tl-grid { grid-template-columns: 1fr; gap: 1.75rem; }
    .tl-side { position: static; }
    .tl-side-row { min-height: 0; }
  }
</style>
