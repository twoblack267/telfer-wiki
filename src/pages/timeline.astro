<BaseLayout
  title="Timeline"
  description={`A chronological timeline of the Telfer family — births, deaths, marriages and events across nine generations, from John Telfer of Castleton (b. 1731) to the present day. Part of the Telfer Family Wiki.`}
>
  <div class="page-header">
    <h1>Timeline</h1>
    <p class="text-[var(--color-ink-light)] mt-2">
      {timeline.length} events across the Telfer family history
    </p>
  </div>

  <!-- Decade jump nav -->
  <div class="flex flex-wrap gap-2 mb-8">
    {decades.map((d) => (
      <a href={`#decade-${d.year}`} class="text-xs px-3 py-1.5 rounded-full border border-[var(--color-border)] no-underline text-[var(--color-ink-light)] hover:border-[var(--color-burgundy)] hover:text-[var(--color-burgundy)] transition-colors">
        {d.label}
      </a>
    ))}
  </div>

  <!-- Timeline + Survivals: one two-column layout, cards aligned to their decade -->
  <div class="tl-legend">
    <div class="tl-lg-1">The Telfer line</div>
    <div class="tl-lg-2">What the line survived</div>
  </div>
  <div class="tl-grid">
    <!-- One grid ROW per decade: the timeline cell and its survival card are
         siblings in the same row, so each card sits BESIDE its own decade by
         geometry alone. No JavaScript, no measured heights, no drift — and it
         behaves identically on a phone. -->
    {allDecades.map((d, di) => {
      const cards = survivalsByDecade.get(d) ?? [];
      const freeCards = freedomsByDecade.get(d) ?? [];
      const events = timeline.filter((e) => Math.floor(e.sortYear / 10) * 10 === d);
      return (
        <Fragment>
          <div class="tl-cell" data-decade={d}>
            <div id={`decade-${d}`} class="py-4 -ml-0">
              <h2 class="text-2xl font-bold font-serif text-[var(--color-navy)] border-b-2 border-[var(--color-gold)] pb-1 inline-block">
                {d}s
              </h2>
            </div>
            {events.map((event) => (
              <div class="timeline-line pl-7 sm:pl-10 pb-4 sm:pb-6 relative">
                <div class="flex items-start gap-2 sm:gap-3">
                  <div class="text-xs sm:text-sm font-bold font-mono text-[var(--color-navy)] w-10 sm:w-12 shrink-0 pt-0.5">
                    {event.year}
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="text-xs sm:text-sm">
                      <button
                        type="button"
                        class="tl-ev"
                        data-rd
                        data-kind="family"
                        data-kicker={event.year}
                        data-title={event.personName}
                        data-text={event.detail}
                        data-slug={event.personSlug || undefined}
                        aria-label={`${event.personName}, ${event.year} — open full entry`}
                      >
                        <span class={event.personSlug ? "font-medium text-[var(--color-link)]" : "font-medium text-[var(--color-ink)]"}>{event.personName}</span>
                        <span class="text-[var(--color-ink-light)]"> {event.detail}</span>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
          <div class={`tl-card-cell${cards.length || freeCards.length ? "" : " is-empty"}`}>
            {/* ONE chassis for every card in this column (Mark, 26 Nov 2026:
                "I want all the cards to be the same like the grey ones").
                COVID used to be a fat coloured block with a TAP TO READ label
                sitting above a strip of narrow tabs — two shapes in one
                column. Now survivals and freedoms are ONE stack of identical
                cards, and the grey kicker is always the date, never a
                placeholder title. Tone colours are deliberately NOT applied:
                a per-card fill was the thing that made them look unalike. */}
            {[...cards.map((c) => ({
                kicker: c.year,
                title: c.title,
                kind: "survival" as const,
                data: {
                  kicker: c.year,
                  title: c.title,
                  lede: c.feared,
                  power: "",
                  text: c.detail,
                  src: "",
                },
              })),
              ...freeCards.map((f) => ({
                kicker: f.year,
                title: f.title,
                kind: "freedom" as const,
                data: {
                  kicker: f.year,
                  title: f.title,
                  lede: f.enacted,
                  power: f.power,
                  text: f.detail,
                  src: f.source,
                  img: f.img,
                  cap: f.cap,
                },
              }))].map((c) => (
              <button
                type="button"
                class="tcard"
                data-rd
                data-kind={c.kind}
                data-kicker={c.data.kicker}
                data-title={c.data.title}
                data-lede={c.data.lede}
                data-power={c.data.power || undefined}
                data-text={c.data.text}
                data-src={c.data.src || undefined}
                data-img={c.data.img || undefined}
                data-cap={c.data.cap || undefined}
                aria-label={`${c.kicker} — ${c.title}. Open full card`}
              >
                <span class="tcard-year">{c.kicker}</span>
                <span class="tcard-title">{c.title}</span>
              </button>
            ))}
          </div>
        </Fragment>
      );
    })}
  </div>
  </div>
</BaseLayout>

<style is:global>
  .timeline-line:first-of-type::before { top: 0.4rem; }

  /* ── Survivals column ─────────────────────────────────────────────── */
  .tl-grid {
    display: grid;
    /* Two columns: the family line gets the majority of the width, its
       survival card a narrower column beside it. The freedom cards are
       NESTED inside the survival cell (markup, below), so a decade is always
       exactly two grid children and the deck can never be auto-placed onto
       the wrong row. */
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.72fr);
    column-gap: 2rem;
    row-gap: 0;
    align-items: start;
  }

  /* Left cell: a decade heading plus its events. */
  .tl-cell { min-width: 0; }

  /* A row that carries a freedom card repeats its own decade label before the
     events, so the card is never left standing beside someone else's heading. */
  .tl-dec-restamp { margin-top: 2.5rem; }

  /* Right cell: the survival card(s) for that same decade.

     Anchored to the TOP of the decade row so every card sits beside its own
     decade HEADING. Centring it was wrong: a decade with 60-80 events is
     thousands of pixels tall, so a centred card landed beside the NEXT
     decade's heading (the 1960s Doomsday card sat level with the 1970s).

     No `position: sticky` here. It is inert in a printed/screen-shotted page
     and it makes the card appear to drift while scrolling, which reads as a
     bug rather than a feature. Geometry does the work. */
  .tl-card-cell {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    min-width: 0;
    padding: .35rem 0;
    align-self: start;
    /* Pull the card up so its top edge lines up with the heading's cap
       height rather than the heading's line-box top. */
    margin-top: -.1rem;
  }
  .tl-card-cell.is-empty { padding: 0; }

  /* ── The ONE card chassis ─────────────────────────────────────────────
     Every card in this column is this shape: same width, same radius, same
     border, same left colour bar, same padding. A survival note (COVID-19)
     and a freedom card ("The Digital Duty of Care") are the same object to
     the eye; only the words inside differ. No per-card tone fill — the fills
     were the reason two identical cards looked like two different things.
     The left bar is a single brand colour, not the tone palette. */
  .tcard {
    display: block;
    box-sizing: border-box;
    width: 100%;
    max-width: 15.5rem;
    margin: 0 0 .35rem;
    text-align: left;
    font: inherit;
    color: var(--color-ink);
    background: var(--color-surface, #fff);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-burgundy);
    border-radius: 8px;
    padding: .42rem .55rem;
    box-shadow: 0 1px 3px rgba(0,0,0,.05);
    cursor: pointer;
    transition: box-shadow .15s ease, border-color .15s ease;
  }
  .tcard:hover { box-shadow: 0 3px 10px rgba(0,0,0,.10); }
  .tcard:focus-visible { outline: 2px solid var(--color-burgundy); outline-offset: 2px; }
  .tcard-year {
    display: block;
    font-size: .58rem;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--color-ink-light);
    opacity: .85;
    margin-bottom: .12rem;
  }
  .tcard-title {
    display: block;
    font-family: var(--font-serif, serif);
    font-weight: 700;
    font-size: .8rem;
    line-height: 1.2;
    /* Wrap at whole words only — never hyphenate a name mid-syllable. */
    white-space: normal;
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
  }

  .tone-rose     { background: #f3d9d7; border-color: #c98a8a; }
  .tone-sage     { background: #dcead3; border-color: #8aa87a; }
  .tone-blue     { background: #dbe7f3; border-color: #7a9cc2; }
  .tone-lavender { background: #e8ddf3; border-color: #a88ac2; }
  .tone-peach    { background: #fde8c8; border-color: #d9a85a; }
  .tone-sky      { background: #d9edf0; border-color: #78aab3; }

  /* Column legend — two labels matching the two columns below. The trivia
     deck is a side note, so it gets no third heading of its own. */
  .tl-legend {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.72fr);
    column-gap: 2rem;
    margin: 1.2rem 0 .3rem;
    padding-bottom: .4rem;
    border-bottom: 2px solid var(--color-gold);
  }
  .tl-legend > div {
    font-family: var(--font-serif, serif);
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--color-ink-light);
  }
  .tl-lg-2 { padding-left: .1rem; }

  .tl-side-foot {
    margin-top: 1rem;
    padding-top: .7rem;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-serif, serif);
    font-style: italic;
    font-size: .85rem;
    color: var(--color-ink-light);
  }

  /* Phone: the family line keeps the width it had; the trivia deck narrows
     into a thin strip of poking-out tabs down the right. The people are the
     main event at every width. */
  @media (max-width: 860px) {
    .tl-legend {
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
      column-gap: .5rem;
    }
    .tl-legend > div { font-size: .54rem; letter-spacing: .02em; }
    .tl-grid {
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
      column-gap: .5rem;
    }
    .tl-cell h2 { font-size: 1.15rem; }
    .tcard { padding: .38rem .5rem; }
    .tcard-year { font-size: .54rem; }
    .tcard-title { font-size: .78rem; }
  }
  /* ── Family line: every entry is a button that opens the same Win95
        reader window the trivia tabs use (Mark, 26 Nov 2026). No inline
        expansion on the page at all — the line stays the family line. ── */
  .tl-ev {
    display: block;
    width: 100%;
    text-align: left;
    background: transparent;
    border: 0;
    padding: .12rem .3rem;
    margin: -.12rem -.3rem;
    border-radius: 6px;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }
  .tl-ev:hover { background: rgba(0,0,0,.045); }
  .tl-ev:focus-visible { outline: 2px solid currentColor; outline-offset: 1px; }

  /* ── The reader window ────────────────────────────────────────────────
     Cloned rule-for-rule from #skippy-lightbox in BaseLayout.astro (the photo
     viewer Mark approved on 15/16 Nov 2026). Those rules are scoped to the
     lightbox ID inside the layout's own <style>, so they do NOT cascade into
     this page — re-declaring them under #skippy-reader is the only way this
     window is genuinely the same chassis rather than a lookalike. */
  #skippy-reader {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 1rem;
      background: rgba(20, 17, 14, 0.72);
      -webkit-backdrop-filter: blur(2px);
      backdrop-filter: blur(2px);
    }
    #skippy-reader.is-open { display: flex; }

    /* The window chassis: Win95 raised bevel, but in parchment, not grey. */
    #skippy-reader .lb-window {
      display: flex;
      flex-direction: column;
      /* Size the chassis to the photo, not to the viewport (Mark, 15 Nov 2026:
         "Beautiful unit test it with the ego browser... see for changes properly").
         A fixed min(96vw, 1400px) left a portrait photo stranded in ~59% empty
         cream. An explicit width can't see the image's aspect ratio, but a flex
         basis expressed in viewport HEIGHT can: a portrait image is the axis that
         binds, so sizing from 92vh makes the window land close to the photo's own
         shape. */
      width: auto;
      height: auto;
      /* NOT align-items:center — that shrank the title bar to the photo's width,
         which stranded the X in the middle of the window instead of the right
         corner (Mark, 15 Nov 2026: "the X isn't in the right hand corner").
         The body centres its own photo instead. */
      align-items: stretch;
      max-width: 96vw;
      max-height: 92vh;
      background: var(--color-paper);
      border: 2px solid var(--color-border);
      border-radius: 8px;
      box-shadow:
        inset 1px 1px 0 rgba(255, 255, 255, 0.55),
        inset -1px -1px 0 rgba(0, 0, 0, 0.18),
        0 18px 48px rgba(20, 17, 14, 0.45);
      overflow: hidden;
    }

    /* Title bar — the Win95 active title gradient, remapped to brand colours. */
    #skippy-reader .lb-titlebar {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      /* Right padding must be TINY: the X is the only control and it belongs in
         the top-right corner, not inset from it (Mark, 15 Nov 2026). */
      padding: 0.3rem 0.15rem 0.3rem 0.6rem;
      background: linear-gradient(
        90deg,
        var(--color-heading) 0%,
        var(--color-accent) 100%
      );
      color: #fff;
      font-family: var(--font-sans);
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.01em;
      user-select: none;
    }
    #skippy-reader .lb-title {
      flex: 1 1 auto;
      min-width: 0;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }
    #skippy-reader .lb-close {
      flex: 0 0 auto;
      /* 44px touch target (16 Nov 2026): the old 24x22px button was under the
         28px minimum and shared its background with the title bar, so on a phone
         it read as part of the chrome rather than as the one control that exists. */
      width: 2.75rem;
      height: 2.75rem;
      display: grid;
      place-items: center;
      font-family: var(--font-mono);
      font-size: 1.15rem;
      font-weight: 700;
      line-height: 1;
      color: var(--color-ink);
      background: var(--color-paper);
      /* Win95 raised bevel: light top-left, dark bottom-right. */
      border: 2px solid;
      border-color: #fff #6b6259 #6b6259 #fff;
      border-radius: 0;
      box-shadow: inset 1px 1px 0 #fff, inset -1px -1px 0 rgba(0, 0, 0, 0.25);
      cursor: pointer;
      padding: 0;
    }
    #skippy-reader .lb-close:hover { background: var(--color-surface); }
    #skippy-reader .lb-close:focus-visible {
      outline: 2px solid var(--color-highlight);
      outline-offset: 1px;
    }

    /* Body — the image, own scroll box so a tall portrait cannot exceed the view. */
    #skippy-reader .lb-body {
      overflow: auto;
      padding: 0.5rem;
      background: var(--color-surface);
      border-top: 1px solid var(--color-border);
      /* Height-driven basis: a portrait photo then determines the window width
         through its own aspect ratio instead of stretching to 1400px. */
      flex: 0 1 auto;
    }
    [data-theme="dark"] #skippy-reader .lb-titlebar {
      background: linear-gradient(
        90deg,
        var(--color-heading) 0%,
        var(--color-accent) 100%
      );
    }
    [data-theme="dark"] #skippy-reader .lb-window {
      box-shadow:
        inset 1px 1px 0 rgba(255, 255, 255, 0.12),
        inset -1px -1px 0 rgba(0, 0, 0, 0.5),
        0 18px 48px rgba(0, 0, 0, 0.65);
    }
    /* Never let the overlay itself scroll the page underneath. */
  
  /* ── The reader window: one stylesheet, zero animation ────────────────
     Deliberately NOT a new design. The chassis, bevel, title bar, X button
     and parchment body are all inherited from #skippy-lightbox in
     BaseLayout.astro, so a trivia card, a survival note and a family entry
     all open in the identical window Mark already approved on the photo
     pages. Only the body's CONTENTS differ per kind. */
  #skippy-reader {
    position: fixed; inset: 0; z-index: 9999;
    display: none; align-items: center; justify-content: center;
    padding: 1rem;
    background: rgba(20, 17, 14, 0.72);
    -webkit-backdrop-filter: blur(2px); backdrop-filter: blur(2px);
  }
  #skippy-reader.is-open { display: flex; }
  /* A long card ends mid-sentence if the body gives no sign it scrolls.
     A visible thumb is the cue — the window must look like it has more in it. */
  #skippy-reader .rd-body::-webkit-scrollbar { width: 10px; }
  #skippy-reader .rd-body::-webkit-scrollbar-track { background: rgba(0,0,0,.06); }
  #skippy-reader .rd-body::-webkit-scrollbar-thumb {
    background: var(--color-ink-light); border-radius: 5px;
    border: 2px solid var(--color-surface);
  }
  #skippy-reader .rd-body { scrollbar-width: thin; scrollbar-color: var(--color-ink-light) transparent; }
  #skippy-reader .rd-body {
    overflow: auto;
    padding: .85rem .95rem 1rem;
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    flex: 0 1 auto;
    /* The text body is the scroll box: a 5,760-character card cannot fit
       an 92vh window, and a clipped card is a broken card. */
    max-height: calc(92vh - 5rem);
    -webkit-overflow-scrolling: touch;
  }
  #skippy-reader .rd-kicker {
    font-family: var(--font-mono);
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--color-ink-light);
  }
  #skippy-reader .rd-h {
    font-family: var(--font-serif, serif);
    font-size: 1.18rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-ink);
    margin: .18rem 0 .5rem;
  }
  #skippy-reader .rd-figure {
    margin: .45rem 0 .6rem;
  }
  #skippy-reader .rd-figure[hidden] { display: none; }
  #skippy-reader .rd-img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 15rem;
    object-fit: cover;
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }
  /* The credit sits UNDER the photo, in the same small grey as the source
     block, because a lifted image without its licence is a liability, not a
     decoration. */
  #skippy-reader .rd-cap {
    font-size: .66rem;
    line-height: 1.35;
    color: var(--color-ink-light);
    margin-top: .22rem;
    overflow-wrap: anywhere;
  }
  #skippy-reader .rd-lede {
    font-size: .86rem;
    font-weight: 600;
    line-height: 1.35;
    margin-bottom: .3rem;
  }
  #skippy-reader .rd-power {
    font-size: .84rem;
    line-height: 1.45;
    font-style: italic;
    border-left: 3px solid var(--color-border);
    padding-left: .55rem;
    margin: .2rem 0 .6rem;
  }
  #skippy-reader .rd-text {
    font-size: .84rem;
    line-height: 1.5;
    margin: .5rem 0;
  }
  #skippy-reader .rd-text p { margin: 0 0 .55rem; }
  #skippy-reader .rd-text p:last-child { margin-bottom: 0; }
  #skippy-reader .rd-src {
    margin-top: .7rem;
    padding-top: .5rem;
    border-top: 1px dotted var(--color-border);
    font-size: .72rem;
    line-height: 1.45;
    color: var(--color-ink-light);
    overflow-wrap: anywhere;
  }
  /* Phones: a card that opened at 9px text is how Mark ended up squinting. */
  @media (max-width: 860px) {
    #skippy-reader { padding: .5rem; }
    #skippy-reader .rd-h { font-size: 1.05rem; }
    #skippy-reader .rd-lede, #skippy-reader .rd-power, #skippy-reader .rd-text { font-size: .8rem; }
    #skippy-reader .rd-src { font-size: .7rem; }
  }

  /* Closed cards sit FLUSH against the screen edge (Mark, 26 Nov 2026).
     The 12px gutter was the page wrapper's px-3, inherited from the layout —
     not the cards. Cancel it on the card column only: .tl-card-cell bleeds
     12px right, so the tabs reach the wall while the family text beside them
     keeps its own margin. */
  .tl-card-cell { padding-right: 0; }
  /* Above 64rem the wrapper is centred by mx-auto, so the gap to the wall is
     the centring margin PLUS its padding. Read it off the wrapper rather than
     re-deriving it — deriving it double-subtracted and pushed cards 192px
     off the screen. */

  .tl-card-cell { margin-right: calc(-1 * var(--wrap-gap, 12px)); }


  @media (max-width: 430px) {
    .tl-legend { grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); column-gap: .4rem; }
    .tl-legend > div { font-size: .46rem; }
    .tl-grid { grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); column-gap: .4rem; }
    .tl-cell h2 { font-size: 1.05rem; }
    .tcard { padding: .38rem .5rem; }
    .tcard-title { font-size: .78rem; }
  }
</style>

<!-- Reader window: a trivia tab, a survival note and a family entry all open
     the SAME Win95 chassis Mark already has on the photo pages
     (#skippy-lightbox in BaseLayout.astro). The chassis is reused; only the
     contents of the body differ. No slide animation, no inline reflow: the
     family line underneath never moves. -->
<script>
  /* Flush-to-the-wall measurement: the gutter the cards must cancel is
     whatever the page wrapper (and its mx-auto centring) actually contributes
     at this viewport — not a number guessed from the Tailwind classes. */
  (function () {
    function setWrapGap() {
      var card = document.querySelector("[data-rd]");
      if (!card) return;
      /* Walk up from a card to the first ancestor that actually has padding —
         that ancestor's right padding is the entire gutter between the tabs
         and the wall (measured: 12px phone, 16px tablet, 32px desktop). */
      var n = card.parentElement;
      var gap = 0;
      while (n && n !== document.body) {
        var cs = getComputedStyle(n);
        var pr = parseFloat(cs.paddingRight) || 0;
        var mr = parseFloat(cs.marginRight) || 0;
        if (pr > 0) {
          var r = n.getBoundingClientRect();
          gap = Math.max(0, Math.round(document.documentElement.clientWidth - r.right + pr));
          break;
        }
        if (mr > 0) gap += mr;
        n = n.parentElement;
      }
      document.documentElement.style.setProperty("--wrap-gap", gap + "px");
    }
    setWrapGap();
    addEventListener("resize", setWrapGap);
    addEventListener("load", setWrapGap);
  })();

  (function () {
    var KIND_LABEL: Record<string, string> = {
      family: "Family",
      survival: "What the line survived",
      freedom: "A freedom taken",
    };

    var box = document.createElement("div");
    box.id = "skippy-reader";
    box.setAttribute("role", "dialog");
    box.setAttribute("aria-modal", "true");
    /* Reuses the lightbox's own classes so the chassis, bevel and X button are
       the identical CSS, not a lookalike that drifts apart later. */
    box.innerHTML =
      '<div class="lb-window">' +
        '<div class="lb-titlebar">' +
          '<span class="lb-title"></span>' +
          '<button type="button" class="lb-close" aria-label="Close">&#10005;</button>' +
        '</div>' +
        '<div class="lb-body rd-body">' +
          '<div class="rd-kicker"></div>' +
          '<div class="rd-h"></div>' +
          '<div class="rd-figure" hidden>' +
            '<img class="rd-img" alt="" loading="lazy" />' +
            '<div class="rd-cap"></div>' +
          '</div>' +
          '<div class="rd-lede"></div>' +
          '<div class="rd-power"></div>' +
          '<div class="rd-text"></div>' +
          '<div class="rd-src"></div>' +
        '</div>' +
      '</div>';
    document.body.appendChild(box);

    var lastFocus: HTMLElement | null = null;
    var isOpen = false;

    function el<T extends HTMLElement>(sel: string): T {
      return box.querySelector(sel) as T;
    }

    function fill(name: string, value: string | null) {
      var node = box.querySelector("." + name) as HTMLElement | null;
      if (!node) return;
      if (value && value.trim()) {
        node.textContent = value;
        node.hidden = false;
      } else {
        node.textContent = "";
        node.hidden = true;
      }
    }

    function openReader(trigger: HTMLElement) {
      var d = trigger.dataset;
      var kind = d.kind || "freedom";
      lastFocus = trigger;

      el(".lb-title").textContent = KIND_LABEL[kind] || "Entry";
      fill("rd-kicker", d.kicker ?? null);
      fill("rd-h", d.title ?? null);
      fill("rd-lede", d.lede ?? null);
      fill("rd-power", d.power ?? null);
      fill("rd-text", d.text ?? null);
      fill("rd-src", d.src ?? null);

      /* Photo + its credit. Set src on the real element so the licensing
         line underneath can never drift away from the picture above it. */
      var fig = box.querySelector(".rd-figure") as HTMLElement | null;
      var img = box.querySelector(".rd-img") as HTMLImageElement | null;
      if (fig && img) {
        var src = (d.img ?? "").trim();
        if (src) {
          img.src = src;
          img.alt = (d.title ?? "") + " — illustrative photograph";
          fill("rd-cap", d.cap ?? null);
          fig.hidden = false;
        } else {
          img.removeAttribute("src");
          fig.hidden = true;
        }
      }

      /* A family entry keeps its own page one tap away: the window shows the
         line from the timeline, and this link walks to the whole story. */
      var textEl = el(".rd-text");
      var slug = d.slug && d.slug.trim();
      if (slug) {
        var a = document.createElement("a");
        a.href = "/people/" + slug + "/";
        a.className = "rd-more";
        a.textContent = "Read the full page for " + (d.title || "this person") + " \u2192";
        textEl.appendChild(a);
      }

      box.classList.add("is-open");
      document.body.classList.add("lb-locked");
      isOpen = true;
      el(".rd-body").scrollTop = 0;
      el(".lb-close").focus();
    }

    function closeReader() {
      if (!isOpen) return;
      box.classList.remove("is-open");
      document.body.classList.remove("lb-locked");
      isOpen = false;
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }

    el(".lb-close").addEventListener("click", closeReader);
    box.addEventListener("click", function (e) {
      if (e.target === box) closeReader();
    });
    document.addEventListener("keydown", function (e) {
      if (!isOpen) return;
      if (e.key === "Escape") { e.preventDefault(); closeReader(); }
    });

    /* One delegated pair handles every card on the page — including the
       single-card decks that used to refuse to close. */
    document.addEventListener("click", function (e) {
      var t = e.target as HTMLElement | null;
      var trigger = t && t.closest ? (t.closest("[data-rd]") as HTMLElement | null) : null;
      if (!trigger) return;
      /* Let the person link inside the window behave as a link. */
      if (t && t.closest && t.closest("#skippy-reader a")) return;
      e.preventDefault();
      openReader(trigger);
    });

    /* Survival cards are divs, so they need the keyboard path spelled out. */
    document.addEventListener("keydown", function (e) {
      if (e.key !== "Enter" && e.key !== " ") return;
      var t = e.target as HTMLElement | null;
      if (!t || !t.dataset || !t.hasAttribute("data-rd")) return;
      if (t.tagName === "BUTTON") return;
      e.preventDefault();
      openReader(t);
    });
  })();
</script>
