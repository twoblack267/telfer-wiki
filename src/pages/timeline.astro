<!-- Trivia deck: touch a tab to open its card; the rest fold back. One card
     in each deck always stays open, so a deck never collapses to nothing. -->
<script>
  document.querySelectorAll<HTMLElement>("[data-deck]").forEach((deck) => {
    const cards = Array.from(deck.querySelectorAll<HTMLElement>("[data-fcard]"));
    if (!cards.length) return;

    const open = (target: HTMLElement) => {
      cards.forEach((c) => {
        const isTarget = c === target;
        /* Record where the card will sit BEFORE it goes absolute, so the
           floating copy lands exactly on its own slot. */
        if (isTarget && !deck.classList.contains("is-leaky")) {
          const dr = deck.getBoundingClientRect();
          const cr = c.getBoundingClientRect();
          deck.style.setProperty("--open-top", `${Math.round(cr.top - dr.top)}px`);
          /* Set on the CARD, not just the deck: the card's own width calc
             reads this, and a deck-level custom property is not guaranteed
             to have resolved when the card's width is computed. */
          c.style.setProperty("--open-right", `${Math.round(dr.right - cr.right)}px`);
          deck.style.setProperty("--deck-closed-h", `${Math.round(dr.height)}px`);
        }
        c.classList.toggle("is-open", isTarget);
        const tab = c.querySelector<HTMLElement>("[data-ftab]");
        const body = c.querySelector<HTMLElement>("[data-fbody]");
        if (tab) tab.setAttribute("aria-expanded", isTarget ? "true" : "false");
        if (body) body.hidden = !isTarget;
      });
      /* Now the open card floats over the deck instead of growing it, so
         the family text below it stays exactly where it was. */
      deck.classList.add("is-leaky");
    };

    const close = (card: HTMLElement) => {
      card.classList.remove("is-open");
      const tab = card.querySelector<HTMLElement>("[data-ftab]");
      const body = card.querySelector<HTMLElement>("[data-fbody]");
      if (tab) tab.setAttribute("aria-expanded", "false");
      if (body) body.hidden = true;
      deck.classList.remove("is-leaky");
      deck.style.removeProperty("--deck-closed-h");
      card.style.removeProperty("--open-right");
    };

    cards.forEach((card) => {
      const tab = card.querySelector<HTMLElement>("[data-ftab]");
      if (!tab) return;
      tab.addEventListener("click", () => {
        const isOpen = tab.getAttribute("aria-expanded") === "true";
        /* Every tab must be able to toggle itself shut - including the only
           card in its deck. A tab that opens and refuses to close is the
           fault Mark keeps hitting. The deck keeps its height while open,
           so closing never collapses the family timeline. */
        if (isOpen) {
          close(card);
        } else {
          open(card);
        }
      });
    });
  });
</script>
