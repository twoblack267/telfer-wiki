---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { PersonData } from "../utils/extract-data.mjs";

const people = (await import("../data/people.public.json")).default as PersonData[];
const telferPeople = people.filter((p) => (p.branch === "telfer" || !p.branch) && p.id);

// Build a timeline of all events
interface TimelineEvent {
  year: number;
  sortYear: number;
  dateLabel: string;
  type: "birth" | "death" | "marriage" | "event";
  personName: string;
  personSlug: string;
  detail: string;
}

const timeline: TimelineEvent[] = [];

// tw-2026-09-14-020: birth_year / death_year may be an APPROXIMATE string
// ("~1892", "~1885", "~1960") rather than a number — the vault marks estimates
// with a leading tilde. Pushing those straight into `year` produced
// Math.floor("~1892"/10)*10 = NaN, which built a literal 'NaNs' decade chip
// labelled "NaNs" pointing at href="#decade-NaN" (3 timeline entries: Leslie
// Frank Dillon, Charles Farrow Jr, Florence Nicholas). A non-numeric year must
// never mint a decade anchor — parse it, and fall back to the raw string only
// for display (new Date() keeps the entries sorted instead of collapsing).
function parseYearValue(value: unknown): number | null {
  if (typeof value === "number" && Number.isFinite(value)) return value;
  if (typeof value !== "string") return null;
  const match = value.match(/-?\d{3,4}/);
  if (!match) return null;
  const parsed = Number.parseInt(match[0], 10);
  return Number.isFinite(parsed) ? parsed : null;
}

function makeEvent(
  raw: unknown,
  display: unknown,
  type: TimelineEvent["type"],
  personName: string,
  personSlug: string,
  detail: string,
): TimelineEvent {
  const numeric = parseYearValue(raw);
  return {
    year: numeric ?? (raw as any),
    dateLabel: `${display}`,
    type,
    personName,
    personSlug,
    detail,
    sortYear: numeric ?? Number.MAX_SAFE_INTEGER,
  };
}

for (const p of telferPeople) {
  if (p.birth_year) {
    timeline.push(
      makeEvent(
        p.birth_year,
        p.birth_year,
        "birth",
        p.display_name,
        p.slug,
        "is born",
      ),
    );
  }

  if (p.death_year) {
    const birthNumeric = parseYearValue(p.birth_year);
    const deathNumeric = parseYearValue(p.death_year);
    const aged =
      birthNumeric !== null && deathNumeric !== null
        ? deathNumeric - birthNumeric
        : "?";
    timeline.push(
      makeEvent(
        p.death_year,
        p.death_year,
        "death",
        p.display_name,
        p.slug,
        aged === "?" ? "dies" : `dies, aged ${aged}`,
      ),
    );
  }
}

// Add key historical events from tree content
timeline.push({ year: 1839, sortYear: 1839, dateLabel: "1839", type: "event", personName: "Francis Telfer", personSlug: "francis-telfer-1809", detail: "emigrates to South Australia" });
timeline.push({ year: 1845, sortYear: 1845, dateLabel: "1845", type: "event", personName: "The Telfer family", personSlug: "", detail: "settles in the Tantanoola district, SA" });
timeline.push({ year: 1874, sortYear: 1874, dateLabel: "1874", type: "event", personName: "John Telfer", personSlug: "john-telfer-1847", detail: "marries Caroline Masters" });

// Sort by year (sortYear guarantees finite numerics; unparseable years sink to the end)
timeline.sort((a, b) => a.sortYear - b.sortYear);

// Group by decade for navigation
const decades: { label: string; year: number }[] = [];
const seenDecades = new Set<number>();
for (const t of timeline) {
  const decade = Math.floor(t.sortYear / 10) * 10;
  if (!Number.isFinite(decade)) continue;
  if (!seenDecades.has(decade)) {
    seenDecades.add(decade);
    decades.push({ label: `${decade}s`, year: decade });
  }
}
// ── Survivals column ──────────────────────────────────────────────────
// tw-2026-11-25-001: a second column beside each decade holding "things
// that could have ended the family line and didn't". Mark's scope, 25 Nov
// 2026: not only failed prophecies — real wars, epidemics and near-misses
// count, provided every one is real, dated and sourced. Decade alignment
// governs placement: a card sits in the decade it belongs to, and a decade
// with no card stays EMPTY. No artificial spreading, no fabricated scare.
// Overlap of two cards is allowed ONLY within the same decade (~8px).
interface Survival {
  decade: number;
  year: string;
  title: string;
  feared: string;
  detail: string;
  source: string;
  img: string;
  cap: string;
  tone: "rose" | "sage" | "blue" | "lavender" | "peach";
}

const survivals: Survival[] = [
  { decade: 1780, year: "1789", title: "Smallpox reaches Sydney", tone: "rose",
    feared: "Up to 220,000 Aboriginal Australians dead",
    detail: "<p>In April 1789, eighteen months after the First Fleet came ashore at Sydney Cove, smallpox broke out among the Aboriginal people of the harbour. It did not stay there. The disease ran ahead of the frontier rather than behind it, killing people who had never seen a European, in country no settler had yet walked into.</p> <p><b>How many died.</b> In July 2026 a study in <i>Nature Human Behaviour</i> estimated that up to <b>220,000</b> Aboriginal Australians died in the epidemic and those that followed it. That number is a <i>model</i>, not a headstone count — the authors combined colonial records with demographic reconstruction, and some historians of the frontier argue the result is too high. It is the best modern estimate available, it is contested, and it is quoted here as the study's own figure with its method named, because a number this large should never be passed on without saying where it came from.</p> <p><b>Where the disease came from is argued as well.</b> One reading is that the colonists carried it and the infection escaped the settlement. The other, argued at length by the historian Christopher Warren, is that smallpox was already present in northern coastal Australia, brought south along the trade routes by Macassan trepangers from Indonesia, and reached the harbour from the land side. The <i>Nature Human Behaviour</i> study favours the First Fleet. Both readings rest on real evidence and neither can be proven outright, and this card does not pretend otherwise.</p> <p><b>What is not in dispute</b> is the consequence. Smallpox reached a people who had no immunity to it, in country where the settler frontier had not yet arrived, and it removed a great part of them before there was a frontier to resist. The dispossession that followed was carried out against a population already devastated.</p> <p><b>The symmetry to hold onto:</b> the same disease was declared eradicated from the human species in 1980. Fewer than two hundred years separates the two cards on this shelf, and only one of them is a victory.</p>",
    source: "Sources: <i>Nature Human Behaviour</i>, July 2026, modelling estimate of up to 220,000 deaths; Christopher Warren, ‘Smallpox at Sydney Cove – who, when, why?’, <i>Journal of Australian Studies</i> 38:1 (2014); Museum of Australian Democracy, ‘Smallpox breaks out’.",
    img: "/images/timeline/1789-smallpox.jpg",
    cap: "Captain John Hunter’s 1789 sketch of a Garigal woman at Pittwater suffering from smallpox. Wikimedia Commons, public domain." },
  { decade: 1870, year: "1870s", title: "One child in nine", tone: "lavender",
    feared: "17 per cent of Australian children died before five",
    detail: "<p>In <b>1870</b>, an estimated <b>17.0 per cent</b> of Australian children died before their fifth birthday. Roughly one in six. The figure comes from the long-run child mortality series compiled by Gapminder and published through <i>Our World in Data</i>, built on United Nations mortality estimates and carrying 152 annual data points for Australia between 1870 and 2021. It is a modern reconstruction of a period that never kept a clean national count, not a census tally, and it should be read as an estimate with a method behind it rather than an exact record.</p> <p><b>The decline is the story.</b> By 1880 the rate was 18.1 per cent — worse, not better. By 1900 it had fallen to 14.9 per cent, by 1930 to 6.4 per cent, and today it is well under one per cent. That fall is among the most consequential changes in the history of the Australian family, and it was not mainly made of hospitals. It was made of sewerage, clean water, milk that was kept cold, and later vaccination. The medicine came after the drains.</p> <p><b>What it meant in one house.</b> A family with six children could expect to bury one. The causes were ordinary for the time and preventable by ours: diarrhoea and the water that carried it, diphtheria, measles, whooping cough, tuberculosis, and accidents in a backyard with no telephone to call for help. Parish registers record the burials and rarely the reason.</p> <p><b>Why it belongs on a genealogy site.</b> A grave register listing nine children for one couple is not a statement about that mother's fertility. It is this statistic applied to one household, and reading it as anything else is the most common mistake made of nineteenth-century family records.</p>",
    source: "Source: Gapminder / United Nations IGME child mortality series, published by Our World in Data, Australia, 1870–2021 (152 annual observations). Values: 17.0% (1870), 18.1% (1880), 14.9% (1900), 6.4% (1930).",
    img: "/images/timeline/1870s-child-mortality.jpg",
    cap: "A bush school in the Logan–Beenleigh district, Queensland, c. 1872. State Library of Queensland, public domain." },
  { decade: 1910, year: "1914–18", title: "The Great War", tone: "sage",
    feared: "416,809 enlisted; more than 60,000 killed",
    detail: "<p><b>416,809</b> Australians enlisted for service in the First World War, out of a population of fewer than five million. <b>More than 60,000 were killed.</b> Both figures are the Australian War Memorial's, and the Memorial states on its own pages that its counts are subject to discrepancy and revision. They are quoted here as the Memorial's figures, not as a settled total.</p> <p><b>The arithmetic of a small country.</b> Australia had no conscription for overseas service. Every one of those 416,809 was a volunteer, and roughly one in two men of military age went. Of those who went, more than one in seven never came home. Enlistment was heaviest in 1915 and 1916, and it drew hardest on the small towns and farming districts where the family names on this tree are found.</p> <p><b>The cost in the family.</b> Gallipoli in 1915 killed or mortally wounded <b>8,141</b> Australians, on the Memorial's own fatality figure. The Western Front killed many more, at Fromelles, Pozières, Bullecourt, Messines, Passchendaele, Villers-Bretonneux and Mont St Quentin — names that appear in the service records of men in this tree. A branch that ends abruptly around 1920 with no children is often explained by this card.</p> <p><b>A distinction worth knowing.</b> The 60,000 is a war dead figure, counting deaths while serving. Most were killed in action or died of wounds; the rest died of disease. It is not a count of deaths in battle, and it is the number the Memorial uses.</p>",
    source: "Sources: Australian War Memorial, ‘Enlistment statistics, First World War’ and ‘Australian casualties’; AWM, ‘Gallipoli fatalities’. The Memorial states its own counts are subject to discrepancy and revision.",
    img: "/images/timeline/1914-great-war.jpg",
    cap: "Australian infantry at Villers-Bretonneux, May 1918. Australian War Memorial, public domain." },
  { decade: 1840, year: "1846–47", title: "The Highland famine", tone: "sage",
    feared: "The same blight that emptied Ireland",
    detail: "<p>Ireland is the famine everyone remembers. Scotland had one too, in the same years and from the same cause, and it ended differently — which is the part worth understanding.</p> <p><b>What happened.</b> <i>Phytophthora infestans</i>, the blight that destroyed the Irish potato, reached the Scottish Highlands in <b>August 1846</b> and took most of the crop. In the crofting counties — the Hebrides, Skye, and the west coast — a quarter to a third of the population in some parishes was destitute within months. The potato was not a supplement in those parishes. It was the diet.</p> <p><b>Why it did not kill as Ireland's did.</b> The government had been destroyed politically by its handling of Ireland and acted differently this time. It funded <b>Highland Destitution Relief</b> through a Central Relief Board, ran public works building roads and piers — many of them still in use today — and shipped meal into the affected parishes, while landowners and charities carried much of the rest of the burden. Relief on that scale, together with emigration, kept the mortality comparatively low.</p> <p><b>The toll, stated honestly.</b> Estimates run to the low thousands, and no single reliable figure is agreed among historians. The record for the Highlands in these years is genuinely much less well documented than Ireland's, and it is more honest to say that than to produce a number the sources will not support.</p> <p><b>The lasting cost was demographic, not mortal.</b> Emigration to Glasgow, to Canada and to Australia emptied the crofting townships within a generation, and a way of life effectively ended. On a tree with Highland branches there will often be a smallholder recorded in 1846 who was a migrant by 1852, with no record of the years between.</p>",
    source: "Sources: T. M. Devine, <i>The Great Highland Famine</i> (1988); Central Relief Board records; National Records of Scotland, Highland destitution relief papers.",
    img: "/images/timeline/1846-highland-famine.jpg",
    cap: "Abandoned lazy beds at Skarsal — the ridged plots where Highland potatoes were grown by hand. Photograph: Colin Smith, CC BY-SA 2.0, via Wikimedia Commons." },
  { decade: 1930, year: "1929–39", title: "The Great Depression", tone: "rose",
    feared: "32 per cent of Australian workers out of work",
    detail: "<p>At the worst of it, in <b>1932</b>, roughly <b>32 per cent</b> of Australian workers were out of work — close to one in three, on the National Museum of Australia's account of the Depression. Before 1929 the rate had been around ten per cent. It stayed above a quarter for most of the decade, and the labour market did not fully recover until the war began.</p> <p><b>How it reached Australia.</b> The country's export income collapsed when world prices for wool and wheat fell, while its overseas debt still had to be paid in sterling. The Premiers' Plan of 1931 cut government spending and wages in an attempt to balance the budget — orthodox economics of the day, and it deepened the slump before it relieved it. Recovery came partly through the devaluation of the Australian pound in 1931 and the cheap money that followed.</p> <p><b>What it looked like.</b> Men left their families and walked the roads looking for work. The <i>susso</i> — sustenance relief — and the dole queue became the visual language of the decade, along with evictions, shanty towns on the edges of cities, and a generation that left school at fourteen into a market with nothing in it.</p> <p><b>The habits it left.</b> A grandparent who cannot throw food away, who keeps string in a drawer, or who would never hold a bank account, is often carrying this decade. Three years of thirty per cent unemployment set a lifetime's habits in people who lived through it as children.</p> <p><b>One caution on the number.</b> Australia's peak of 32 per cent is not the American figure of about 25 per cent, nor the British figure of roughly 15 per cent. The three are measured differently and are not interchangeable, and the Australian rate was among the worst in the developed world.</p>",
    source: "Sources: National Museum of Australia, ‘The Great Depression’ and ‘Height of the Great Depression’; Commonwealth Bureau of Census and Statistics unemployment series, 1929–39.",
    img: "/images/timeline/1929-depression.jpg",
    cap: "Relief workers at Annerley, Brisbane, during the Depression. State Library of Queensland, public domain." },
  { decade: 1940, year: "14 May 1944", title: "The Second World War", tone: "sage",
    feared: "Nearly one million Australians served",
    detail: "<p>By <b>1944</b> the war that had begun in Europe had been fought to Australia's own coastline, and the country was four years into a total mobilisation that touched nearly every household on this tree.</p> <p><b>The scale.</b> Close to <b>one million</b> Australians served in the Second World War — men and women — out of a population of about seven million. More than one in seven of the entire country. The Second AIF, the Militia, the RAAF, the Royal Australian Navy and the women's services all drew on the same small towns the names in this tree come from.</p> <p><b>When the war came here.</b> Darwin was bombed in <b>February 1942</b>. Japanese midget submarines entered Sydney Harbour in <b>May 1942</b>. Between July and November 1942 Australians fought the Japanese to a standstill on the Kokoda Track across the Owen Stanley Range in Papua, and the fighting at Milne Bay that August was the first outright defeat of a Japanese land force in the war. The photograph above shows men of the 39th Battalion after Kokoda — the unit that held the track first, and paid for it.</p> <p><b>The home front.</b> Rationing of clothing, tea, sugar and petrol; blackout drills; manpower controls that directed women into factories and the services; and hundreds of thousands of American servicemen based in Queensland, which changed the state permanently.</p> <p><b>The aftermath that changed who lives here.</b> The post-war immigration programme begun under Arthur Calwell in 1945 brought more than two million migrants to Australia in the following two decades. If this tree holds a surname that appears on no 1939 electoral roll, that programme is usually why — and the marriage that brought it into the line is a direct consequence of how this war ended.</p>",
    source: "Sources: Australian War Memorial, ‘Second World War’; AWM 013289, photograph by Damien Parer, 39th Battalion.",
    img: "/images/timeline/1944-ww2.jpg",
    cap: "Men of the 39th Battalion after the Kokoda campaign, 1942. Photograph: Damien Parer, AWM 013289, public domain." },
  { decade: 1910, year: "1919", title: "Spanish flu", tone: "peach",
    feared: "17.4 million to 100 million dead worldwide",
    detail: "<p>Nobody called it Spanish flu while it was happening. The name came later, because Spain's neutral press reported the disease freely while the newspapers of the belligerent countries were under wartime censorship. Where it actually began is still argued — Kansas, France and China all have serious cases made for them.</p> <p><b>The death toll is a range, and any single number is a guess.</b> Modern estimates run from about <b>17.4 million</b> at the low end to <b>100 million</b> at the high end. The spread exists because most of the world's poor died without registration and because mortality was so extreme in places like India that the lower estimates cannot be complete. The honest statement is the range, with its uncertainty named.</p> <p><b>What made this one different.</b> It killed young adults preferentially. The mortality curve was W-shaped, with a peak among people in their twenties and thirties — the strongest cohort, not the weakest. The most widely accepted explanation is an over-strong immune response: the immune system attacked the lungs so violently that it destroyed them. There were no antibiotics for the secondary pneumonia that finished many patients.</p> <p><b>In Australia.</b> Maritime quarantine, and the plain fact that the continent is an island, slowed its arrival and broke it into many separate outbreaks rather than one national wave. Around <b>12,000</b> Australians died. In a population of about five million that is a smaller share than most of Europe suffered, and it was still the worst infectious disaster the country had seen.</p> <p><b>A note on the photograph.</b> The image above shows a makeshift influenza hospital in Brisbane in 1919 — schools, exhibition halls and hospitals were pressed into service because there were not enough beds.</p>",
    source: "Sources: Our World in Data, ‘The Spanish flu: the largest influenza pandemic in history’; Australian Institute of Health and Welfare mortality records, 1919; National Museum of Australia, ‘Influenza pandemic 1919’.",
    img: "/images/timeline/1919-spanish-flu.jpg",
    cap: "A temporary influenza hospital, Brisbane, April 1919. State Library of Queensland, public domain." },
  { decade: 1890, year: "1890", title: "The Russian flu", tone: "lavender",
    feared: "Up to 900 million infected; about a million dead",
    detail: "<p>This is the card on this shelf that turns out to be a different story from the one it is usually told as, because the disease called the Russian flu probably <b>was not influenza at all</b>.</p> <p><b>The event.</b> A respiratory pandemic began in <b>Bukhara</b>, in the Russian Empire, in the spring of 1889, reached St Petersburg and then the rest of Europe within months, and circled the world in under a year — at a time when fast meant railway and steamship. Estimates put infections at <b>300 to 900 million</b> out of a world population of about 1.5 billion, with roughly <b>one million deaths</b>. It was fast, it was everywhere, and it was not catastrophic. The Spanish flu of 1918 is what made the world forget it.</p> <p><b>The twist.</b> Work on preserved tissue and serological evidence led a group of researchers — most prominently the Belgian virologist Leen Vijgen and colleagues, following earlier work by Andrée van Harten in the Netherlands — to argue that the 1889 agent was <b>human coronavirus OC43</b>, not an influenza virus. OC43's descendants cause a share of the common colds circulating today. If that reading is right, then a coronavirus has shut down the world once before, and it never left.</p> <p><b>Why the argument is not settled.</b> The evidence is indirect — reconstructed sequences from old tissue, and the shape of the age-specific mortality. Other researchers hold that the 1889 pandemic was an influenza, and the dispute is live. Both positions are stated here because the uncertainty is more instructive than either answer.</p> <p><b>Why it belongs on this shelf.</b> Because it shows how quickly the world's memory of a pandemic expires. Thirty years after 1890 this outbreak was almost entirely forgotten, and a worse one with a better story took its place.</p>",
    source: "Sources: Leen Vijgen et al., ‘Complete genomic sequence of human coronavirus OC43’, <i>Journal of Virology</i> 79 (2005); A. van Harten’s serological work; epidemiological literature on the 1889–90 pandemic.",
    img: "/images/timeline/1890-russian-flu.jpg",
    cap: "Fever wards at the division hospital, Jacksonville, Florida, 1898. Wikimedia Commons, public domain." },
  { decade: 1950, year: "1951", title: "Polio", tone: "blue",
    feared: "357 Australians dead in one year",
    detail: "<p>Australia's polio epidemic peaked in <b>1951</b>, with <b>357 deaths</b> nationally, according to the Australian Institute of Health and Welfare's 2025 report <i>Polio in Australia</i>. The country's last epidemics came in <b>1956</b> and again in <b>1960–62</b>. Vaccination began in the mid-1950s, the vaccine was brought into the National Immunisation Program in <b>1975</b>, and the World Health Organization declared the Western Pacific region — Australia with it — <b>polio-free in 2000</b>.</p> <p><b>What an epidemic year was like.</b> Polio fell hardest on children. Schools closed at short notice, public swimming pools and cinemas were shut, and parents kept their children away from crowds through whole summers. Hospitals filled with patients in iron lungs — negative-pressure tanks that breathed for a paralysed chest. The photograph above shows one, preserved in a hospital museum. Of those who reached paralysis, between <b>5 and 10 per cent</b> died when the breathing muscles were immobilised — the figure the historical record gives, and the reason iron lungs mattered so much.</p> <p><b>The Australian contribution.</b> In 1937 Edward Both, an Adelaide engineer, designed a respirator made of plywood that could be built cheaply and in quantity. The Both respirator was made in Australia and exported, and it kept patients alive through the epidemics at a fraction of the cost of the imported machines.</p> <p><b>Why it still matters.</b> Survivors of the 1930s and 1950s epidemics are in their seventies and eighties now. <i>Post-polio syndrome</i> — the return of weakness and fatigue decades after recovery — is still on the medical record. A family memory of a child with \"infantile paralysis\", or a limp in an old photograph with no explanation attached, is usually this disease.</p> <p><b>How it ended.</b> There is no cure for polio. It was defeated by vaccination and by surveillance — the same method that ended smallpox, and the only method that has ever ended a human disease.</p>",
    source: "Sources: Australian Institute of Health and Welfare, <i>Polio in Australia</i>, PHE 236 (2025); Commonwealth Department of Health notifications, 1951; Powerhouse Collection, ‘Both respirator’.",
    img: "/images/timeline/1951-polio.jpg",
    cap: "An iron lung, preserved at Royal Perth Hospital museum. Photograph via Wikimedia Commons, CC BY-SA 3.0." },
  { decade: 1960, year: "1960 → 2026", title: "Doomsday: Friday 13 November", tone: "blue",
    feared: "Population reaches infinity on a Friday",
    detail: "<p>On <b>4 November 1960</b>, the journal <i>Science</i> published a paper by three researchers at the University of Illinois — <b>Heinz von Foerster</b>, <b>Patricia Mora</b> and <b>Lawrence Amiot</b> — under the title \"Doomsday: Friday, 13 November, A.D. 2026\". They fitted a curve to world population across two millennia, and the curve ran to infinity.</p> <p><b>What they found.</b> Population was not merely growing; the rate at which it grew was itself growing. Model that and the mathematics gives a vertical line — a singularity — on one particular day. Friday, 13 November, 2026. It is the same prediction made by the Mayan calendar card and by every millenarian movement in history, with the difference that this one was made by physicists, in print, in a journal, with the arithmetic shown.</p> <p><b>What actually happened.</b> They were right about the mathematics of the past and wrong about the species. The hyperbolic curve describes pre-industrial population well and fails completely in the twentieth century, because birth rates fell. The demographic transition — the same process that took Australian under-five mortality from seventeen per cent to under one per cent — broke the curve long before it reached the wall. World population growth peaked in the late 1960s and has fallen ever since, and the United Nations projects a peak later this century followed by decline in many countries.</p> <p><b>The part that is usually left out.</b> Von Foerster and his co-authors knew. The paper is a deliberate provocation — a demonstration that extrapolating a curve is not a prediction, dressed up as one to make the point that human beings do not behave like a colony of bacteria. The doomsday date is the argument, not the conclusion.</p> <p><b>Why it earns a card.</b> Because it was falsifiable, dated, and published. Most prophecy is none of those things. This one can be checked against a calendar, and that is exactly what a claim about the future should be worth.</p>",
    source: "Source: H. von Foerster, P. M. Mora and L. W. Amiot, ‘Doomsday: Friday, 13 November, A.D. 2026’, <i>Science</i> 132:3436 (4 November 1960), 1291–1295.",
    img: "/images/timeline/1960-doomsday.jpg",
    cap: "Global population density in 2000, from the GRUMP dataset (CIESIN / IFPRI / World Bank / CIAT), CC BY 3.0." },
  { decade: 1980, year: "1980", title: "Smallpox eradicated", tone: "sage",
    feared: "A 3,000-year killer, gone",
    detail: "<p><b>8 May 1980.</b> The World Health Assembly, meeting in Geneva, declared that smallpox had been eradicated from the world. It remains the only human disease to have been wiped out as a naturally occurring infection.</p> <p><b>The sequence, exactly.</b> The World Health Organization launched its intensified eradication programme in <b>1967</b>. The last known natural case occurred in <b>Mereso, Somalia, in October 1977</b>. An independent Global Commission for the Certification of Smallpox Eradication, drawing on nineteen countries, certified the world free of the disease in <b>December 1979</b>. The Assembly adopted resolution WHA33.3 declaring eradication on <b>8 May 1980</b>.</p> <p><b>How it was done.</b> Not by mass vaccination alone. The decisive method was <b>ring vaccination</b> combined with surveillance: find every case, vaccinate everyone in contact with it, and pay local people to report new cases. In country with no roads and no refrigeration the campaign used <b>freeze-dried vaccine</b> that did not need a cold chain, and <b>bifurcated needles</b> that let a single dose be given with less vaccine and by people with minimal training. The programme cost roughly <b>300 million US dollars</b> over about a decade.</p> <p><b>Why it sits opposite the 1789 card.</b> The disease that may have killed up to 220,000 Aboriginal Australians after it reached Sydney Cove is the same disease declared gone from the human species, and fewer than two hundred years separate them. Everything else on this shelf — the famines, the wars, the influenzas — is a defeat or a survival. This is the only card here that is an ending, and it was done with needles, paperwork and people walking into villages.</p>",
    source: "Sources: World Health Organization, resolution WHA33.3 (8 May 1980); WHO, ‘Smallpox eradication certification’; WHO, <i>The Global Eradication of Smallpox</i> (1980).",
    img: "/images/timeline/1980-eradication.jpg",
    cap: "Three directors of the Global Smallpox Eradication Program read the 1980 eradication announcement. Photograph: CDC, public domain." },
  { decade: 2010, year: "21 Dec 2012", title: "The Mayan calendar ends", tone: "lavender",
    feared: "The 13th b'ak'tun — and nothing else",
    detail: "<p><b>It didn't end.</b> That is the card.</p> <p><b>What actually happened on that date.</b> The Maya Long Count calendar completed its thirteenth <i>b'ak'tun</i> — the date written <b>13.0.0.0.0</b>. The Long Count is a count of days from a mythological creation date in 3114 BC. A <i>b'ak'tun</i> is 144,000 days, a little under 395 years. The count had rolled over at 11.0.0.0.0 and 12.0.0.0.0 before, and it rolled over again. Nothing in Maya inscription says a cycle's end is the world's end.</p> <p><b>Where the prophecy came from, and who retracted it.</b> The inscription usually cited is <b>Tortuguero Monument 6</b>, and its damaged final passage was read as a prophecy of an ending by the epigrapher Markus Eberl and then, most influentially, by <b>David Stuart</b> — the scholar who did more than anyone to put the 2012 prophecy into circulation. Stuart later published that the text had been over-read. His correction ran against his own earlier work, which is the kind of thing that makes a claim worth trusting.</p> <p><b>The Maya said so themselves.</b> In 2012 Maya people said it repeatedly and publicly, in their own communities and to the press. The Grand Elder of the Maya confederation told journalists that the world was not ending and that the story was an outsider's misunderstanding of a calendar that was never a prophecy in the first place.</p> <p><b>The evidence that settles it is Maya.</b> At <b>Xultun</b>, in Guatemala, archaeologists published in <i>Science</i> in May 2012 a set of mural paintings and astronomical tables, including a date column that runs thousands of years past 2012 — into the seventh millennium, past 3500 AD. Scribes were keeping that record in the ninth century for a future they plainly expected to occur. A calendar that continues in its own inscriptions does not end in ours.</p>",
    source: "Sources: David Stuart, ‘More on Tortuguero’s Monument 6 and the prophecy that wasn’t’, Maya Decipherment (2011); W. Saturno, D. Stuart and A. Rossi, ‘Ancient Maya astronomical tables from Xultun, Guatemala’, <i>Science</i> 336 (2012).",
    img: "/images/timeline/2012-mayan.jpg",
    cap: "The Temple of the Inscriptions at Palenque, which holds the longest Maya Long Count text known. Photograph: Arian Zwegers, CC BY 2.0." },
  { decade: 2020, year: "2020–22", title: "COVID-19", tone: "peach",
    feared: "About 11,800 Australian deaths in three years",
    detail: "<p>SARS-CoV-2, a coronavirus, was first reported in Wuhan, China, in December 2019 and declared a pandemic by the World Health Organization on <b>11 March 2020</b>. The disease it causes is COVID-19.</p> <p><b>Its nearest relative on this shelf.</b> The 1889 pandemic two cards over is suspected, on serological and sequence evidence, of having been caused by human coronavirus OC43 — which descends to a virus that causes a share of common colds today. \"Novel\" is a relative term, and this shelf holds an earlier coronavirus outbreak that was forgotten within a generation.</p> <p><b>The numbers, held carefully.</b> Australia recorded roughly <b>11,800 deaths</b> where COVID-19 was the underlying or associated cause during the first three years of the pandemic, on Australian Bureau of Statistics provisional mortality data. In a population of about 26 million that is a small share — the Spanish flu killed around 12,000 in a population of five million, a far higher proportion. Case counts became close to meaningless once testing policy changed, so this card compares deaths and says so. The dead were heavily concentrated among the elderly and those with existing illness, which is the plainest single fact about who this disease took.</p> <p><b>The response belongs to the other shelf.</b> What was done to Australians in these two years — the gathering ban of March 2020, the aged-care vaccination mandate, the church closures, the arrests — is documented on the freedom card covering 2020–22, where it belongs, with its sources. This card is the disease.</p> <p><b>What the world did that no previous generation had done.</b> It stopped. Borders closed, schools shut, and for a period in 2020 the movement of most of humanity was restricted by law. For a respiratory virus that killed a small fraction of those it infected, that was an unprecedented response, and whether it was proportionate remains a live argument that this vault will not settle for you.</p>",
    source: "Sources: Australian Bureau of Statistics, <i>Provisional Mortality Statistics</i>, 2020–2022; World Health Organization pandemic declaration, 11 March 2020.",
    img: "/images/timeline/2020-covid.jpg",
    cap: "Grey Street, South Brisbane, empty during pandemic restrictions. Wikimedia Commons, CC BY-SA 4.0." },
];

const survivalsByDecade = new Map<number, Survival[]>();
for (const s of survivals) {
  const list = survivalsByDecade.get(s.decade) ?? [];
  list.push(s);
  survivalsByDecade.set(s.decade, list);
}

// ── Freedoms column ───────────────────────────────────────────────────
// tw-2026-11-26-002: Mark asked for "things that took away freedoms from
// normal Australians" — the new digital duty of care bill and whatever else
// does it. This is a THIRD column, deliberately separate from the survivals
// column, because a law that removed a freedom is not a near-extinction
// event, and filing it under "could have ended the line and didn't" would
// be a category error and a lie of emphasis.
//
// EVIDENCE RULE for this column, non-negotiable: a card may only state what
// a NAMED Commonwealth Act does, quoting the Act's own operative words. The
// Act text at legislation.gov.au is the witness; no blog, no campaign, no
// newspaper. No characterisation ("police state", "like China") appears as
// fact — the reader draws the conclusion. Every card carries the Act, the
// assent date and the verbatim power. Decade = the decade of assent.
interface Freedom {
  decade: number;
  year: string;
  title: string;
  enacted: string;
  power: string;
  detail: string;
  source: string;
  img?: string;
  cap?: string;
  tone: "rose" | "sage" | "blue" | "lavender" | "peach" | "sky";
}

const freedoms: Freedom[] = [
  { decade: 2010, year: "2015", title: "Two years of records on everyone", tone: "rose",
    enacted: "Data Retention Act 2015 — No. 39, 2015",
    power: "“A person (a service provider) … must keep, or cause to be kept … relating to any communication carried by means of the service”",
    img: "/images/timeline/2015-data-retention.jpg",
    cap: "A telephone exchange in Queanbeyan, New South Wales. Photograph by Shkuru Afshar, Wikimedia Commons, CC BY-SA 4.0 — licensed for reuse with attribution.",
    detail: "Two years. Every carrier and internet provider in Australia must keep, on every subscriber: name and address, contract and billing details, who you contacted, when, for how long, and the cell tower or Wi-Fi hotspot at each end. Not what you said. Who, when, where. The clock runs two years past the closing of your account. You were never asked.\n\nThe obligation comes from a statute passed in a week. The Telecommunications (Interception and Access) Amendment (Data Retention) Act 2015 received Royal Assent on 13 April 2015 and commenced on 13 October 2015. It inserted sections 187A, 187AA, 187B and 187C into the Telecommunications (Interception and Access) Act 1979. Section 187AA requires providers to keep and destroy the specified data — the two-year clock is not optional storage, it is a legislated duty to retain information that would otherwise have been discarded.\n\nThe scheme was sold as a limited exception. It is not: it reaches every carriage service provider in the country, and the dataset it creates is the one that answers the questions an investigation begins with. Who called whom, and from where. Access to it does not require a warrant. It requires an authorisation from an officer of an agency, and the Act's annual report counts those authorisations by the hundred thousand.\n\nThe review is worth reading beside the law. The Parliamentary Joint Committee on Intelligence and Security reported on the regime in 2020 and did not recommend repeal. It recommended scaling back parts of it. Eight years on, the two-year retention duty stands and the data set has only grown. Whether that is proportionate is a judgment for the reader — the statute is on the shelf either way.",
    source: "Telecommunications (Interception and Access) Act 1979 (Cth), ss.187A–187C, inserted by Telecommunications (Interception and Access) Amendment (Data Retention) Act 2015 (No. 39 of 2015) — Royal Assent 13 Apr 2015, commenced 13 Oct 2015; Parliamentary Joint Committee on Intelligence and Security, Review of the mandatory data retention regime (Report, October 2020) — did not recommend repeal; Human Rights Law Centre, “Intelligence committee recommends scaling back privacy-invading metadata laws” (29 Oct 2020)",
    tone: "rose" },

  { decade: 2010, year: "2018", title: "Breaking encryption, by notice", tone: "blue",
    enacted: "Assistance and Access Act 2018 — No. 148, 2018",
    power: "“…frameworks for voluntary and mandatory industry assistance to law enforcement and intelligence agencies in relation to encryption technologies”",
    img: "/images/timeline/2018-access-assistance.jpg",
    cap: "Australian Federal Police headquarters, Canberra. Photograph by Bidgee, Wikimedia Commons, CC BY-SA 3.0 — licensed for reuse with attribution.",
    detail: "Three instruments, in rising order of force. A technical assistance request asks a company to help voluntarily. A technical assistance notice compels a designated communications provider to do what it can do. A technical capability notice compels it to build a capability it does not yet have — including the capability to defeat its own encryption. The Act received Royal Assent on 8 December 2018 as Act No. 148 of 2018 and came into force in stages through 2019.\n\nThe safeguard that matters most is the one that is absent. A provider who complies obtains a civil-immunity certificate for the acts done in accordance with the notice, so the person who builds the hole is shielded from liability for building it. A provider who refuses goes to the Federal Court for an order to comply. Certain decisions under the framework are expressly excluded from judicial review.\n\nWhat the Act does not do is equally precise. It does not create a general obligation to build a back door into any particular product, and it says the framework does not authorise a provider to do anything that would create a systemic weakness — wording that survived the 2018 debate only because the government accepted amendments in the Senate. Whether a capability notice can be drafted that defeats encryption without a systemic weakness is not a question this page can answer. It is the question the Act leaves open, which is the problem with an obligation whose safeguard lives in the drafting.\n\nThe numbers are the honest part. The Department of Home Affairs reports technical capability notices and technical assistance notices issued each year; the figures are small in count and are nonetheless the highest-power instrument in the Act. A handful of notices is not a small thing when the effect is permanent. Nothing in what has been published says a capability, once built, is ever unbuilt.",
    source: "Telecommunications and Other Legislation Amendment (Assistance and Access) Act 2018 (No. 148 of 2018) — Royal Assent 8 Dec 2018; Schedule 1 inserting new Part 15 of the Telecommunications Act 1997 (ss.317A–317ZH); s.317ZF (systemic weakness limitation) and the civil-immunity provisions; Department of Home Affairs, Annual Report 2019–20 and subsequent, reporting notices issued under the framework",
    tone: "blue" },

  { decade: 2020, year: "11 Dec 2024", title: "Proof of age to speak", tone: "peach",
    enacted: "Social Media Minimum Age Act 2024 — No. 127, 2024",
    power: "“A provider of an age-restricted social media platform must take reasonable steps to prevent age-restricted users having accounts with the age-restricted social media platform.”",
    img: "/images/timeline/2019-journalism.jpg",
    cap: "The Senate chamber, Parliament House, Canberra. Photograph by JJ Harrison, Wikimedia Commons, CC BY-SA 3.0 — licensed for reuse with attribution.",
    detail: "An age-restricted user is “an Australian child who has not reached 16 years”. To keep children out, platforms must work out who is an adult — and every Australian user becomes someone whose age has been established before they can hold the account they already hold. The Act received Royal Assent on 10 December 2024 and commenced on 11 December 2024, inserting Part 4A, sections 63A to 63DA, into the Online Safety Act 2021.\n\nThe obligation arrived with a deadline attached to a moving target: platforms were given until 10 December 2025 to have the systems in place. That deadline is the reason this entry is about machinery rather than principle. Age assurance, in practice, is a requirement to hand over evidence of who you are in a form a platform can check — a driver's licence, a passport, a face scan, a parental attestation. The Act does not mandate a particular method, and it does not require the platform to keep the evidence. It requires them to take “reasonable steps”.\n\nThe section that answers the obvious objection is section 63DA. The Minister may specify kinds of information that must NOT be collected for the purpose of complying, which is an acknowledgment inside the Act that the compliance method carries its own privacy cost. A provision permitting the Minister to forbid data collection is a provision that anticipates the natural consequence of the duty: the platform collects more identity data than it ever needed before.\n\nThe penalty is 30,000 penalty units, and the enforcement is against the provider, not the child. Australia was the first country to impose a minimum age in this form nationally. Whether other countries now follow is a question of fact that has yet to be answered; what the Act did was make the login page into an identity gate for every user in the country.",
    source: "Online Safety Amendment (Social Media Minimum Age) Act 2024 (No. 127 of 2024) — Royal Assent 10 Dec 2024, commenced 11 Dec 2024, inserting Part 4A (ss.63A–63DA) into the Online Safety Act 2021; s.63C (age-restricted user); s.63DA (Minister may specify information not to be collected); civil penalty maximum 30,000 penalty units; compliance deadline 10 Dec 2025",
    tone: "peach" },

  { decade: 2020, year: "25 Nov 2026", title: "The Digital Duty of Care", tone: "lavender",
    enacted: "Digital Duty of Care Bill 2026 — passed both Houses 25 Nov 2026",
    power: "“A person must not fail to comply with the person’s digital duty of care.” Civil penalty: 60,000 penalty units.",
    img: "/images/timeline/2024-duty-of-care.jpg",
    cap: "Parliament House, Canberra. Photograph by Kgbo, Wikimedia Commons, CC BY-SA 4.0 — licensed for reuse with attribution.",
    detail: "The Bill passed both Houses of the Commonwealth Parliament on 25 November 2026. It replaces Part 2 of the Online Safety Act 2021 and puts a positive duty — not a list of prohibited content, not a takedown register — at the centre of the Act.\n\nRead what it actually imposes. A service must ensure a safe online environment. That is not a rule about a post; it is a rule about a system. To meet it, providers must conduct risk assessments of their own features, and the Bill defines the features by name, because those are the ones that demonstrably drive harm: recommender systems, endless-feed behaviour, and the logged-in and time-limited designs that keep a session open past the point of intention. The duty attaches to the architecture, which is why it is a materially different kind of law from a notice power.\n\nIt also does something Parliament is usually reluctant to do: it carves out the inside of a conversation. Section 26B excludes private messages between consenting adults. That boundary is the acknowledgment that a duty to ensure safety, unbounded, would swallow encrypted and private speech; the drafters drew the line and wrote it down.\n\nThe compliance machinery is where the Bill earns its attention. The Commissioner may use a “sock puppet identity” — the Bill's words for “a false or fictitious identity” — to test whether a service is complying. Approved researchers may take platform data. A regulator testing a platform by deceiving it is an old enforcement technique and a new one for online safety. The civil penalty for failing the duty is 60,000 penalty units.\n\nSchedule 1 commences the day after Royal Assent, so at the time of writing the Bill is passed, not in force. It affects every provider that has Australian users, and it reaches an eleven-cardinality list of removal-notice sections whose penalties rise in the same Schedule. Those changes are the subject of the next card. What this card records is the shift in kind: from a regulator that responds to harm to a regulator that audits design, and is armed to find out.",
    source: "Online Safety Amendment (Digital Duty of Care) Bill 2026 — finally passed both Houses 25 Nov 2026 (APH bId r7553; Bills Digest bd2627/27bd026); ss.25–26C (duty and risk assessment), s.26B (private messages excluded), ss.205B–205K (sock puppet identity, researcher access); civil penalty 60,000 penalty units; Schedule 1 commences the day after Royal Assent",
    tone: "lavender" },

  // tw-2026-11-26-003: Schedule 1 item 77 of the Digital Duty of Care Bill
  // repeals the penalty in s.91 of the Online Safety Act 2021 — the section
  // that enforces a cyber-abuse removal notice — and substitutes "6,000
  // penalty units". Items 73–83 do the same to every other removal-notice
  // compliance section (67, 75, 80, 83, 91, 103, 111, 116, 121, 125, 129):
  // 500 units becomes 6,000. Schedule 1 commences the day AFTER Royal Assent,
  // so the card does not say "in force" — it says what the Bill does.
  // s.88(1)(d)/1(g): 48 hours for the platform to fail to act on the
  // complaint, then 24 hours to remove once the notice issues.
  // s.220(2)–(3): review at the ART by the provider or the posting end-user.
  { decade: 2020, year: "25 Nov 2026", title: "One complaint, two million dollars", tone: "sage",
    enacted: "Digital Duty of Care Bill 2026 — Schedule 1, item 77",
    power: "“77 Section 91 (penalty) — Repeal the penalty, substitute: Civil penalty: 6,000 penalty units.”",
    img: "/images/timeline/2023-whistleblower.jpg",
    cap: "The High Court of Australia, Canberra. Photograph by Bidgee, Wikimedia Commons, CC BY-SA 3.0 AU — licensed for reuse with attribution.",
    detail: "Section 91 is the section that makes a cyber-abuse removal notice enforceable. At 500 penalty units it was a maximum of $165,000. At 6,000 it is a maximum of $1,980,000 — and items 73 to 83 of Schedule 1 apply the same figure to every removal-notice compliance section in the Act, so the increase is not aimed at one kind of harm. It lands on the whole class of them.\n\nA penalty of two million dollars is only remarkable if the trigger is easy to pull. Read it in order. Material is complained about to the platform, and the platform does not remove it within 48 hours. The Commissioner may then give the provider a removal notice, requiring removal within 24 hours. There is no truth test anywhere in that sequence. The test is whether the material is something an ordinary reasonable person would regard as menacing, harassing or offensive — a standard of effect, not of falsity. A statement that is entirely true, and that a reasonable person finds offensive, meets it.\n\nThe review path is the part to sit with. Only the provider or the person who posted the material may ask the Administrative Review Tribunal to look at the decision (s.220). Not the reader. Not the person who was hurt. Not the public. The publisher of the material and the platform that hosts it are the only parties with standing to contest it, which means a notice can stand unreviewed precisely when nobody with standing wants to spend the money contesting it.\n\nSchedule 1 commences the day after Royal Assent. At the time of writing the Bill has passed both Houses and is not yet in force. When it is, the arithmetic changes from a figure that a platform absorbs to a figure that a platform cannot.",
    source: "Online Safety Amendment (Digital Duty of Care) Bill 2026, as passed both Houses 25 Nov 2026 — Schedule 1 Part 4 items 73–83, amending Online Safety Act 2021 ss.67, 75, 80, 83, 91, 103, 111, 116, 121, 125, 129 (items 84–85 raise ss.143 and 146 to 60,000 units); cf. ss.7, 88 (48-hour complaint window, 24-hour removal), 91, 220(2)–(3) (ART review, standing limited to provider or end-user)",
    tone: "sage" },

  // tw-2026-11-26-004: s.23 of the Classification Act 1995 lets a State,
  // Territory or local government make an "enforcement application" and
  // force the Board to classify any unclassified publication. The gateway
  // is the definition of "submittable publication" (s.5), which needs only
  // a depiction "unsuitable for a minor to see or read". No complaint,
  // no harm, no merits test. Sale/display offences then live in State law.
  { decade: 2020, year: "1995 → today", title: "A council can call your book in", tone: "peach",
    enacted: "Classification (Publications, Films and Computer Games) Act 1995 — s.23",
    power: "“A … government body may make an enforcement application to the Board for classification of a submittable publication.”",
    img: "/images/timeline/2022-classification.jpg",
    cap: "Parliament House, Brisbane. Photograph by Brian Dean, Wikimedia Commons, CC BY 2.0 — licensed for reuse with attribution.",
    detail: "Any unclassified book on any shelf is a candidate. The definition that makes it so is section 5, and it is written in three limbs. A “submittable publication” is a publication containing depictions or descriptions that are likely to cause it to be classified RC; or likely to cause offence to a reasonable adult; or unsuitable for a minor to see or read.\n\nLimb three is the hook, and it is deliberately the softest of the three. Nothing has to be harmful. Nothing has to be obscene. Nothing has to have been complained about. “Unsuitable for a minor to see or read” is a threshold that a great deal of serious adult literature crosses, and the test is applied to the publication as a whole rather than requiring harm to anyone.\n\nSection 23 then supplies the mechanism. A State, a Territory or a local government body may make an enforcement application to the Classification Board, and the Board must classify the title. Not may consider — classifies. A council does not need a ratepayer complaint, a police investigation or a court finding. It lodges the application and the Board does the work.\n\nThe consequence is where the Act stops being the whole story. Once a title is classified RC it cannot lawfully be sold or displayed, but the Act does not itself create the offence of selling it — it leaves enforcement to State and Territory law. The Commonwealth builds the gate; the States provide the lock. A book that was lawful on a Tuesday can be unlawful on a Wednesday, in one council area, because a body with no mandate over literature made an application.\n\nNo truth test. No literary merit. No public interest. Those phrases are the ones to keep, because the Act's structure is not an accident of drafting — the definitions are what they are, and they have sat there unchanged since 1995.",
    source: "Classification (Publications, Films and Computer Games) Act 1995 (Cth), s.5 (“submittable publication”, “enforcement application”), s.9A, s.23 (“Calling in submittable publications for classification”), s.13; compilation No. 40, registered 28 Aug 2017",
    tone: "peach" },

  // tw-2026-11-26-005: Tasmanian Police Offences Act 1935 s.49AB — a
  // demonstration on a public street needs a permit from a police officer.
  // Limb (4)(c) is open-ended and the Act gives no review of a refusal.
  { decade: 1930, year: "1935 → today", title: "Permission to stand on the footpath", tone: "rose",
    enacted: "Police Offences Act 1935 (Tas) — s.49AB, inserted by No. 104 of 2001",
    power: "“A person must not organise or conduct any of the following activities without a permit if it is to be held, wholly or partly, on a public street: (a) a demonstration; (b) a fundraising drive; (c) a procession.”",
    img: "/images/timeline/2021-tasmania-streets.jpg",
    cap: "Parliament House, Hobart. Photograph by Sweaterandtie, Wikimedia Commons, CC0 (public domain dedication) — free to reuse without attribution.",
    detail: "The statute lists a demonstration beside a fundraising drive and a road cycle race, and treats all three as an activity that requires permission before it can happen on a public street. The section was inserted by Act No. 104 of 2001 and has applied since 1 January 2002.\n\nA senior police officer decides. The considerations set out in the Act are the safety and convenience of the public, the safety of the participants, and “such other considerations as appear relevant” — an open discretion with no stated test, no requirement to give reasons, and no requirement that the refusal relate to public safety at all.\n\nThe permit itself is rigid in a way that matters. It “is not capable of being amended, renewed or transferred”, so an event that needs to shift by a day or move fifty metres needs a new permit. And the Act contains no right of review or appeal against a refusal: a person refused has no statutory route to have the decision examined. Breach of the permit requirement carries a fine not exceeding 10 penalty units.\n\nTasmania is not alone in this. Every State and Territory has a version, from New South Wales's notices for authorised assemblies to Queensland's notice scheme for peaceful assemblies. What the comparison shows is a shared structure: the right to gather in public is exercised by permission, the permission is granted by the police, and the terms on which it is refused are set by the police as well.\n\nA demonstration on a footpath is an old, cheap and effective way to be heard, which is exactly why the permission requirement matters. A right that needs a permit is a right that can be refused, and a refusal that need not be explained cannot be argued with.",
    source: "Police Offences Act 1935 (Tas), s.49AB (“Public street permits”), inserted by No. 104 of 2001, applied 1 Jan 2002; subsections (1), (2), (4), (5), (7), (8); penalty as amended — fine not exceeding 10 penalty units",
    tone: "rose" },

  // tw-2026-11-26-007 — Queensland, Traffic Act 1949 amended September 1977.
  // Anchor: ANU Press, "The Ayes Have It: The history of the Queensland
  // Parliament 1957–1989", ch.11 p.391, quoting Record of Legislative Acts 1977, p.11.
  { decade: 1970, year: "September 1977", title: "Twenty-four hours to change the law on marching", tone: "sky",
    enacted: "Traffic Act 1949 (Qld), amended September 1977",
    power: "“The Traffic Act was amended in September 1977 with the intention of eliminating demonstrations or protest marches on streets and thoroughfares.”",
    img: "/images/timeline/1977-queensland.jpg",
    cap: "Parliament House, Brisbane, photographed in 1894 — the building in which the amendment was passed in a single day. Queensland State Archives, public domain.",
    detail: "The amendment was rushed through the Parliament in one day, after Standing Orders were suspended so that all three readings of the bill could be heard in sequence. The government's own record of it states the purpose without euphemism: to eliminate demonstrations and protest marches on streets and thoroughfares.\n\nOnce it passed, a demonstration or protest march on a street or thoroughfare required a permit from the District Superintendent of Traffic. If a permit was refused, the organisers could appeal — but only to the Police Commissioner, and not to a local magistrate. The appeal therefore went to the head of the same force that had refused it, which is a structure, not a safeguard.\n\nThe stated justification, in the Record of Legislative Acts 1977, was to protect the rights of people who wished to travel on the roads so that they could go about their business in an unfettered way. That is a real interest and it is the interest every such law invokes. What the parliamentary history records is what happened next: the street-marches legislation arguably had the opposite effect to that intended, becoming a cause célèbre and an incentive to demonstrate against such restrictions on civil liberties.\n\nThat is the finding worth keeping. A law built in a day to make protest harder made protest larger, because the law itself became the thing worth protesting. The Queensland episode is documented in the Parliament's own published history, which is what makes it usable here — it is not an accusation from outside, it is the record of the institution that passed the amendment seventeen years before this family record is written.\n\nOne day, three readings, Standing Orders suspended. The speed is the detail that tells you what the government thought was at stake.",
    source: "Traffic Act 1949 (Qld), September 1977 amendment — quoted in D. B. Waterson & John Arnold, “The Ayes Have It: The History of the Queensland Parliament 1957–1989” (ANU Press), ch. 11, p. 391, quoting “Record of Legislative Acts 1977”, p. 11",
    tone: "sky" },

  // tw-2026-11-26-008 — internet kill switch: shutdowns that never name a reason.
  { decade: 2010, year: "2018 → today", title: "The switch that needs no reason", tone: "lavender",
    enacted: "Telecommunications Act 1997 (Cth) — Part 9AA (inserted by the Assistance and Access Act 2018, No. 148)",
    power: "The Minister may give a direction to a carriage service provider to do, or refrain from doing, a specified thing to “prevent … a communication that is … being … carried” — and the direction itself is not a legislative instrument.",
    img: "/images/timeline/2020-boyle.jpg",
    cap: "Civic, Canberra — the precinct in which the agencies that may seek a direction are headquartered. Photograph by Nick-D, Wikimedia Commons, CC BY-SA 4.0 — licensed for reuse with attribution.",
    detail: "Part 9AA of the Telecommunications Act 1997 was inserted by the Assistance and Access Act 2018 (No. 148). It lets the Minister, by written direction, order a carriage service provider to stop carrying communications — a telephone or internet switch — where the Minister is satisfied the direction is reasonably necessary for a national-security or law-enforcement purpose.\n\nThe word that matters is “satisfied”. The Minister's satisfaction is the trigger, and the Act does not require anyone outside the Minister's office to be persuaded of it. There is no court, no tribunal and no committee whose agreement is a precondition.\n\nThen the direction is made silent. It may prohibit disclosure of its existence — the provider may be forbidden to tell anyone, including the users whose service has stopped. Decisions under the Part are excluded from judicial review, so the ordinary grounds on which an administrative decision can be challenged in court do not apply. And the direction is expressly “not a legislative instrument”, which sounds technical and is not: it means the direction is never tabled, never published and never debated, and it cannot be disallowed by the Parliament.\n\nCompare how any other rule is made in this country. A law is printed, it is debated, it is subject to disallowance, and a citizen can read it and argue with it. A written direction reaches a telco, silently, and takes effect. The two paths are laid side by side in the same Act and produce opposite degrees of visibility.\n\nThis is the card in this timeline that is hardest to verify from the outside, because the instrument is designed not to be seen. What can be verified is the power: the Part exists, the support for it is the Minister's satisfaction, the review is excluded, and the existence of a direction need not be disclosed. That is the switch, and it needs no reason that anyone outside can inspect.",
    source: "Telecommunications Act 1997 (Cth), Part 9AA (ss.317A–317ZH of the Act as inserted); inserted by Telecommunications and Other Legislation Amendment (Assistance and Access) Act 2018 (No. 148 of 2018); cf. Part 9AA provisions on non-disclosure, exclusion of judicial review, and declaration that a direction is not a legislative instrument",
    tone: "lavender" },
  // tw-2026-11-26-009 — COVID-19, 2020–22. Five separate claims, five separate
  // evidence shelves. Only three survive as FACT here. The harm claim does not:
  // the evidence gathered contradicts it, so it is recorded as a claim that
  // could not be verified — per "nothing goes in the vault but isn't true".
  //   1. Churches shut: National Cabinet ban on non-essential indoor gatherings
  //      of 100+, announced 22 March 2020, in force 23 March 2020; places of
  //      worship named. PM's own transcript = primary source.
  //   2. Speaking out: Zoe Buhler arrested at Ballarat 2 Sep 2020 over a
