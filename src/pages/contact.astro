---
import BaseLayout from "../layouts/BaseLayout.astro";

const contactEmail = "contact@telferwiki.com";
const mailtoHref = `mailto:${contactEmail}?subject=${encodeURIComponent("Telfer Wiki contact message")}`;
---

<BaseLayout title="Contact" description="Get in touch with the people behind the Telfer Family Wiki — corrections, questions, photos, or family stories welcome." canonicalPath="/contact">
  <main class="max-w-3xl mx-auto px-4 py-8">
    <article class="prose prose-lg dark:prose-invert max-w-none">
      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-[var(--color-heading)] mb-2">Contact</h1>
      <p class="text-sm text-[var(--color-muted)] mb-8">Questions, corrections, photos, or stories — we'd love to hear from you</p>

      <div class="mb-8 bg-[var(--color-card-bg)] border-2 border-[var(--color-highlight)] rounded-xl p-5 text-center">
        <p class="text-sm font-semibold text-[var(--color-heading)] mb-1">Email us directly at</p>
        <a href={mailtoHref} class="inline-block text-2xl sm:text-3xl font-serif font-bold text-[var(--color-link)] hover:text-[var(--color-link-hover)] no-underline break-all">
          {contactEmail}
        </a>
        <p class="text-sm text-[var(--color-muted)] mt-2">Tap the address above to open an email — or use the form below.</p>
      </div>

      <section class="mb-10">
        <h2 class="font-serif text-2xl font-semibold text-[var(--color-heading)]">Get in Touch</h2>
        <p>
          The Telfer Wiki is a living family history archive. If you spot a mistake, have a photo or story to
          share, or want to add a family member who isn't here yet — we want to know. Every contribution
          helps make the record more complete for everyone.
        </p>
        <p>
          The best way to reach us is by email at{' '}
          <a href={mailtoHref}><strong>{contactEmail}</strong></a>. You can use the form below, or write to us
          directly — whichever is easier for you.
        </p>
      </section>

      <section class="mb-10">
        <h2 class="font-serif text-2xl font-semibold text-[var(--color-heading)]">Send a Message</h2>
        <p class="text-sm text-[var(--color-muted)] mb-4">
          This form opens your email app with your message ready to send to {contactEmail}.
        </p>

        <form
          action={mailtoHref}
          method="get"
          enctype="text/plain"
          class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-xl p-5 sm:p-6 space-y-4"
        >
          <div>
            <label for="contact-name" class="block text-sm font-semibold text-[var(--color-heading)] mb-1">Your name</label>
            <input
              type="text"
              id="contact-name"
              name="name"
              required
              placeholder="Your full name"
              class="w-full px-3 py-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-input-bg)] text-[var(--color-ink)] placeholder:text-[var(--color-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--color-highlight)]"
            />
          </div>

          <div>
            <label for="contact-email" class="block text-sm font-semibold text-[var(--color-heading)] mb-1">Your email</label>
            <input
              type="email"
              id="contact-email"
              name="email"
              required
              placeholder="you@example.com"
              class="w-full px-3 py-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-input-bg)] text-[var(--color-ink)] placeholder:text-[var(--color-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--color-highlight)]"
            />
          </div>

          <div>
            <label for="contact-message" class="block text-sm font-semibold text-[var(--color-heading)] mb-1">Your message</label>
            <textarea
              id="contact-message"
              name="message"
              rows="5"
              required
              placeholder="What would you like to tell us?"
              class="w-full px-3 py-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-input-bg)] text-[var(--color-ink)] placeholder:text-[var(--color-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--color-highlight)]"
            ></textarea>
          </div>

          <button
            type="submit"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg font-semibold text-white bg-[var(--color-heading)] hover:bg-[var(--color-heading-hover)] transition-colors"
          >
            Send Message
          </button>
        </form>
      </section>

      <section class="mb-10">
        <h2 class="font-serif text-2xl font-semibold text-[var(--color-heading)]">Before You Write</h2>
        <ul class="space-y-2">
          <li><strong>Corrections</strong> — tell us which person's page and what to fix; we'll verify and update it.</li>
          <li><strong>Photos</strong> — please note who is in the photo and (if known) where and when it was taken.</li>
          <li><strong>Stories &amp; family lore</strong> — these are precious; share as much as you can. Names, dates, places help us place it correctly.</li>
          <li><strong>Living relatives</strong> — we keep living members' private details off the site by default; if you'd like your own information changed or removed, just ask.</li>
        </ul>
        <p class="text-sm text-[var(--color-muted)] mt-4">
          We read every message. Because the archive is a volunteer project, replies may take a few days.
        </p>
      </section>
    </article>
  </main>
</BaseLayout>
