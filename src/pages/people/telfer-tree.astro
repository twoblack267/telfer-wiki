---
// TelferTree.astro — Telfer Family Tree views (Surname-only + Full)
// Feature-flagged: set TELFER_TREE_ENABLED=true in env to show
import BaseLayout from "../../layouts/BaseLayout.astro";

const people = (await import("../../data/people.public.json")).default;
const allPeople = people; // Full dataset for full tree

// Feature flag — default OFF
const TREE_ENABLED = import.meta.env.TELFER_TREE_ENABLED === "true";

// Helper: find person by ID (handles various formats)
function findPerson(id: string | undefined, dataset = allPeople) {
  if (!id) return undefined;
  // Try exact match on id, display_name, or slug first
  let person = dataset.find((p) =>
    p.id === id || p.display_name === id || p.slug === id
  );
  // Fallback: loosely match display_name (e.g. "Francis Charles Telfer" vs "Francis Charles Telfer (1875–1954)")
  if (!person) {
    const nameOnly = id.replace(/\s*\([^)]+\)\s*$/, "").trim();
    person = dataset.find((p) => p.display_name === nameOnly);
  }
  return person;
}

// Build tree from Francis Charles Telfer (1875–1954) — the "Charles" of Charles & Sons
const FRANCIS_ID = "Francis Charles Telfer (1875–1954)";
const francis = findPerson(FRANCIS_ID);

// Known children of Francis Charles Telfer (from his biography) — some lack wiki entries yet
const KNOWN_CHILDREN: Record<
  string,
  { name: string; birth: number; death?: number; hasProfile: boolean }
> = {
  "Francis Kelson Telfer": {
    name: "Francis Kelson Telfer",
    birth: 1910,
    death: 1987,
    hasProfile: false,
  },
  "Edwin Roy Telfer": { name: "Edwin Roy Telfer", birth: 1915, hasProfile: false },
  "Reginald Masters Telfer": {
    name: "Reginald Masters Telfer",
    birth: 1920,
    hasProfile: false,
  },
  "Ruth Telfer": { name: "Ruth Telfer", birth: 1930, hasProfile: true },
  "Malcolm George Telfer": {
    name: "Malcolm George Telfer",
    birth: 1933,
    hasProfile: false,
  },
  "Murray John Telfer": {
    name: "Murray John Telfer",
    birth: 1924,
    death: 2009,
    hasProfile: true,
  },
};

function getAllChildren(person, dataset = allPeople) {
  if (!person?.children) return [];
  const wikiChildren = person.children
    .map((c) => findPerson(c, dataset))
    .filter((c) => c)
    .sort((a, b) => (a.birth_year || 9999) - (b.birth_year || 9999));

  // Add known children ONLY for Francis Charles Telfer (the patriarch)
  const isFrancis =
    person.slug === "francis-charles-telfer" ||
    person.display_name === "Francis Charles Telfer";
  if (isFrancis) {
    const knownNames = new Set(wikiChildren.map((c) => c.display_name));
    const placeholderChildren = Object.values(KNOWN_CHILDREN)
      .filter((kc) => !knownNames.has(kc.name) && kc.hasProfile === false)
      .map((kc) => ({
        display_name: kc.name,
        birth_year: kc.birth,
        death_year: kc.death,
        death_year_display: kc.death?.toString(),
        is_living: !kc.death,
        last_name: "Telfer",
        slug: kc.name.toLowerCase().replace(/\s+/g, "-"),
        children: undefined,
        spouses: undefined,
      }));
    return [...wikiChildren, ...placeholderChildren].sort(
      (a, b) => (a.birth_year || 9999) - (b.birth_year || 9999)
    );
  }

  return wikiChildren;
}

function getSpouse(person, dataset = allPeople) {
  if (!person?.spouses) return null;
  const spouseId = person.spouses[0];
  return findPerson(spouseId, dataset);
}

// ============================================================
// VIEW 1: SURNAME-ONLY (Charles & Sons) — Telfer line only
// ============================================================
function shouldRecurseSurname(person) {
  return person.last_name?.toLowerCase() === "telfer";
}

function renderSurnameTree(person, depth = 0) {
  if (!person) return "";
  const spouse = getSpouse(person);
  const allChildren = getAllChildren(person);
  const childrenToRecurse = allChildren.filter(shouldRecurseSurname);
  const childrenToShowOnly = allChildren.filter((c) => !shouldRecurseSurname(c));

  const indent = "  ".repeat(depth);
  const lifespan = `${person.birth_year || "?"}–${
    person.death_year ?? (person.is_living ? "living" : "?")
  }`;
  const livingBadge = person.is_living
    ? " <span class=\"text-xs text-green-600\">(living)</span>"
    : "";
  const spouseName = spouse
    ? ` + ${spouse.display_name} (${spouse.birth_year || "?"}–${
        spouse.death_year ?? (spouse.is_living ? "living" : "?")
      })`
    : "";
  const surnameLabel =
    person.last_name?.toLowerCase() !== "telfer"
      ? ` <span class="text-xs text-[var(--color-muted)]">[${person.last_name}]</span>`
      : "";

  let html = `
${indent}<details class="tree-node" open>
${indent}  <summary class="cursor-pointer select-none flex items-center gap-2">
${indent}    <span class="font-mono text-[var(--color-heading)]">${
    "│  ".repeat(depth)
  }├─</span>
${indent}    <strong>${person.display_name}</strong>
${indent}    <span class="text-xs text-[var(--color-muted)]">(${lifespan})</span>${livingBadge}${spouseName}${surnameLabel}
${indent}  </summary>
${indent}  <div class="ml-6 mt-1 border-l border-[var(--color-border)] pl-3">`;

  // First: children who continue the Telfer line (recurse)
  for (const child of childrenToRecurse) {
    html += renderSurnameTree(child, depth + 1);
  }

  // Then: married daughters (show but don't recurse)
  for (const child of childrenToShowOnly) {
    const childSpouse = getSpouse(child);
    const childLifespan = `${child.birth_year || "?"}–${
      child.death_year ?? (child.is_living ? "living" : "?")
    }`;
    const childLivingBadge = child.is_living
      ? " <span class=\"text-xs text-green-600\">(living)</span>"
      : "";
    const childSpouseName = childSpouse
      ? ` + ${childSpouse.display_name} (${childSpouse.birth_year || "?"}–${
          childSpouse.death_year ?? (childSpouse.is_living ? "living" : "?")
        })`
      : "";
    const childSurnameLabel = ` <span class="text-xs text-[var(--color-muted)]">[${child.last_name}]</span>`;

    html += `
${indent}    <div class="tree-leaf" style="margin-top: 0.25rem;">
${indent}      <span class="font-mono text-[var(--color-heading)]">${
      "│  ".repeat(depth + 1)
    }├─</span>
${indent}      <strong>${child.display_name}</strong>
${indent}      <span class="text-xs text-[var(--color-muted)]">(${childLifespan})</span>${childLivingBadge}${childSpouseName}${childSurnameLabel}
${indent}      <span class="text-xs text-[var(--color-muted)] ml-8">→ line ends (married name)</span>
${indent}    </div>`;
  }

  html += `
${indent}  </div>
${indent}</details>`;
  return html;
}

// ============================================================
// VIEW 2: FULL FAMILY TREE — Every descendant, every line
// ============================================================
function renderFullTree(person, depth = 0) {
  if (!person) return "";
  const spouse = getSpouse(person);
  const allChildren = getAllChildren(person);

  const indent = "  ".repeat(depth);
  const lifespan = `${person.birth_year || "?"}–${
    person.death_year ?? (person.is_living ? "living" : "?")
  }`;
  const livingBadge = person.is_living
    ? " <span class=\"text-xs text-green-600\">(living)</span>"
    : "";
  const spouseName = spouse
    ? ` + ${spouse.display_name} (${spouse.birth_year || "?"}–${
        spouse.death_year ?? (spouse.is_living ? "living" : "?")
      })`
    : "";
  const surnameLabel =
    person.last_name?.toLowerCase() !== "telfer"
      ? ` <span class="text-xs text-[var(--color-muted)]">[${person.last_name}]</span>`
      : "";

  let html = `
${indent}<details class="tree-node" open>
${indent}  <summary class="cursor-pointer select-none flex items-center gap-2">
${indent}    <span class="font-mono text-[var(--color-heading)]">${
    "│  ".repeat(depth)
  }├─</span>
${indent}    <strong>${person.display_name}</strong>
${indent}    <span class="text-xs text-[var(--color-muted)]">(${lifespan})</span>${livingBadge}${spouseName}${surnameLabel}
${indent}  </summary>
${indent}  <div class="ml-6 mt-1 border-l border-[var(--color-border)] pl-3">`;

  // ALL children — recurse into every single one
  for (const child of allChildren) {
    html += renderFullTree(child, depth + 1);
  }

  html += `
${indent}  </div>
${indent}</details>`;
  return html;
}

// Generate both trees
const surnameTreeHtml = francis
  ? renderSurnameTree(francis)
  : "<p>Francis Charles Telfer not found</p>";
const fullTreeHtml = francis
  ? renderFullTree(francis)
  : "<p>Francis Charles Telfer not found</p>";

const pageTitle = "Telfer Family Tree";
---

<BaseLayout title={pageTitle}>
  <div class="max-w-6xl mx-auto p-4">
    <!-- Tab Navigation -->
    <nav class="mb-4 border-b border-[var(--color-border)]" aria-label="Tree views">
      <ul class="flex gap-1" role="tablist">
        <li role="presentation">
          <a
            href="/people"
            class="px-4 py-2 rounded-t-lg border-b-2 border-[var(--color-link)] text-[var(--color-link)] font-medium"
            role="tab"
            aria-selected="false"
          >
            Pedigree (Direct Line)
          </a>
        </li>
        <li role="presentation">
          <a
            href="/people/telfer-tree?view=surname"
            class="px-4 py-2 rounded-t-lg border-b-2 border-transparent text-[var(--color-muted)] hover:text-[var(--color-heading)] font-medium"
            role="tab"
            aria-selected="true"
          >
            Family Tree (Charles & Sons)
          </a>
        </li>
        <li role="presentation">
          <a
            href="/people/telfer-tree?view=full"
            class="px-4 py-2 rounded-t-lg border-b-2 border-transparent text-[var(--color-muted)] hover:text-[var(--color-heading)] font-medium"
            role="tab"
            aria-selected="false"
          >
            Full Family Tree
          </a>
        </li>
      </ul>
    </nav>

    <h1 class="font-serif text-2xl md:text-3xl text-[var(--color-heading)] mb-2">
      Telfer Family Tree — Charles & Sons Descendants
    </h1>

    <!-- Surname-only view (default) -->
    <div id="view-surname" class="tree-view">
      <p class="text-[var(--color-muted)] mb-6">
        Descendant chart from <strong>Francis Charles Telfer (1875–1954)</strong> — Telfer-surname line
        only. Wives shown; daughters' married lines excluded. Click triangles to expand/collapse.
      </p>
      <div class="person-card rounded-xl p-4 prose prose-sm max-w-none" style="font-size: 0.875rem;">
        <div class="tree-container" set:html={surnameTreeHtml} />
      </div>
    </div>

    <!-- Full family tree view -->
    <div id="view-full" class="tree-view hidden">
      <p class="text-[var(--color-muted)] mb-6">
        Complete descendant chart from <strong>Francis Charles Telfer (1875–1954)</strong> &amp;
        <strong>Amy Ellen Telfer (1884–1951)</strong> — <strong>every child, every spouse, every line</strong>.
        All daughters, their husbands, their children, grandchildren, great-grandchildren. Click triangles to
        expand/collapse.
      </p>
      <div class="person-card rounded-xl p-4 prose prose-sm max-w-none" style="font-size: 0.875rem;">
        <div class="tree-container" set:html={fullTreeHtml} />
      </div>
    </div>

    <style>
      .tree-node summary {
        line-height: 1.6;
        transition: color 0.15s;
      }
      .tree-node summary:hover {
        color: var(--color-link);
      }
      .tree-node summary::marker {
        content: "";
      }
      .tree-node summary:focus {
        outline: 2px solid var(--color-link);
        outline-offset: 2px;
        border-radius: 2px;
      }
      .tree-node[open] > summary {
        color: var(--color-heading);
      }
      .tree-container {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        line-height: 1.7;
      }
      .tree-view:not(.hidden) {
        display: block;
      }
    </style>

    <script>
      // Simple URL-based view switching
      const params = new URLSearchParams(window.location.search);
      const view = params.get('view') || 'surname';
      document.getElementById('view-surname').classList.toggle('hidden', view !== 'surname');
      document.getElementById('view-full').classList.toggle('hidden', view !== 'full');

      // Update tab active states
      const tabs = document.querySelectorAll('[role="tab"]');
      tabs.forEach(tab => {
        const href = tab.getAttribute('href') || '';
        const isActive = href.includes(view);
        tab.classList.toggle('border-transparent', !isActive);
        tab.classList.toggle('text-[var(--color-muted)]', !isActive);
        tab.classList.toggle('border-[var(--color-link)]', isActive);
        tab.classList.toggle('text-[var(--color-link)]', isActive);
        tab.setAttribute('aria-selected', isActive.toString());
      });
    </script>
  </div>
</BaseLayout>