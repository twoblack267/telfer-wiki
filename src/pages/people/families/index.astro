---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import type { PersonData } from "../../../utils/extract-data.mjs";

const people = (await import("../../../data/people.public.json")).default as PersonData[];
const telferPeople = people.filter((p) => (p.branch === "telfer" || !p.branch) && p.id);

// tw-2026-09-14-019: birth_year may be an APPROXIMATE string ("~1892"), not a
// number. Passing the raw value into Math.floor(year/10)*10 and Math.min/max
// produced NaN ("NaNs" generation buckets, an empty "Year Span" tile, and
// "Unknown" ordering collapse). Parse the first 3-4 digit run; return null when
// there is no usable year so callers can bucket it explicitly.
function parseBirthYear(value: unknown): number | null {
  if (typeof value === "number" && Number.isFinite(value)) return value;
  if (typeof value !== "string") return null;
  const match = value.match(/-?\d{3,4}/);
  if (!match) return null;
  const parsed = Number.parseInt(match[0], 10);
  return Number.isFinite(parsed) ? parsed : null;
}

// Get unique birth decades for generation grouping
const generations: Record<string, PersonData[]> = {};
for (const p of telferPeople) {
  const year = parseBirthYear(p.birth_year);
  let decade: string;
  if (year === null) {
    decade = "Unknown";
  } else if (year < 1800) {
    decade = "Before 1800";
  } else {
    const decadeStart = Math.floor(year / 10) * 10;
    decade = `${decadeStart}s`;
  }
  if (!generations[decade]) generations[decade] = [];
  generations[decade].push(p);
}

// Sort generations chronologically
const decadeOrder = ["Before 1800", "1760s", "1770s", "1780s", "1790s", "1800s", "1810s", "1820s", "1830s", "1840s", "1850s", "1860s", "1870s", "1880s", "1890s", "1900s", "1910s", "1920s", "1930s", "1940s", "1950s", "1960s", "1970s", "1980s", "1990s", "2000s", "2010s", "2020s", "Unknown"];
const sortedGenerations = Object.entries(generations)
  .sort((a, b) => {
    const ia = decadeOrder.indexOf(a[0]);
    const ib = decadeOrder.indexOf(b[0]);
    if (ia !== -1 && ib !== -1) return ia - ib;
    if (ia !== -1) return -1;
    if (ib !== -1) return 1;
    return a[0].localeCompare(b[0]);
  })
  .map(([decade, members]) => [
    decade,
    members.sort(
      (a, b) =>
        (parseBirthYear(a.birth_year) ?? 9999) - (parseBirthYear(b.birth_year) ?? 9999),
    ),
  ]);

const years = telferPeople
  .map((p) => parseBirthYear(p.birth_year))
  .filter((y): y is number => y !== null && Number.isFinite(y));
const minYear = years.length ? Math.min(...years) : null;
const maxYear = years.length ? Math.max(...years) : null;
const yearSpan = minYear !== null && maxYear !== null ? `${minYear}–${maxYear}` : "Unknown";
const livingCount = telferPeople.filter(p => p.is_living).length;
const deceasedCount = telferPeople.length - livingCount;
const surnameCounts: Record<string, number> = {};
for (const p of telferPeople) {
  const name = p.last_name || "Unknown";
  surnameCounts[name] = (surnameCounts[name] || 0) + 1;
}
const otherSurnames = Object.entries(surnameCounts)
  .filter(([name]) => name !== "Telfer")
  .sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="The Telfer Family">
  <div class="page-header">
    <h1>The Telfer Family</h1>
    <p class="text-[var(--color-ink-light)] mt-2">
      {telferPeople.length} profiles · {minYear}–{maxYear}
      &nbsp;·&nbsp; <span class="text-green-500">{livingCount} living</span>
      &nbsp;·&nbsp; <span class="text-[var(--color-burgundy)]">{deceasedCount} deceased</span>
    </p>
    <p class="text-sm text-[var(--color-muted)] mt-1 italic">
      The Telfer family line from Scotland to Australia — direct descendants, spouses, and the families they married into.
      All {telferPeople.length} profiles are part of a single family story.
    </p>
  </div>

  <!-- Quick stats -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 mb-8">
    <div class="person-card rounded-xl p-4 text-center">
      <div class="text-2xl font-bold font-serif text-[var(--color-gold)]">{telferPeople.length}</div>
      <div class="text-xs text-[var(--color-muted)] mt-1">Total Profiles</div>
    </div>
    <div class="person-card rounded-xl p-4 text-center">
      <div class="text-2xl font-bold font-serif text-[var(--color-burgundy)]">{Object.keys(surnameCounts).length}</div>
      <div class="text-xs text-[var(--color-muted)] mt-1">Surname Groups</div>
    </div>
    <div class="person-card rounded-xl p-4 text-center">
      <div class="text-2xl font-bold font-serif text-green-500">{livingCount}</div>
      <div class="text-xs text-[var(--color-muted)] mt-1">Living</div>
    </div>
    <div class="person-card rounded-xl p-4 text-center">
      <div class="text-2xl font-bold font-serif text-[var(--color-burgundy)]">{yearSpan}</div>
      <div class="text-xs text-[var(--color-muted)] mt-1">Year Span</div>
    </div>
  </div>

  <!-- Allied families note -->
  {otherSurnames.length > 0 && (
    <div class="person-card rounded-xl p-4 mb-8">
      <h2 class="font-serif text-lg text-[var(--color-burgundy)] mb-2">Surnames That Married In</h2>
      <p class="text-sm text-[var(--color-ink-light)] mb-3">
        These non-Telfer surnames joined the family line through marriage:
      </p>
      <div class="flex flex-wrap gap-2">
        {otherSurnames.map(([name, count]) => (
          <span class="text-xs px-3 py-1 rounded-full border border-[var(--color-border)] text-[var(--color-ink-light)]">
            {name} <span class="text-[var(--color-gold)]">({count})</span>
          </span>
        ))}
      </div>
    </div>
  )}

  <!-- Generations -->
  {sortedGenerations.map(([decade, members]) => (
    <div class="mb-8">
      <h2 class="font-serif text-xl text-[var(--color-burgundy)] mb-3 border-b border-[var(--color-border)] pb-2">
        {decade}
        <span class="text-sm text-[var(--color-muted)] font-normal ml-2">({members.length} {members.length === 1 ? "profile" : "profiles"})</span>
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {members.map((p) => (
          <a
            href={`${import.meta.env.BASE_URL}people/${p.slug}`}
            class="person-card rounded-xl p-3 no-underline block hover:border-[var(--color-gold)] transition-all"
          >
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-[var(--color-burgundy)] text-white flex items-center justify-center text-sm font-serif font-bold shrink-0">
                {p.first_name?.[0]}{p.last_name?.[0]}
              </div>
              <div class="min-w-0">
                <div class="text-sm font-medium text-[var(--color-ink)] truncate">{p.display_name}</div>
                <div class="text-xs text-[var(--color-muted)]">
                  {p.lifespan}
                  {p.last_name !== "Telfer" && (
                    <span class="ml-1">· {p.last_name}</span>
                  )}
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  ))}
</BaseLayout>
