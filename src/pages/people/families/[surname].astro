---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import type { PersonData } from "../../../utils/extract-data.mjs";
import { stripWikiLinks } from "../../../utils/format-body.mjs";

export async function getStaticPaths() {
  const people = (await import("../../../data/people.public.json")).default as PersonData[];
  const telferPeople = people.filter((p) => p.branch === "telfer" || !p.branch);

  // Group by surname
  const families: Record<string, PersonData[]> = {};
  for (const p of telferPeople) {
    const name = p.last_name || "Unknown";
    if (!families[name]) families[name] = [];
    families[name].push(p);
  }

  return Object.entries(families).map(([surname, members]) => ({
    params: { surname: surname.toLowerCase() },
    props: { surname, members },
  }));
}

const { surname, members } = Astro.props;
const allPeople = (await import("../../../data/people.public.json")).default as PersonData[];

// Sort members by birth year
members.sort((a, b) => {
  const aYear = a.birth_year || 9999;
  const bYear = b.birth_year || 9999;
  if (aYear !== bYear) return aYear - bYear;
  return a.display_name.localeCompare(b.display_name);
});

const deceased = members.filter((p) => p.is_deceased);
// 2026-11-03: people with NEITHER birth nor death year are pulled out of the
// alphabetical list and given their own "Help Us Complete the Record" block at
// the bottom, so the main list stays a clean directory of dated lives.
const undatedMembers = members.filter((p) => !p.birth_year && !p.death_year);
const datedMembers = members.filter((p) => p.birth_year || p.death_year);
members.length = 0;
members.push(...datedMembers);
const noDeathRecord = members.filter((p) => !p.is_deceased);

// Find generations covered
// tw-2026-10-27-007: this range must describe LIVES, not just birth years.
// Deriving both ends from birth_year printed "spanning 1865–1865" for Charles
// Farrow Jr, who was born 1865 and died 1936 — reading to a visitor as a child
// who died at birth, while the very same page's member card said 1865–1936.
const birthYears = members.filter((p) => p.birth_year).map((p) => p.birth_year as number);
const deathYears = members.filter((p) => p.death_year).map((p) => p.death_year as number);
const oldest = birthYears.length > 0 ? Math.min(...birthYears) : null;
const latestBirth = birthYears.length > 0 ? Math.max(...birthYears) : null;
const youngest = latestBirth === null
  ? null
  : (deathYears.length > 0 ? Math.max(latestBirth, ...deathYears) : latestBirth);

// A "span" of X–X asserts a life that began and ended in one year. Only print it
// when that is genuinely true (a real infant death), otherwise omit the range
// rather than publish a fake lifespan.
const span =
  oldest !== null && youngest !== null && !(oldest === youngest && !deathYears.includes(oldest))
    ? `${oldest}–${youngest}`
    : null;

// A–Z jump links for long family lists (tw-2026-11-03). Only show the bar when
// the family is long enough to need it — a 3-person list does not.
const letters = [
  ...new Set(members.map((p) => (p.display_name || "?")[0].toUpperCase()).filter((c) => /[A-Z]/.test(c))),
].sort();
const showJump = members.length >= 12 && letters.length > 2;

// Gather unique roles (if available)
const roles = [...new Set(members.flatMap((p) => p.roles || []))].sort();

// Gather unique tags (excluding generic)
const tags = [...new Set(members.flatMap((p) => (p.tags || []).filter((t) => !["bio", "family", "person"].includes(t))))].sort();
---

<BaseLayout
  title={`${surname} Family`}
  description={`The ${surname} family in the Telfer line — ${members.length} profile${members.length !== 1 ? "s" : ""}${span ? ` spanning ${span}` : ""}, including ${deceased.length} with a recorded death and ${noDeathRecord.length} awaiting dates. Part of the Telfer Family Wiki, tracing nine generations from Scotland to South Australia.`}
>
  <div class="max-w-4xl mx-auto">
    <!-- Breadcrumb -->
    <div class="text-sm text-[var(--color-muted)] mb-4">
      <a href={import.meta.env.BASE_URL + "people/"} class="text-[var(--color-link)]">People</a>
      <span class="mx-2">/</span>
      <a href={import.meta.env.BASE_URL + "people/families/"} class="text-[var(--color-link)]">Families</a>
      <span class="mx-2">/</span>
      <span>{surname}</span>
    </div>

    <!-- Header -->
    <div class="person-card rounded-xl p-6 md:p-8 mb-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h1 class="text-3xl md:text-4xl font-bold font-serif text-[var(--color-burgundy)] mb-2">
            The {surname} Family
          </h1>
          <p class="text-lg text-[var(--color-ink-light)]">
            {members.length} profile{members.length !== 1 ? "s" : ""}
            {span ? ` · spanning ${span}` : ""}
          </p>
          <div class="flex gap-2 mt-3">
            <span class="text-xs px-3 py-1 rounded badge-deceased">{deceased.length} with a recorded death</span>
            <span class="text-xs px-3 py-1 rounded border border-[var(--color-border)] text-[var(--color-muted)]">{noDeathRecord.length} awaiting dates</span>
          </div>
        </div>
        <div class="text-5xl text-[var(--color-gold)] font-bold font-serif shrink-0">
          {members.length}
        </div>
      </div>
    </div>

    <!-- Roles overview -->
    {roles.length > 0 && (
      <div class="person-card rounded-xl p-4 mb-6">
        <h3 class="font-serif text-[var(--color-burgundy)] mb-2">Roles in this family</h3>
        <div class="flex flex-wrap gap-2">
          {roles.map((role) => (
            <span class="text-xs px-3 py-1 rounded-full border border-[var(--color-border)] text-[var(--color-ink-light)]">
              {stripWikiLinks(role)}
            </span>
          ))}
        </div>
      </div>
    )}

    <!-- Tags overview -->
    {tags.length > 0 && (
      <div class="person-card rounded-xl p-4 mb-6">
        <h3 class="font-serif text-[var(--color-burgundy)] mb-2">Associated Tags</h3>
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="text-xs px-3 py-1 rounded-full border border-[var(--color-border)] text-[var(--color-muted)]">
              {tag}
            </span>
          ))}
        </div>
      </div>
    )}

    <!-- A–Z jump links -->
    {showJump && (
      <nav class="jump-links mb-4" aria-label="Jump to letter">
        <span class="text-xs text-[var(--color-muted)] mr-1">Jump to:</span>
        {letters.map((l) => (
          <a href={`#letter-${l}`} data-letter={l} class="jump-chip">{l}</a>
        ))}
      </nav>
    )}

    <!-- Members list -->
    <div class="divide-y divide-[var(--color-border)]">
      {members.map((person) => (
        <a
          href={`${import.meta.env.BASE_URL}people/${person.slug}/`}
          data-row-letter={(person.display_name || "?")[0].toUpperCase()}
          class="flex items-center gap-4 py-3 px-2 no-underline hover:bg-[var(--color-surface)]/50 transition-colors rounded group"
        >
          <!-- Name & lifespan -->
          <div class="flex-1 min-w-0">
            <div class="font-medium text-[var(--color-burgundy)] group-hover:text-[var(--color-burgundy-light)] transition-colors">
              {person.display_name}
            </div>
            <div class="text-sm text-[var(--color-muted)]">
              {person.lifespan ? person.lifespan : "Dates unknown — records incomplete"}
            </div>
          </div>

          {/* Roles preview */}
          {person.roles?.length > 0 && (
            <div class="hidden md:block text-xs text-[var(--color-ink-light)] max-w-xs truncate">
              {stripWikiLinks(person.roles[0])}
            </div>
          )}

          {/* Arrow */}
          <span class="text-[var(--color-border)] group-hover:text-[var(--color-burgundy)] transition-colors">→</span>
        </a>
      ))}
    </div>
  </div>

    <!-- Help Us Complete the Record (tw-2026-11-03) -->
    {undatedMembers.length > 0 && (
      <section id="complete-the-record" class="mt-10 pt-6 border-t-2 border-[var(--color-border)]">
        <h2 class="font-serif text-xl text-[var(--color-burgundy)] mb-2">Help Us Complete the Record</h2>
        <p class="text-sm text-[var(--color-ink-light)] mb-2">
          {undatedMembers.length === 1 ? "One person in this family carries no year at all" : `${undatedMembers.length} people in this family carry no year at all`}
          — they are named in the record, but not yet dated. A notice, headstone photograph, register entry
          or Bible page would settle them, and we would love to hear from you.
        </p>
        <p class="text-sm mb-2">
          <a href={import.meta.env.BASE_URL + "contact/"} class="text-[var(--color-link)]">Send in a record →</a>
        </p>
        <p class="text-xs text-[var(--color-muted)] mb-4">
          Write to <span class="font-mono select-all">contact@telferwiki.com</span> — anyone can send, from any
          device, no account needed. Name, rough dates, place, and where you got it is enough.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          {undatedMembers.map((p) => (
            <a href={`${import.meta.env.BASE_URL}people/${p.slug}/`} class="person-card rounded-lg p-2.5 no-underline block">
              <div class="text-sm font-medium text-[var(--color-ink)]">{p.display_name}</div>
              <div class="text-xs text-[var(--color-muted)] mt-0.5">Dates unknown — records incomplete</div>
            </a>
          ))}
        </div>
      </section>
    )}
</BaseLayout>

<script>
  // A–Z jump (tw-2026-11-03). Duplicate ids within a letter are expected; we
  // scroll to the FIRST row whose data-letter matches, which is always the top
  // of that letter group in this list's fixed sort order.
  (function () {
    document.querySelectorAll('[data-letter]').forEach((link) => {
      link.addEventListener('click', function (e) {
        const letter = this.dataset.letter;
        const rows = Array.from(document.querySelectorAll('[data-row-letter]'));
        const target = rows.find((el) => el.dataset.rowLetter === letter);
        if (!target) return;
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
  })();
</script>

<style>
  .jump-links { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem; }
  .jump-chip {
    display: inline-block;
    min-width: 1.8rem;
    text-align: center;
    padding: 0.25rem 0.45rem;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    font-size: 0.72rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--color-ink-light);
    background: var(--color-surface);
  }
  .jump-chip:hover { border-color: var(--color-burgundy); color: var(--color-burgundy); }
</style>