---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { PersonData } from "../../utils/extract-data.mjs";

const people = (await import("../../data/people.public.json")).default as PersonData[];
const telferPeople = people
  .filter((p) => (p.branch === "telfer" || !p.branch) && p.id)
  .sort((a, b) => {
    // Sort by birth year, then by name
    const aYear = a.birth_year || 9999;
    const bYear = b.birth_year || 9999;
    if (aYear !== bYear) return aYear - bYear;
    return a.display_name.localeCompare(b.display_name);
  });

// Feature flag for Family Tree tab
const TELFER_TREE_ENABLED = import.meta.env.TELFER_TREE_ENABLED === "true";

// Extract unique tags
const allTags = [...new Set(telferPeople.flatMap((p) => p.tags || []))].sort();

// ── Split the directory (2026-11-03) ────────────────────────────────────────
// People whose record has NO usable year at all (lifespan renders as "?" or
// "? – ?") are held back from the alphabetical/alphabetical-by-year listing and
// shown in a separate "Help Us Complete the Record" block at the bottom, where
// the point IS that they are incomplete. The main list then reads as a clean
// directory instead of a wall of question marks.
function hasAnyYear(p: PersonData): boolean {
  return Boolean(p.birth_year) || Boolean(p.death_year);
}
const knownPeople = telferPeople.filter(hasAnyYear);
const unknownPeople = telferPeople.filter((p) => !hasAnyYear(p));

// A–Z jump targets: only letters that actually have entries.
const initialLetters = [
  ...new Set(
    knownPeople.map((p) => (p.display_name || "?")[0].toUpperCase()).filter((c) => /[A-Z]/.test(c)),
  ),
].sort();

// Group for the A–Z anchor blocks (used by the alphabetical sort mode), keyed
// by initial so the anchor targets exist wherever the JS puts the rows.
const byInitial: Record<string, PersonData[]> = {};
for (const p of knownPeople) {
  const key = (p.display_name || "?")[0].toUpperCase();
  if (!byInitial[key]) byInitial[key] = [];
  byInitial[key].push(p);
}

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="People"
  description={`Browse all ${telferPeople.length} profiles in the Telfer line — ${telferPeople.filter(p => p.is_deceased).length} with a recorded death and ${telferPeople.filter(p => !p.is_deceased).length} with no death record — from John Telfer of Castleton (b. 1731) to the present day. Part of the Telfer Family Wiki.`}
>
  <div class="page-header">
    <h1>All People</h1>
    <p class="text-[var(--color-ink-light)] mt-2">
      {telferPeople.length} profiles in the Telfer line
      &nbsp;·&nbsp; <span>{telferPeople.filter(p => p.is_deceased).length} with a recorded death</span>
      &nbsp;·&nbsp; <span class="text-[var(--color-muted)]">{unknownPeople.length} awaiting a date</span>
    </p>
  </div>

  <!-- Tab Navigation -->
  <nav class="mb-4 border-b border-[var(--color-border)]" aria-label="Tree views">
    <ul class="flex gap-1" role="tablist">
      {TELFER_TREE_ENABLED && (
        <li role="presentation">
          <a
            href={`${base}people/telfer-tree/`}
            class="px-4 py-2 rounded-t-lg border-b-2 border-[var(--color-link)] text-[var(--color-link)] font-medium"
            role="tab"
            aria-selected="true"
          >
            Family Tree (Charles &amp; Sons)
          </a>
        </li>
      )}
      {/* DNA tab removed 2026-11-05 (Mark's decision). The page it pointed at
          was an "Under Construction" stub with zero data — a nav item that
          promises content and delivers a placeholder is the same kind of
          unbacked claim we removed from the footer tonight. The route still
          exists at /people/dna/ so no inbound link breaks, but it is no
          longer advertised. Restore the tab the day there is real data. */}
    </ul>
  </nav>

  <!-- Filters. Restructured 2026-11-05 (Mark: "the buttons are a bit of a
       mess on the phone"). The old layout was one flat flex-wrap row: five
       pills, a bare "|" divider, and a "607 shown" counter that was pushed
       right with ml-auto. On a narrow screen the divider orphaned itself at
       the start of a line and the counter flew off to a corner of its own,
       so the row read as three ragged fragments. Now the two groups are real
       groups: Show (filters) and Sort (order), each on its own line, with the
       counter sitting inside the first group where it belongs. No divider is
       needed once the groups are visually separate. -->
  <div class="filter-bar mb-3">
    <div class="filter-group">
      <span class="filter-label">Show:</span>
      <a href={base + "people/"} data-filter-status="all" class="filter-btn text-xs px-3 py-1.5 rounded-full border border-[var(--color-border)] no-underline text-[var(--color-ink-light)] hover:border-[var(--color-burgundy)] transition-colors">Everyone</a>
      <a href={base + "people?status=recorded"} data-filter-status="recorded" class="filter-btn text-xs px-3 py-1.5 rounded-full border border-[var(--color-border)] no-underline text-[var(--color-ink-light)] hover:border-[var(--color-burgundy)] transition-colors">With a recorded death</a>
      <a href={base + "people?status=awaiting"} data-filter-status="awaiting" class="filter-btn text-xs px-3 py-1.5 rounded-full border border-[var(--color-border)] no-underline text-[var(--color-ink-light)] hover:border-[var(--color-burgundy)] transition-colors">Awaiting a date</a>
      <span class="filter-count"><span id="filter-count">{knownPeople.length}</span> shown</span>
    </div>
    <div class="filter-group">
      <span class="filter-label">Sort:</span>
      <a href={base + "people?sort=alpha"} data-filter-sort="alpha" class="filter-btn text-xs px-3 py-1.5 rounded-full border border-[var(--color-border)] no-underline text-[var(--color-ink-light)] hover:border-[var(--color-burgundy)] transition-colors">A–Z</a>
      <a href={base + "people?sort=year"} data-filter-sort="year" class="filter-btn text-xs px-3 py-1.5 rounded-full border border-[var(--color-border)] no-underline text-[var(--color-ink-light)] hover:border-[var(--color-burgundy)] transition-colors">By Year</a>
    </div>
  </div>

  <!-- A–Z jump links (tw-2026-11-03). Long directory: no infinite scrolling.
       Letters are always present; the browser scrolls to the matching anchor
       whether the list is in A–Z mode or by-year mode (anchors are on the rows
       themselves, so they exist in both orders). -->
  <nav class="jump-links mb-6" aria-label="Jump to letter">
    <span class="text-xs text-[var(--color-muted)] mr-1">Jump to:</span>
    {initialLetters.map((letter) => (
      <a href={`#letter-${letter}`} data-jump={letter} class="jump-chip">{letter}</a>
    ))}
  </nav>

  <!-- People Grid -->
  <div id="people-list" class="divide-y divide-[var(--color-border)]">
    {knownPeople.map((person) => {
      const initial = (person.display_name || "?")[0].toUpperCase();
      return (
      // 'recorded'/'awaiting' are FILTER KEYS read by the script below, not a
      // claim printed on the page. They stay wired to is_deceased / date
      // presence so the URL filter keeps working; the old "Deceased" badge
      // was removed on 2026-11-03 so ancestors are no longer flagged one by
      // one — only records still missing a date are called out, and only in
      // the Help Us Complete section.
      // NOTE: no id here — every row would share the first row's id for its
      // letter. The A–Z jump script scrolls to the first MATCHING row object
      // instead, which is correct in both sort modes.
      <a
        href={`${base}people/${person.slug}/`}
        data-initial={initial}
        class={`person-row flex items-center gap-4 py-3 px-2 no-underline hover:bg-[var(--color-surface)]/50 transition-colors rounded group ${person.is_deceased ? 'recorded' : 'awaiting'}`}
      >
        <!-- Name & lifespan -->
        <div class="flex-1 min-w-0">
          <div class="font-medium text-[var(--color-burgundy)] group-hover:text-[var(--color-burgundy-light)] transition-colors">
            {person.display_name}
          </div>
          {/* Lifespan line. display_name already embeds the years for most people,
              so this row showed the dates TWICE on 57 of 607 rows (measured) —
              "Elizabeth Beattie (1741 – 1819)" with "1741 – 1819" underneath.
              Hidden when the name already carries them, so each row states the
              years exactly once and the bold line keeps the row's weight. */}
          {!person.display_name?.includes(person.lifespan || '\u0000') && (
            <div class="text-sm text-[var(--color-muted)] lifespan">{person.lifespan}</div>
          )}
        </div>

        {/* Arrow (2026-11-04). Was --color-border, which measured 1.82:1 dark /
            1.84:1 light — effectively invisible, so 607 of them read as stray
            specks rather than a row affordance. --color-muted gives 5.3:1 dark
            / 5.0:1 light, matching the lifespan text it sits beside. */}
        <span class="text-[var(--color-muted)] group-hover:text-[var(--color-burgundy)] transition-colors">→</span>
      </a>
      );
    })}
  </div>

  {knownPeople.length === 0 && (
    <div class="text-center py-12 text-[var(--color-muted)]">
      <p class="text-lg">No profiles found.</p>
    </div>
  )}

  <!-- Help Us Complete the Record (2026-11-03) -->
  {unknownPeople.length > 0 && (
    <section id="complete-the-record" class="help-record mt-10 pt-6 border-t-2 border-[var(--color-border)]">
      <h2 class="font-serif text-xl text-[var(--color-burgundy)] mb-2">Help Us Complete the Record</h2>
      <p class="text-sm text-[var(--color-ink-light)] mb-2">
        These {unknownPeople.length} people are named in the family record, but no year of birth or death
        has been found for them yet. A notice, a headstone, a register entry or a family Bible page
        would fill the gap — if you can help with any of them, we would genuinely love to hear from you.
      </p>
      <p class="text-sm mb-2">
        <a href={base + "contact/"} class="text-[var(--color-link)]">Send in a record →</a>
      </p>
      <p class="text-xs text-[var(--color-muted)] mb-4">
        Write to <span class="font-mono select-all">contact@telferwiki.com</span> — anyone can send, from any
        device, no account needed. Name, rough dates, place, and where you got it is enough.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
        {unknownPeople.map((person) => (
          <a href={`${base}people/${person.slug}/`} class="person-card rounded-lg p-2.5 no-underline block">
            <div class="text-sm font-medium text-[var(--color-ink)] truncate">{person.display_name}</div>
            <div class="text-xs text-[var(--color-muted)] mt-0.5">Dates unknown — records incomplete</div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Search prompt -->
  <div class="mt-8 text-center">
    <a href={base + "search/"} class="text-sm text-[var(--color-link)]">
      Looking for someone specific? Try search →
    </a>
  </div>
</BaseLayout>

<script>
  (function() {
    const list = document.getElementById('people-list');
    if (!list) return;
    const items = Array.from(list.children);
    // Serialize person data into data attributes
    items.forEach(el => {
      el.dataset.recorded = el.classList.contains('recorded') ? 'true' : 'false';
      el.dataset.init = el.dataset.initial || '';
      el.dataset.name = (el.querySelector('.font-medium')?.textContent || '').toLowerCase();
      // Extract year from lifespan: "1840 – 1876" or "1840 – ?" (never "– living")
      const lifespan = el.querySelector('.lifespan')?.textContent || '';
      const yearMatch = lifespan.match(/(\d{4})\s*–/);
      el.dataset.year = yearMatch ? yearMatch[1] : '9999';
    });

    function applyFilters() {
      const params = new URLSearchParams(window.location.search);
      const status = params.get('status') || 'all';
      const sort = params.get('sort') || 'year';

      // Status filter
      items.forEach(el => {
        if (status === 'all') {
          el.style.display = '';
        } else if (status === 'recorded') {
          el.style.display = el.dataset.recorded === 'true' ? '' : 'none';
        } else if (status === 'awaiting') {
          el.style.display = el.dataset.recorded === 'false' ? '' : 'none';
        }
      });

      // Sort
      const visible = items.filter(el => el.style.display !== 'none');
      visible.sort((a, b) => {
        if (sort === 'alpha') {
          return a.dataset.name.localeCompare(b.dataset.name);
        }
        // Default: by year
        return parseInt(a.dataset.year) - parseInt(b.dataset.year);
      });
      visible.forEach(el => list.appendChild(el));

      // Update count
      const totalSpan = document.getElementById('filter-count');
      if (totalSpan) totalSpan.textContent = visible.length;

      // Highlight active buttons
      document.querySelectorAll('.filter-btn').forEach(btn => {
        const btnStatus = btn.dataset.filterStatus || 'all';
        const btnSort = btn.dataset.filterSort || '';
        const isActive = btnStatus === status && (!btnSort || btnSort === sort);
        btn.classList.toggle('filter-active', isActive);
        btn.classList.toggle('filter-inactive', !isActive);
      });
    }

    // Intercept filter clicks to update URL without reload
    document.querySelectorAll('.filter-btn').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const params = new URLSearchParams(window.location.search);
        if (this.dataset.filterStatus) params.set('status', this.dataset.filterStatus);
        if (this.dataset.filterSort) params.set('sort', this.dataset.filterSort);
        if (this.dataset.filterStatus === 'all' && !this.dataset.filterSort) {
          params.delete('status');
          params.delete('sort');
        }
        const newUrl = window.location.pathname + (params.toString() ? '?' + params.toString() : '');
        window.history.pushState({}, '', newUrl);
        applyFilters();
      });
    });

    // Initial apply on load
    applyFilters();

    // Handle back/forward navigation
    window.addEventListener('popstate', applyFilters);

    // A–Z jump links: in A–Z mode the first occurrence of a letter is the top of
    // that group, so duplicate ids are harmless; in year mode we scroll to the
    // first matching row in whatever order the list currently has.
    document.querySelectorAll('[data-jump]').forEach(link => {
      link.addEventListener('click', function(e) {
        const letter = this.dataset.jump;
        if (letter === 'help') return; // plain anchor to the section
        e.preventDefault();
        const target = items.find(el => el.dataset.init === letter && el.style.display !== 'none');
        if (!target) return;
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        target.classList.add('jump-flash');
        setTimeout(() => target.classList.remove('jump-flash'), 1200);
      });
    });
  })();
</script>

<style>
  .filter-active {
    border-color: var(--color-heading) !important;
    background: var(--color-heading) !important;
    color: white !important;
  }
  /* In dark mode --color-heading is a LIGHT rose (#c97b7b) chosen for text on a
     dark page. Reusing it as a pill BACKGROUND under white text gives 3.18:1 —
     unreadable. These pills take a darkened version while the theme is dark. */
  :global([data-theme="dark"]) .filter-active {
    background: #7d3f3f !important;
    border-color: #7d3f3f !important;
    color: #ffffff !important;
  }
  .filter-inactive {
    border-color: var(--color-border);
    color: var(--color-ink-light);
  }
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }
  .filter-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
  .filter-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    margin-right: 0.1rem;
  }
  /* The counter belongs to the Show group, not to the far edge of the row.
     It reads as the result of the filter immediately to its left, which is
     what it actually is. */
  .filter-count {
    font-size: 0.75rem;
    color: var(--color-muted);
    padding-left: 0.15rem;
    white-space: nowrap;
  }
  .jump-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
  }
  .jump-chip {
    display: inline-block;
    min-width: 1.9rem;
    text-align: center;
    padding: 0.25rem 0.45rem;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--color-ink-light);
    background: var(--color-surface);
    transition: all 0.15s ease;
  }
  .jump-chip:hover {
    border-color: var(--color-burgundy);
    color: var(--color-burgundy);
  }
  .jump-chip-help {
    min-width: auto;
    border-style: dashed;
  }
  .jump-flash {
    animation: jumpflash 1.2s ease;
  }
  @keyframes jumpflash {
    0% { background: color-mix(in srgb, var(--color-gold) 35%, transparent); }
    100% { background: transparent; }
  }
  .help-record .person-card {
    border-color: var(--color-border);
  }
</style>
