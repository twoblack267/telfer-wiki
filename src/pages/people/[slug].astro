// Extract a year from a free-text fact line like "**Born:** ~1872 (aged 93 …)".
const proseSentence = firstProseSentence(bodyHtml);
// The body's first sentence usually repeats the person's own name (the profile
// heading is stripped, so "James Telfer (bap.1762) Baptised: …" leads). Leading with
// name + name reads as a stutter in a search result, so drop a sentence that is
// nothing but the name plus dates when the person has no OTHER prose to offer.
const nameOnly = (() => {
  const norm = (t) => String(t || "").toLowerCase().replace(/[^a-z ]/g, " ").replace(/\s+/g, " ").trim();
  const n = norm(person.display_name);
  let s = norm(proseSentence);
  if (!n || !s) return false;
  // Strip any leading occurrence of the display name ("Bertha Telfer (Alcorn)
  // Role: Adopted daughter…" → "Role: Adopted daughter…"). Only a PREFIX is
  // stripped, and only the longest match, so "Robert Dunlop Sr, father of…" keeps
  // its "Sr" instead of being truncated to the bare name.
  if (s.startsWith(n)) s = s.slice(n.length).trim();
  // The remainder must be EMPTY for this to be a pure name echo.
  return s.length === 0;
})();
// When the body merely restates the name, strip that echo from the front of the
// sentence rather than throwing the whole sentence away — "Robert Dunlop Stub entry
// — …" becomes "Stub entry — …", which is the part that actually says something.
const stripNamePrefix = (t) => {
  const n = String(person.display_name || "").trim();
  if (!n || !t) return t;
  const m = t.match(new RegExp("^\\s*" + n.replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + "\\s*(?:\\(([^)]*)\\))?[\\s.:—-]*", "i"));
