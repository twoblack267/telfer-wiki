    const text = decodeText(String(raw).replace(/<[^>]+>/g, " "));
    if (!text) continue;
    // The fallback tier collects ONLY text that is fit to publish. It used to collect
    // everything except source notes and then return it unfiltered when the cleaner
    // tiers came up empty — so a changelog line ("Stub entry written from the printed
    // book page, 3 Oct 2026") went out the back door that every other tier had shut.
    const neverDescribe = isEditorialOnly(text);
    if (!neverDescribe) anyText.push(text);
    const s = firstSentence(text);
    if (s && !neverDescribe) {
      // TIER (b) MUST NOT BE A BACK DOOR. It exists so a plain factual line ("Deceased
      // -- dates not recorded.") can serve when nothing else does. It is not licence for
      // our own editorial furniture to become a description: a same-name trap warning,
      // a "not yet sourced" note and a "what is not known" ledger are all perfectly good
      // sentences, and all of them are the wrong thing to show a searcher.
      if (!neverDescribe) sentence.push(s);
      if (!neverDescribe && !looksLikeLabel(text)) clean.push(s);
    }
  }
  // A description that opens with our own editorial label ("What is known: she was…")
  // reads like a database, not a biography. Strip a short bold-opener prefix so the
  // sentence stands on its own: "she was born in Roxburghshire, Scotland, around 1829."
  const stripOpener = (t) => {
    const m = /^[A-Z][A-Za-z\-']{0,14}(?: [A-Z][A-Za-z\-']{0,14})?:\s+(.+)$/.exec(t);
    if (!m) return t;
    const tail = m[1].trim();
    // Only when the tail can stand alone: starts lower-case or is a full clause.
    if (tail.split(/\s+/).length >= 8 && /^[a-z]/.test(tail)) {
