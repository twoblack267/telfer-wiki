        )}

        {person.haplogroup_y && (
          <div class="person-card rounded-xl p-3 mt-3">
            <h2 class="font-serif text-sm text-[var(--color-heading)] mb-1">Paternal Haplogroup (Y-DNA)</h2>
            <p class="font-mono text-sm text-[var(--color-ink-light)]">{person.haplogroup_y}</p>
          </div>
        )}
      </div>

      <!-- Sidebar -->
      <div class="space-y-2">
        <!-- Relationship: Spouse -->
        {spouseLinks.length > 0 && (
          <div class="person-card rounded-xl p-2.5">
            <h3 class="font-serif text-[var(--color-heading)] mb-1">Spouse{spouseLinks.length > 1 ? "s" : ""}</h3>
            <ul class="space-y-0">
              {spouseLinks.map(({ name, slug, lifespan }) => (
                <li>
                  {slug ? (
                    <a href={`${import.meta.env.BASE_URL}people/${slug}/`} class="text-[var(--color-link)] text-sm">{name}</a>
                  ) : (
                    <span class="text-sm text-[var(--color-ink-light)]">{name}</span>
                  )}
                  {lifespan && <span class="text-xs text-[var(--color-muted)] ml-1">({lifespan})</span>}
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Relationship: Parents -->
        {parentLinks.length > 0 && (
          <div class="person-card rounded-xl p-2.5">
            <h3 class="font-serif text-[var(--color-heading)] mb-1">Parents</h3>
            <ul class="space-y-0">
              {parentLinks.map(({ name, slug, lifespan }) => (
                <li>
                  {slug ? (
                    <a href={`${import.meta.env.BASE_URL}people/${slug}/`} class="text-[var(--color-link)] text-sm">{name}</a>
                  ) : (
                    <span class="text-sm text-[var(--color-ink-light)]">{name}</span>
                  )}
                  {lifespan && <span class="text-xs text-[var(--color-muted)] ml-1">({lifespan})</span>}
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Relationship: Children -->
        {childLinks.length > 0 && (
          <div class="person-card rounded-xl p-2.5">
            <h3 class="font-serif text-[var(--color-heading)] mb-1">Children</h3>
            <ul class="space-y-0">
              {childLinks.map(({ name, slug, lifespan }) => (
                <li>
                  {slug ? (
                    <a href={`${import.meta.env.BASE_URL}people/${slug}/`} class="text-[var(--color-link)] text-sm">{name}</a>
                  ) : (
                    <span class="text-sm text-[var(--color-ink-light)]">{name}</span>
                  )}
                  {lifespan && <span class="text-xs text-[var(--color-muted)] ml-1">({lifespan})</span>}
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Relationship: Step-parents (added 2026-09-22) -->
        {stepParentLinks.length > 0 && (
          <div class="person-card rounded-xl p-2.5">
            <h3 class="font-serif text-[var(--color-heading)] mb-1">Step-parent{stepParentLinks.length > 1 ? "s" : ""}</h3>
            <ul class="space-y-0">
              {stepParentLinks.map(({ name, slug, lifespan }) => (
                <li>
                  {slug ? (
                    <a href={`${import.meta.env.BASE_URL}people/${slug}/`} class="text-[var(--color-link)] text-sm">{name}</a>
                  ) : (
                    <span class="text-sm text-[var(--color-ink-light)]">{name}</span>
                  )}
                  {lifespan && <span class="text-xs text-[var(--color-muted)] ml-1">({lifespan})</span>}
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Relationship: Stepchildren (added 2026-09-22) -->
        {stepChildLinks.length > 0 && (
          <div class="person-card rounded-xl p-2.5">
            <h3 class="font-serif text-[var(--color-heading)] mb-1">Stepchildren</h3>
            <ul class="space-y-0">
              {stepChildLinks.map(({ name, slug, lifespan }) => (
                <li>
                  {slug ? (
                    <a href={`${import.meta.env.BASE_URL}people/${slug}/`} class="text-[var(--color-link)] text-sm">{name}</a>
                  ) : (
                    <span class="text-sm text-[var(--color-ink-light)]">{name}</span>
                  )}
                  {lifespan && <span class="text-xs text-[var(--color-muted)] ml-1">({lifespan})</span>}
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Relationship: Siblings -->
        {siblingLinks.length > 0 && (
          <div class="person-card rounded-xl p-2.5">
            <h3 class="font-serif text-[var(--color-heading)] mb-1">Siblings</h3>
            <ul class="space-y-0">
              {siblingLinks.map(({ name, slug, lifespan }) => (
                <li>
                  {slug ? (
                    <a href={`${import.meta.env.BASE_URL}people/${slug}/`} class="text-[var(--color-link)] text-sm">{name}</a>
                  ) : (
                    <span class="text-sm text-[var(--color-ink-light)]">{name}</span>
                  )}
                  {lifespan && <span class="text-xs text-[var(--color-muted)] ml-1">({lifespan})</span>}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>

    <!-- The three navigation links (Back to all people / Descendant Chart /
         Family Sheet) are rendered by BaseLayout at the VERY BOTTOM of the
         page, after Common Questions + map, via the navState prop. -->
  </div>
</BaseLayout>

