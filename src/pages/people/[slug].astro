---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatBody, getLinksForRelationships } from "../../utils/format-body.mjs";

export async function getStaticPaths() {
  const people = (await import("../../data/people.public.json")).default;
  return people
    .filter((p) => p.id)
    .map((person) => ({
    params: { slug: person.slug },
    props: { person },
  }));
}

const { person } = Astro.props;
const people = (await import("../../data/people.public.json")).default;
const telferPeople = people.filter((p) => p.branch === "telfer" || !p.branch);

// ── Relationship groupings ──
const spouseLinks = getLinksForRelationships(person.spouses, telferPeople);
const parentLinks = getLinksForRelationships(person.parents, telferPeople);
const childLinks = getLinksForRelationships(person.children, telferPeople);
const siblingLinks = getLinksForRelationships(person.siblings, telferPeople);

// ── Body content ──
const bodyHtml = formatBody(person.body_markdown || "", telferPeople);

// ── Tags ──
const importantTags = (person.tags || []).filter((t) => !["bio", "family", "person"].includes(t));

// ── Helper: ordinal suffix (1st, 2nd, 3rd, 4th…) for generation labels ──
function ordinalSuffix(n) {
  const s = ["th", "st", "nd", "rd"];
  const v = n % 100;
  return s[(v - 20) % 10] || s[v] || s[0];
}


// ── SEO: unique per-person meta description ──
const yearSpan = person.lifespan
  ? person.lifespan
  : [person.birth_year_display, person.is_living ? "living" : person.death_year_display]
      .filter(Boolean)
      .join(" – ");
const genNote = person.generation
  ? ` ${person.generation}${ordinalSuffix(person.generation)} generation Telfer.`
  : "";
const livingNote = person.is_living ? "" : " Ancestor of the Telfer line.";
const seoDescription = [
  person.display_name,
  yearSpan ? `(${yearSpan})` : "",
  `— Telfer family history.`,
  genNote,
  livingNote,
].join(" ").replace(/\s+/g, " ").slice(0, 158);


// ── SEO: Schema.org Person structured data ──
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: person.display_name,
  url: `https://telferwiki.com/people/${person.slug}`,
  ...(person.birth_year_display ? { birthDate: person.birth_year_display } : {}),
  ...(person.death_year_display && !person.is_living ? { deathDate: person.death_year_display } : {}),
  // Relatives live at their own URLs on this same site
  ...(parentLinks.length ? { parent: parentLinks.map((p) => ({ "@type": "Person", name: p.name, url: `https://telferwiki.com/people/${p.slug}` })) } : {}),
  ...(childLinks.length ? { children: childLinks.map((c) => ({ "@type": "Person", name: c.name, url: `https://telferwiki.com/people/${c.slug}` })) } : {}),
};
---

<BaseLayout
  title={person.display_name}
  description={seoDescription}
  canonicalPath={`/people/${person.slug}`}
  ogType="profile"
  schema={personSchema}
>
  <div class="max-w-4xl mx-auto">
    <!-- Breadcrumb -->
    <div class="text-sm text-[var(--color-muted)] mb-1.5">
      <a href={import.meta.env.BASE_URL + "people"} class="text-[var(--color-link)]">People</a>
      <span class="mx-2">/</span>
      <span>{person.display_name}</span>
    </div>

    <!-- Header Card -->
    <div class="person-card rounded-xl p-3 md:p-4 mb-3">
      <div class="flex items-start justify-between gap-2">
        <div class="flex-1">
          <h1 class="text-xl md:text-2xl font-bold font-serif text-[var(--color-heading)] mb-0.5">
            {person.display_name}
          </h1>

          <!-- Lifespan -->
          <div class="text-sm text-[var(--color-ink-light)] mb-1">
            {person.lifespan}
          </div>

          <!-- Roles -->
          {person.roles?.length > 0 && (
            <div class="space-y-0">
              {person.roles.map((role) => (
                <div key={role} class="text-xs text-[var(--color-ink-light)] italic">
                  {role}
                </div>
              ))}
            </div>
          )}
        </div>

        {/* Portrait Photo or Initials Avatar */}
        {person.person_photo ? (
          <div class="w-16 h-16 md:w-20 md:h-20 rounded-full overflow-hidden border-2 border-[var(--color-highlight)] shrink-0 bg-[var(--color-surface)]">
            <img
              src={import.meta.env.BASE_URL + person.person_photo}
              alt={person.display_name}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        ) : (
          <div class="w-12 h-12 md:w-16 md:h-16 rounded-full bg-[var(--color-heading)] text-white flex items-center justify-center text-lg md:text-xl font-serif font-bold shrink-0">
            {person.first_name?.[0]}{person.last_name?.[0]}
          </div>
        )}
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-1.5">
      <!-- Main Content -->
      <div class="md:col-span-2">
        <div class="person-card rounded-xl p-2.5">
          <h2 class="font-serif text-base text-[var(--color-heading)] mb-0">Biography</h2>
          <!-- Wiki-formatted body (first h1 stripped, leading empty paragraphs + whitespace removed, prose tightened) -->
          <div class="prose prose-sm max-w-none wiki-content" set:html={bodyHtml
            .replace(/^<h1[^>]*>.*?<\/h1>\s*/i, '')
            .replace(/^(<p>\s*<\/p>\s*)+/i, '')
            .replace(/^\s+/, '')
          }></div>
          <style define:vars={{}}>
            .wiki-content > :first-child { margin-top: 0 !important; }
          </style>
        </div>

        <!-- Photo Gallery -->
        {person.images?.length > 0 && (
          <div class="person-card rounded-xl p-3 mt-3">
            <h2 class="font-serif text-sm text-[var(--color-heading)] mb-2">Photos</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
              {person.images.map((img) => (
                <figure key={img.src} class="m-0">
                  <img
                    src={import.meta.env.BASE_URL + img.src}
                    alt={img.alt}
                    class="w-full h-auto rounded-lg border border-[var(--color-border)] object-contain bg-[var(--color-surface)]"
                    loading="lazy"
                    style="max-height: 300px;"
                  />
                  <figcaption class="text-xs text-[var(--color-muted)] mt-1 text-center line-clamp-2">{img.alt}</figcaption>
                </figure>
              ))}
            </div>
          </div>
        )}

        <!-- Tags -->
        {importantTags.length > 0 && (
          <div class="person-card rounded-xl p-3 mt-3">
            <h2 class="font-serif text-sm text-[var(--color-heading)] mb-1.5">Tags</h2>
            <div class="flex flex-wrap gap-1">
              {importantTags.map((tag) => (
                <span key={tag} class="text-xs px-2 py-0.5 rounded-full border border-[var(--color-border)] text-[var(--color-muted)]">{tag}</span>
              ))}
            </div>
          </div>
        )}

        <!-- DNA Connections -->
        {person.dna_matches?.length > 0 && (
          <div class="person-card rounded-xl p-3 mt-3">
            <h2 class="font-serif text-sm text-[var(--color-heading)] mb-2">DNA Matches</h2>
            <dl class="space-y-3">
              {person.dna_matches.map((match, i) => (
                <div key={i} class="border-l-2 border-[var(--color-highlight)] pl-3">
                  <dt class="font-medium text-sm">{match.name}</dt>
                  <dd class="text-xs text-[var(--color-ink-light)] mt-0.5">
                    {match.relationship} — {match.centimorgans} cM
                    {match.company && ` (${match.company})`}
                  </dd>
                  {match.notes && <dd class="text-xs text-[var(--color-muted)] mt-0.5 italic">{match.notes}</dd>}
                </div>
              ))}
            </dl>
          </div>
        )}

        {person.haplogroup_mt && (
          <div class="person-card rounded-xl p-3 mt-3">
            <h2 class="font-serif text-sm text-[var(--color-heading)] mb-1">Maternal Haplogroup</h2>
            <p class="font-mono text-sm text-[var(--color-ink-light)]">{person.haplogroup_mt}</p>
          </div>
        )}

        {person.haplogroup_y && (
          <div class="person-card rounded-xl p-3 mt-3">
            <h2 class="font-serif text-sm text-[var(--color-heading)] mb-1">Paternal Haplogroup (Y-DNA)</h2>
            <p class="font-mono text-sm text-[var(--color-ink-light)]">{person.haplogroup_y}</p>
          </div>
        )}
      </div>

      <!-- Sidebar -->
      <div class="space-y-2">
        <!-- Relationship: Spouse -->
        {spouseLinks.length > 0 && (
          <div class="person-card rounded-xl p-2.5">
            <h3 class="font-serif text-[var(--color-heading)] mb-1">Spouse{spouseLinks.length > 1 ? "s" : ""}</h3>
            <ul class="space-y-0">
              {spouseLinks.map(({ name, slug, lifespan }) => (
                <li key={slug || name}>
                  {slug ? (
                    <a href={`${import.meta.env.BASE_URL}people/${slug}`} class="text-[var(--color-link)] text-sm">{name}</a>
                  ) : (
                    <span class="text-sm text-[var(--color-ink-light)]">{name}</span>
                  )}
                  {lifespan && <span class="text-xs text-[var(--color-muted)] ml-1">({lifespan})</span>}
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Relationship: Parents -->
        {parentLinks.length > 0 && (
          <div class="person-card rounded-xl p-2.5">
            <h3 class="font-serif text-[var(--color-heading)] mb-1">Parents</h3>
            <ul class="space-y-0">
              {parentLinks.map(({ name, slug, lifespan }) => (
                <li key={slug || name}>
                  {slug ? (
                    <a href={`${import.meta.env.BASE_URL}people/${slug}`} class="text-[var(--color-link)] text-sm">{name}</a>
                  ) : (
                    <span class="text-sm text-[var(--color-ink-light)]">{name}</span>
                  )}
                  {lifespan && <span class="text-xs text-[var(--color-muted)] ml-1">({lifespan})</span>}
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Relationship: Children -->
        {childLinks.length > 0 && (
          <div class="person-card rounded-xl p-2.5">
            <h3 class="font-serif text-[var(--color-heading)] mb-1">Children</h3>
            <ul class="space-y-0">
              {childLinks.map(({ name, slug, lifespan }) => (
                <li key={slug || name}>
                  {slug ? (
                    <a href={`${import.meta.env.BASE_URL}people/${slug}`} class="text-[var(--color-link)] text-sm">{name}</a>
                  ) : (
                    <span class="text-sm text-[var(--color-ink-light)]">{name}</span>
                  )}
                  {lifespan && <span class="text-xs text-[var(--color-muted)] ml-1">({lifespan})</span>}
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Relationship: Siblings -->
        {siblingLinks.length > 0 && (
          <div class="person-card rounded-xl p-2.5">
            <h3 class="font-serif text-[var(--color-heading)] mb-1">Siblings</h3>
            <ul class="space-y-0">
              {siblingLinks.map(({ name, slug, lifespan }) => (
                <li key={slug || name}>
                  {slug ? (
                    <a href={`${import.meta.env.BASE_URL}people/${slug}`} class="text-[var(--color-link)] text-sm">{name}</a>
                  ) : (
                    <span class="text-sm text-[var(--color-ink-light)]">{name}</span>
                  )}
                  {lifespan && <span class="text-xs text-[var(--color-muted)] ml-1">({lifespan})</span>}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>

    <!-- Navigation footer -->
    <div class="mt-3 flex justify-between items-center border-t border-[var(--color-border)] pt-2 text-sm">
      <a href={import.meta.env.BASE_URL + "people"} class="text-[var(--color-link)]">← Back to all people</a>
      <div class="flex items-center gap-4">
        {person.children.length > 0 && (
          <a href={import.meta.env.BASE_URL + "people/" + person.slug + "/descendants"} class="text-[var(--color-link)] hover:underline text-right">
            📊 Descendant Chart →
          </a>
        )}
        {(person.spouses.length > 0 || person.parents.length > 0 || person.siblings.length > 0) && (
          <a href={import.meta.env.BASE_URL + "people/" + person.slug + "/family-sheet"} class="text-[var(--color-link)] hover:underline">
            👪 Family Sheet →
          </a>
        )}
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .wiki-content a.wiki-link {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
  }
  .wiki-content a.wiki-link:hover {
    color: var(--color-heading-hover);
  }
  .wiki-content figure {
    margin: 0;
  }
  .wiki-content img {
    border-radius: 0.5rem;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
  }
  .wiki-content figcaption {
    font-size: 0.75rem;
    color: var(--color-muted);
    margin-top: 0.15rem;
  }
</style>
