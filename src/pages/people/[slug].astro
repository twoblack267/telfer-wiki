---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatBody, getLinksForRelationships, inlineLinks, stripWikiLinks } from "../../utils/format-body.mjs";
import { renderVaultMarks, stripVaultMarks } from "../../utils/vault-marks.mjs";
import { NOINDEX_SLUGS } from "../../data/privacy-exclusions.mjs";
// Per-person Open Graph share cards, generated by scripts/gen-og-images.mjs and
// committed as slug -> "/og/<slug>.png". Built rather than derived at render time
// for the same reason as lastmod.json: CI must not need anything local-only.
import OG_IMAGES from "../../data/og-images.json";
import { clampDescription, decodeDescriptionEntities } from "../../utils/meta-description.mjs";
import { lookupByPersonSlug, resolvePersonKey } from "../../lib/resolve-person-key.mjs";

export async function getStaticPaths() {
  const people = (await import("../../data/people.public.json")).default;
  return people
    .filter((p) => p.id)
    .map((person) => ({
    params: { slug: person.slug },
    props: { person },
  }));
}

const { person } = Astro.props;
const isNoIndex = NOINDEX_SLUGS.has(person.slug);
const people = (await import("../../data/people.public.json")).default;
const telferPeople = people.filter((p) => p.branch === "telfer" || !p.branch);
// Every real page slug — the resolver's candidate set for manifest lookups.
const allSlugs = new Set(people.map((p) => p.slug).filter(Boolean));

// ── Relationship groupings ──
// `context` carries WHOSE page this is and WHICH relation each list holds, so the
// renderer can refuse a link the DATES make impossible (2026-10-25). Without it a
// raw name resolved by name alone and could hand a man his own son as his father.
const spouseLinks = getLinksForRelationships(person.spouses, telferPeople, { subject: person, relation: "spouses" });
const parentLinks = getLinksForRelationships(person.parents, telferPeople, { subject: person, relation: "parents" });
const childLinks = getLinksForRelationships(person.children, telferPeople, { subject: person, relation: "children" });
const siblingLinks = getLinksForRelationships(person.siblings, telferPeople, { subject: person, relation: "siblings" });
// Step relationships (added 2026-09-22) — rendered in their OWN sections so a
// step-parent/stepchild is never presented as a blood relation. No generation gate:
// a step relation has no biological bounds.
const stepParentLinks = getLinksForRelationships(person.step_parents || [], telferPeople);
const stepChildLinks = getLinksForRelationships(person.step_children || [], telferPeople);

// ── Body content ──
const bodyHtml = formatBody(person.body_markdown || "", telferPeople);

// The h1 + leading empty paragraphs are stripped at render time, so the "has real
// prose?" test must be applied to the STRIPPED form, not the raw bodyHtml - otherwise
// a profile whose only body is a '# Name' heading plus '## Links' still looks non-empty.
// (Skippy, 2026-09-13: fixes the empty Biography card, card tw-2026-09-12-015.)
// Vault evidence marks (⚠️ ✅ ❌ ⭐) are a grading system, not decoration - the
// vault keeps them verbatim and we translate them to the site's line-icon style
// here, at render time. Editing 125 vault files to restyle a view would be
// deleting research judgements to fix a look.
const bodyHtmlMarked = renderVaultMarks(bodyHtml);
const bodyHtmlClean = bodyHtmlMarked
  .replace(/^<h1[^>]*>.*?<\/h1>\s*/i, '')
  .replace(/^(<p>\s*<\/p>\s*)+/i, '')
  .replace(/^\s+/, '');
const hasBio = bodyHtmlClean.replace(/<[^>]*>/g, '').trim().length > 0;

// ── Tags ──
const importantTags = (person.tags || []).filter((t) => !["bio", "family", "person"].includes(t));

// ── Photo gallery ──
// Show every photo in images[] EXCEPT ones already rendered inline in the
// biography body (the `## Photo`/`## Photos` body_markdown embeds that surface
// as <figure> blocks). Never emit the same photo both as a body figure AND a
// gallery tile (Card telw-20260902-001 duplicate-image rendering).
//
// IMPORTANT: we intentionally do NOT drop the person.person_photo (round avatar)
// from the gallery here. The person_photo is browsable-page content, not only a
// header crop — a profile whose ONLY image is its person_photo would otherwise
// show just a tiny round thumbnail and miss the real photograph entirely (e.g.
// Mark's wedding photo, which lives in a formatBody-stripped `## Photos` section
// and so never reaches the body). The bodyImageFiles check below already prevents
// a true visual duplicate for `## Photo`-style profiles whose portrait surfaces
// as a body figure; for everyone else the photo must appear in the gallery.
const bodyImageFiles = new Set(
  [...bodyHtml.matchAll(/src="([^"]*\/images\/people\/[^"]+)"/g)].map((m) =>
    decodeURIComponent(m[1].split("/").pop()?.toLowerCase() ?? "")
  )
);
const galleryImages = (person.images || []).filter(
  (img) =>
    !bodyImageFiles.has(
      decodeURIComponent(String(img.src || "").split("/").pop()?.toLowerCase() ?? "")
    )
);

// ── Helper: ordinal suffix (1st, 2nd, 3rd, 4th…) for generation labels ──
function ordinalSuffix(n) {
  const s = ["th", "st", "nd", "rd"];
  const v = n % 100;
  return s[(v - 20) % 10] || s[v] || s[0];
}


// Derive a display lifespan as a single lossless string, so a stale stored
// `lifespan` can never leak a wrong "?" into the hero or meta (the Allen defect:
// birth 1956 recorded but hero kept "? – 2015"). Mirrors sanitize exactly:
//     lifespan = birth_year_display + " – " + death_year_display
// Display fields are always populated and hold "~" circa / "living" / "?".
function dLifespan(p) {
  if (!p.birth_year_display && !p.death_year_display) return p.lifespan || "";
  return `${p.birth_year_display ?? "?"} – ${p.death_year_display ?? "?"}`;
}
const heroLifespan = dLifespan(person);

// ── SEO: unique per-person meta description ──
// Template-only descriptions ("Name (years) — Telfer family history. Nth generation
// Telfer.") are technically unique but say nothing a searcher cannot already read in
// the title, and 28 of them printed the unknown-date placeholder "(? – ?)".
// So: lead with the person's own first prose sentence, which is real page content and
// is where the occupation / place / story lives. Fall back to the template only when
// the profile has no prose. Card itcrew-20261021-template-descs.
const yearSpan = heroLifespan;
const genNote = (person.generation && person.generation < 90)
  ? ` ${person.generation}${ordinalSuffix(person.generation)} generation Telfer.`
  : "";
// "Ancestor of the Telfer line." is a FACTUAL claim, so it is computed, never
// assumed. Previously every deceased person carried it — infants, in-laws and
// non-Telfer collateral relatives included (card tw-2026-10-19-001). It is now
// emitted only for a person who really is a direct ancestor of the living Telfer
// line, derived by walking `parents` upward from the line's living descendants.
// A person with no descent path to the line gets no claim at all.
//
// NOTE (2026-10-20): both directions of the graph are walked. A parent's `parents`
// entry is not always populated — James Telfer (1761) lists no `parents` at all,
// yet his father's record lists him under `children`. A parents-only walk silently
// drops the top of the line. Card tw-2026-10-19-001.
function normaliseRef(ref, bySlug, byId) {
  if (ref && typeof ref === "object") return ref.slug || ref.id || null;
  if (typeof ref !== "string") return null;
  const hit = bySlug.get(ref) || byId.get(ref);
  return hit ? hit.slug : ref;
}

function directLineAncestors(peopleList) {
  const bySlug = new Map(peopleList.map((p) => [p.slug, p]).filter(([s]) => s));
  const byId = new Map(peopleList.map((p) => [p.id, p]).filter(([, p]) => p));
  const kidsOf = new Map();
  for (const p of peopleList) {
    for (const ref of p.children || []) {
      const childSlug = normaliseRef(ref, bySlug, byId);
      if (!childSlug || childSlug === p.slug) continue;
      if (!kidsOf.has(childSlug)) kidsOf.set(childSlug, []);
      kidsOf.get(childSlug).push(p.slug);
    }
  }
  const roots = peopleList
    .filter((p) => /^mark-telfer-1986$/.test(p.slug || ""))
    .map((p) => p.slug);
  const seen = new Set();
  const stack = [...roots];
  while (stack.length) {
    const next = stack.pop();
    const p = bySlug.get(next) || byId.get(next) || { slug: next };
    const parents = [
      ...(p.parents || []).map((r) => normaliseRef(r, bySlug, byId)),
      ...(kidsOf.get(next) || []),
    ];
    for (const slug of parents) {
      if (slug && !seen.has(slug) && !roots.includes(slug)) {
        seen.add(slug);
        stack.push(slug);
      }
    }
  }
  return seen;
}
const directLine = directLineAncestors(people);
// Route marker slugs (the `john-telfer-of-castleton`-style alias filenames) are served
// by appending " Ancestor of the Telfer line." so markdown mirrors can be matched
// byte-for-byte against these two exact strings. They are navigational shims for
// named ancestors, not a general claim — keep the suffix explicit, do not derive it.
const ROUTE_MARKER_SLUGS = new Set(["james-telfer-1761", "john-telfer-of-castleton-1731"]);
// ── Evidence provenance banner (added 2026-10-28) ────────────────────────────
// Mark, 28 Oct 2026: "I just don't want anyone floating off on their own with no
// sauce, just a document." The vault already answers that question in its own
// frontmatter — `single_source`, `evidence_level`, `provisional_why` — but the
// converter used to drop all three, so the site presented a single-witness page
// with the same unblinking confidence as a certified one. That is the defect this
// banner fixes. It reports what the vault says; it never upgrades or softens it.
//
// Absence of a field is NOT proof of strength: 239 files say `single_source: true`
// and 99 say `evidence_level: single_source`, but plenty of older files predate the
// convention. So the banner speaks only when the vault has spoken, and says
// "no evidence rating recorded" rather than implying a clean bill of health.
const evidenceLevel = (person.evidence_level || "").trim();
const singleSource = person.single_source === true;
const provisionalWhy = (person.provisional_why || "").trim();
const isSingleSource = singleSource || evidenceLevel === "single_source";
const evidenceNote = (() => {
  if (isSingleSource && provisionalWhy) {
    return { tier: "single", title: "Single source — unverified", body: provisionalWhy };
  }
  if (isSingleSource) {
    return {
      tier: "single",
      title: "Single source — unverified",
      body:
        "This profile rests on one source only. It has not been corroborated by an " +
        "independent record. Treat the facts here as a lead to be checked, not as settled.",
    };
  }
  if (evidenceLevel === "verified") {
    return {
      tier: "verified",
      title: "Independently corroborated",
      body: "The vault records this profile's facts as confirmed against an independent record.",
    };
  }
  if (evidenceLevel === "soft-yes-provisional") {
    return {
      tier: "provisional",
      title: "Sound but provisional",
      body:
        "Certainly right on present evidence, receipt attached, but not yet hardened " +
        "against an independent record.",
    };
  }
  if (evidenceLevel === "chapter-placed") {
    return {
      tier: "placed",
      title: "Placed by chapter",
      body: "Position in the family established from a book chapter rather than a vital record.",
    };
  }
  return null;
})();

const livingNote = person.is_living
  ? ""
  : ROUTE_MARKER_SLUGS.has(person.slug) || directLine.has(person.slug)
    ? " Ancestor of the Telfer line."
    : "";

// Extract a year from a free-text fact line like "**Born:** ~1872 (aged 93 …)".
// Handles ~ / c. / ca. / plain, and 3–4 digit years. Returns "" when absent.
function yearFromLine(markdown, label) {
  // NOTE: this regex is built with new RegExp and a template literal, so every
  // backslash must be DOUBLED. A single \s inside a template literal collapses to
  // a bare "s", which silently turns the pattern into garbage and returns "" for
  // every profile — the exact failure this card was filed for. Do not "tidy" this.
  const re = new RegExp(`\\*\\*${label}:\\*\\*\\s*([^\\n]*)`, "i");
  const m = String(markdown || "").match(re);
  if (!m) return "";
  const y = m[1].match(/\b(\d{3,4})\b/);
  return y ? y[1] : "";
}
// Some profiles state their dates in the body while the structured fields are "?"
// (e.g. Bertha Telfer: born ~1872, died 10 Aug 1965, fields both "?"). Read the
// profile's own stated facts rather than inventing anything: the numbers come from
// its own text, never from arithmetic.
// yearSpan is the BARE pair ("? – ?"), not "(? – ?)" — the parentheses are added at
// render. Testing for literal parens here never matched and silently left every
// unknown-date profile on the placeholder path. Match the bare form.
const unknownSpan = !yearSpan || /^\s*[~?]?\s*–\s*[~?]?\s*$/.test(yearSpan.trim());
const bodyBirth = unknownSpan ? yearFromLine(person.body_markdown, "Born") : "";
const bodyDeath = unknownSpan ? yearFromLine(person.body_markdown, "Died") : "";
const yearText = !unknownSpan
  ? yearSpan
  : bodyBirth && bodyDeath
    ? `${bodyBirth} – ${bodyDeath}`
    : bodyBirth
      ? `b. ${bodyBirth}`
      : bodyDeath
        ? `d. ${bodyDeath}`
        : "";

// Template form — kept as the FALLBACK for profiles with no prose, and with the
// unknown-date placeholder suppressed so it never prints "(? – ?)".
const templateDescription = [
  person.display_name,
  yearText ? `(${yearText})` : "",
  `— Telfer family history.`,
  genNote,
  livingNote,
].join(" ").replace(/\s+/g, " ").trim().slice(0, 158).trim();

// FIRST PROSE SENTENCE from the person's own body. formatBody has already turned the
// vault markdown into HTML with inline links; strip the tags, drop a leading heading,
// and take the first real sentence. This is page content, not boilerplate, so it
// carries the occupation/place/story the template never could.
// FIRST PROSE SENTENCE — block-classified, not regex-stripped.
//
// WHY THIS EXISTS (card itc-20261026-1): the old version stripped every tag from the
// rendered HTML and took "the first sentence" of whatever fell out. That welds a table
// header onto its cells — "<th>Relation</th><th>Name</th><td>Father</td><td>James…"
// became the sentence "Family Relation Name Father James Telfer…" — and it turns
// "<strong>Born:</strong> 1786<br>" into "… Born: 1786 Died: …". 122 of 816 person
// pages shipped labels as their Google snippet. Four regex patches made it worse
// (9 -> 77 -> 81 -> 150 pages leaking, two of them deleting the sentence's SUBJECT:
// "(1809 - 1895). was born on 2 February 1809"). Regexes cannot separate a label from
// a sentence, because the difference is STRUCTURAL, not lexical — "Father" is a
// perfectly good word. So: classify blocks, delete the structures that are never
// prose, then take the first block that is genuinely a sentence.
//
// RULE: a table cell (td/th), a heading (h1-h6), a list item that is a key:value pair,
// a <br>-separated field line, a blockquote, a figcaption and a link-only paragraph are
// NEVER prose. Everything else is a candidate; the first candidate with a real sentence
// wins.
const ENTITIES = [
  [/&amp;/g, " and "],
  [/&#38;/g, " and "],
  [/&lt;|&gt;|&#60;|&#62;/g, " "],
  [/&nbsp;/g, " "],
  [/&#39;|&rsquo;|&lsquo;|&#8217;|&#8216;/g, "'"],
  [/&quot;|&ldquo;|&rdquo;|&#34;|&#8220;|&#8221;/g, '"'],
  [/&mdash;|&#8212;/g, "\u2014"],
  [/&ndash;|&#8211;/g, "\u2013"],
];
function decodeText(t) {
  let s = String(t || "");
  for (const [re, to] of ENTITIES) s = s.replace(re, to);
  // Any remaining numeric entity: keep safe punctuation, drop control-ish codes.
  s = s.replace(/&#(\d+);/g, (_, n) => {
    const c = Number(n);
    return c === 39 ? "'" : c === 34 ? '"' : c === 8212 ? "\u2014" : c === 8211 ? "\u2013" : " ";
  });
  return s
    .replace(/\s+/g, " ")
    // Tag stripping leaves a space before punctuation: "1856 , the son of X ."
    .replace(/\s+([,.;:!?])/g, "$1")
    .replace(/\(\s+/g, "(")
    .replace(/\s+\)/g, ")")
    .trim();
}
// A sentence ends at . ! or ? followed by whitespace+capital (or end of text).
// Bail on abbreviations that can end mid-sentence.
function firstSentence(text) {
  const t = decodeText(text);
  if (!t) return "";
  const m = t.match(/^(.{40,}?[.!?])(?=\s+[A-Z"\u201c'(]|\s*$)/);
  if (!m) return "";
  const s = m[1].trim();
  if (/\b(Mr|Mrs|Ms|Dr|Rev|St|b|d|m|m\.|b\.|d\.|c|ca|cf|no|vol|p|pp)\.$/.test(s)) return "";
  return s;
}
// Is this text a structural label / field line / source note rather than prose?
// A CLEAN chunk is one a reader would accept as a description. The parser prefers clean
// chunks and only falls back to label-shaped ones when nothing else exists — that
// fallback is what lets "Spouse: Elsie Ada Williams (m. 1894)" leak, so it is ordered:
// real prose first, then any full sentence, then any non-empty text, never a source note.
// Marks (⚠️, ✅, 📌) are stripped before pattern matching: a warning box starts with an
// emoji, so testing the raw start missed "⚠️ Same-name note:" entirely and let the trap
// warning become the description (james-telfer-1762).
const LEAD_MARKS = /^[\u2190-\u21FF\u2600-\u27BF\uFE0F\u2B00-\u2BFF\s]+/;
// Paragraphs that are GOOD writing and BAD descriptions, in every tier. Straight reject:
// no ranking, no fallback. Each one is housekeeping that belongs on the page and never
// in a search result. Tier (b) of firstProseSentence() once let the same-name warning
// through because it is a complete, well-formed sentence — relevance is not the test,
// purpose is.
function isEditorialOnly(t) {
  const s = String(t || "").replace(LEAD_MARKS, "").trim();
  if (!s) return true;
  if (/^(Same-name note|Same name note|Disambiguation|Note on the name)\b/i.test(s)) return true;
  if (/^(Not yet sourced|Not yet verified|Awaiting|To confirm|Unconfirmed|Unverified)\b/i.test(s)) return true;
  if (/^(What is not known|What is known)\b/i.test(s)) return true;
  if (/^(Source|Sources|Source note|Note|Reference|References)\b/i.test(s)) return true;
  if (/^(Correction Notice|Previously listed|This is incorrect|Erratum)\b/i.test(s)) return true;
  if (/^(AWM|Roll of Honour|CWGC|Find a Grave|FindAGrave)\b/i.test(s)) return true;
  if (/^(Status|Research status|Confidence)\b/i.test(s)) return true;
  // BOOK-CITATION OPENERS. A line that begins with a book title exists to tell a
  // researcher where to look, not to describe a life: "A Telfer Family Tree
  // (Supplement 2008), p.65: printed entry — 6. Vera Jean LILLECRAPP, b. 17 Nov 1909".
  // The italic/bold styling is gone by this point, so match the shape instead.
  if (/^[^.!?:]{3,70}\((?:Supplement\s*)?(?:18|19|20)\d\d\)/.test(s)) return true;
  if (/^(?:From the Borders to the Bush|A Telfer Family Tree|The Telfer Family)\b/i.test(s)) return true;
  if (/\bprinted entry\b/i.test(s.slice(0, 60))) return true;
  // RECEIPTS. "## Receipt (why this page may be admitted)" exists so a human can audit
  // how a thin profile got past the admission gate. Genuinely useful. Never a snippet.
  if (/^(Receipt|Admission|Why this page|Justification|Provenance)\b/i.test(s)) return true;
  // Dangling cross-reference fragments: a note that starts mid-thought about ANOTHER
  // page ("Already named in the vault on the parent page..."). If it opens with a
  // connective, the thing it refers to is not in the snippet, so it reads as nonsense.
  if (/^(Already|See also|As noted|As above|See above|Refer to|Cf\.|Compare)\b/i.test(s)) return true;
  // CHANGELOG LINES. "Profile enhanced from auto-generated stub." and "Stub entry filled
  // from primary sources, 24 Aug 2026." are notes about OUR editing, dated for our own
  // bookkeeping. 21 pages led with one. In a Google snippet that reads as "we tidied the
  // database" presented as a biography, and on mary-anne-mcintyre-1836 it SHADOWED a
  // real Life Summary sitting further down the page.
  if (/^(Stub entry|Profile enhanced|Enhanced from|Auto-generated|Placeholder|Filled from)\b/i.test(s)) return true;
  if (/^(Name and birth-year|Name and date|Birth-year|Name correction|Correction)\b/i.test(s)) return true;
  if (/^(Verified across|Verified against|Checked against|Cross-checked)\b/i.test(s)) return true;
  if (/^(Added|Updated|Recorded|Created|Written)\b[^.!?]{0,40}\b(19|20)\d\d\b/i.test(s)) return true;
  // A bare changelog with a trailing date: "... , 24 Aug 2026." / "... — 19 September 2026."
  if (/\b\d{1,2}\s+(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\s+(?:19|20)\d\d\b\.?\s*$/.test(s) && s.split(/\s+/).length < 22) return true;
  return false;
}
function looksLikeLabel(t) {
  const s = String(t || "").replace(LEAD_MARKS, "").trim();
  if (!s) return true;
  // A SHORT lead-in ending in a colon is a field label: "Born: 1786", "Spouse: X".
  //
  // BUT a bold lead-in at the start of a PARAGRAPH is a rhetorical opener, not a field:
  // "**What is known:** she was born in Roxburghshire around 1829." is a good sentence
  // wearing a hat. The earlier version of this rule killed that paragraph and left whole
  // honest pages with no description at all (margaret-telfer-1829). The difference is the
  // SHAPE OF THE TAIL: a field line's value is a fragment ("1786", "James Telfer (1761–1845)"),
  // an opener's tail is a clause with a verb in it. Ask for a full stop and 8+ words.
  // HARD REJECTIONS run before the generic colon heuristic. Each of these is a good
  // paragraph and a terrible description, and testing them after a generic "Word:" rule
  // means a longer label ("Same-name note:") never gets reached.
  // Same-name trap warnings exist to stop researchers merging two men into one — never
  // a snippet. "Not yet sourced"/"What is not known" are honest ledgers, not a shopfront.
  if (/^(Same-name note|Same name note|Disambiguation|Note on the name)\b/i.test(s)) return true;
  if (/^(Not yet sourced|Not yet verified|Awaiting|To confirm|Unconfirmed|Unverified)\b/i.test(s)) return true;
  if (/^What is not known:/i.test(s)) return true;
  if (/^(Source|Sources|Source note|Note|Reference|References)\b/i.test(s)) return true;
  if (/^(Correction Notice|Previously listed|This is incorrect|Erratum)\b/i.test(s)) return true;
  if (/^(AWM|Roll of Honour|CWGC|Find a Grave|FindAGrave)\b/i.test(s)) return true;
  const FIELD_LEAD = /^[A-Z][A-Za-z\-']{0,14}(?: [A-Z][A-Za-z\-']{0,14})?:\s+(.*)$/.exec(s);
  if (FIELD_LEAD) {
    const tail = FIELD_LEAD[1].trim();
    const proseTail = /[.!?]/.test(tail) && tail.split(/\s+/).length >= 8;
    if (!proseTail) return true;
    // It is prose with a bold opener — but "What is known:" is our own editorial label,
    // and a description should read as the sentence, not as the label. Prefer a cleaner
    // chunk if one exists; if not, the caller strips the opener before using it.
  }
  // Provenance boilerplate — a note to the editor, not to a reader.
  if (/^(Source|Sources|Source note|Note|Reference|References)\b/i.test(s)) return true;
  // A CITATION is not a description. "A Telfer Family Tree (2008), p.276 — family
  // record: …" tells a searcher which book we own, not who the person was. Detect a
  // leading source reference: a title/year/p. combination, or a bare "Author (Year)".
  if (/^[^.!?:]{0,80}\(\s*(?:1[6-9]|20)\d\d\s*\)[^.!?]{0,20}(?:,|\u2014|\s-)/.test(s)) return true;
  if (/\b(?:p\.|pp\.|p\.\s?\d+|page)\s?\d+/.test(s.slice(0, 90))) return true;
  if (/^(?:A |The )?[A-Z][A-Za-z ]{2,40}(?:Family|Tree|History|Records?)\b/.test(s.slice(0, 50))) return true;
  // Correction notices are editorial housekeeping ("Previously listed as …",
  // "⚠️ Correction Notice"). A searcher needs the fact, not the audit trail.
  if (/^(Correction Notice|Previously listed|This is incorrect|Erratum)\b/i.test(s)) return true;
  if (/^\u26a0/i.test(s)) return true;
  // Same-name trap warnings: the single most useful paragraph on a page that has one,
  // and the single worst description — the box exists to stop researchers merging two
  // men, not to introduce one. Never a snippet.
  if (/^(Same-name note|Same name note|Disambiguation|Note on the name)\b/i.test(s)) return true;
  // Editorial "we haven't got this yet" notes. Honest, and the honour belongs on the
  // page. A snippet that leads with what we lack sells the person short.
  if (/^(Not yet sourced|Not yet verified|Awaiting|To confirm|Unconfirmed|Unverified)\b/i.test(s)) return true;
  // "What is not known:" — the honest companion to "What is known:". A description is a
  // shopfront; this is the ledger. Keep it on the page, out of the snippet.
  if (/^What is not known:/i.test(s)) return true;
  // War-memorial database records. Real information, but a list entry, not prose.
  if (/^(AWM|Roll of Honour|CWGC|Find a Grave|FindAGrave)\b/i.test(s)) return true;
