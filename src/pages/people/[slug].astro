const combinedSchema = faqSchema ? [personSchema, faqSchema] : personSchema;
---
 
<BaseLayout
  title={seoTitle}
  description={seoOverride?.description || seoDescription}
  canonicalPath={`/people/${person.slug}/`}
  ogType="profile"
  ogImage={ogImage}
  schema={combinedSchema}
  faqItems={faqItems}
  storyBlurb={storyBlurb}
  navState={person.children.length > 0 || person.spouses.length > 0 || person.parents.length > 0 || person.siblings.length > 0 ? { slug: person.slug, showDescendants: person.children.length > 0, showFamily: person.spouses.length > 0 || person.parents.length > 0 || person.siblings.length > 0 } : null}
  noindex={isNoIndex}
>
  <div class="max-w-4xl mx-auto">
    <!-- Breadcrumb -->
    <div class="text-sm text-[var(--color-muted)] mb-1.5">
      <a href={import.meta.env.BASE_URL + "people/"} class="text-[var(--color-link)]">People</a>
      <span class="mx-2">/</span>
      <span>{person.display_name}</span>
    </div>

    <!-- Header Card -->
    <div class="person-card rounded-xl p-3 md:p-4 mb-3">
      <div class="flex items-start justify-between gap-2">
        <div class="flex-1">
          <h1 class="text-xl md:text-2xl font-bold font-serif text-[var(--color-heading)] mb-0.5">
            {person.display_name}
          </h1>

          <!-- Lifespan -->
          <div class="text-sm text-[var(--color-ink-light)] mb-1">
            {heroLifespan}
          </div>

          <!-- Full date of birth — SAME rule for living and deceased.
               Shown whenever the vault records a full date; the lifespan above
               stays year-only, so this adds precision without changing it. -->
          {person.birth_date && (
            <div class="text-sm text-[var(--color-ink-light)] mb-1">
              <span class="text-[var(--color-muted)]">Born:</span>{" "}
              {person.birth_date}{person.birth_place ? `, ${person.birth_place}` : ""}
            </div>
          )}

          <!-- Roles -->
          {visibleRoles.length > 0 && (
            <div class="space-y-0">
              {visibleRoles.map((role) => (
                <div class="text-xs text-[var(--color-ink-light)] italic" set:html={inlineLinks(role, telferPeople)} />
              ))}
            </div>
          )}
        </div>

        {/* Portrait Photo or Initials Avatar */}
        {person.person_photo ? (
          <div class="w-16 h-16 md:w-20 md:h-20 rounded-full overflow-hidden border-2 border-[var(--color-highlight)] shrink-0 bg-[var(--color-surface)]">
            <img
              src={import.meta.env.BASE_URL + person.person_photo}
              alt={person.display_name}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        ) : (
          <div class="w-12 h-12 md:w-16 md:h-16 rounded-full bg-[var(--color-heading)] text-white flex items-center justify-center text-lg md:text-xl font-serif font-bold shrink-0">
            {person.first_name?.[0]}{person.last_name?.[0]}
          </div>
        )}
      </div>
    </div>

    <!-- Evidence provenance banner. Renders only when the vault has recorded a
         rating, and always BELOW the name so it frames everything read after it. -->
    {evidenceNote && (
      <div
        class:list={[
          "mb-1.5 rounded-xl border px-2.5 py-1.5",
          evidenceNote.tier === "single"
            ? "border-amber-400/60 bg-amber-50 dark:border-amber-500/40 dark:bg-amber-950/30"
            : evidenceNote.tier === "verified"
              ? "border-emerald-400/60 bg-emerald-50 dark:border-emerald-500/40 dark:bg-emerald-950/30"
              : "border-sky-400/60 bg-sky-50 dark:border-sky-500/40 dark:bg-sky-950/30",
        ]}
        data-evidence-tier={evidenceNote.tier}
      >
        <p class="text-[11px] font-semibold uppercase tracking-wide text-[var(--color-heading)] mb-0">
          {evidenceNote.title}
        </p>
        <p class="text-[11px] leading-snug text-[var(--color-text-muted)] mt-0.5 mb-0">
          {evidenceNote.body}
        </p>
      </div>
    )}

    <div class="grid grid-cols-1 md:grid-cols-3 gap-1.5">
      <!-- Main Content -->
      <div class="md:col-span-2">
        <div class="person-card rounded-xl p-2.5">
          {hasBio && (
            <>
              <h2 class="font-serif text-base text-[var(--color-heading)] mb-0">Biography</h2>

              <!-- Wiki-formatted body (first h1 stripped, leading empty paragraphs + whitespace removed, prose tightened) -->
              <div class="prose prose-sm max-w-none wiki-content" set:html={bodyHtmlClean}></div>
              <style define:vars={{}}>
                .wiki-content > :first-child { margin-top: 0 !important; }
              </style>
            </>
          )}

          {!hasBio && (
            <div class="privacy-hold">
              <h2 class="font-serif text-base text-[var(--color-heading)] mb-1">
                Profile in progress
              </h2>
              <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
                {person.is_living
                  ? "No death is recorded for this person, so their details are deliberately not published here — a privacy hold, not a gap in the record. Name, family position and relationship links are shown; dates, places and life events are held back by choice."
                  : "This person is recorded in the family tree, but no biography has been written yet. Their position in the family and any relationship links are shown above."}
              </p>
            </div>
          )}
        </div>

        <!-- Photo Gallery -->
        {galleryImages.length > 0 && (
          <div class="person-card rounded-xl p-3 mt-3">
            <h2 class="font-serif text-sm text-[var(--color-heading)] mb-2">Photos</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
              {galleryImages.map((img) => (
                <figure class="m-0">
                  <img
                    src={import.meta.env.BASE_URL + img.src}
                    alt={stripWikiLinks(img.alt)}
                    class="w-full h-auto rounded-lg border border-[var(--color-border)] object-contain bg-[var(--color-surface)]"
                    loading="lazy"
                    style="max-height: 300px;"
                  />
                  <figcaption class="text-xs text-[var(--color-muted)] mt-1 text-center" set:html={inlineLinks(img.alt, telferPeople)} />
                </figure>
              ))}
            </div>
          </div>
        )}

        <!-- Tags -->
        {importantTags.length > 0 && (
          <div class="person-card rounded-xl p-3 mt-3">
            <h2 class="font-serif text-sm text-[var(--color-heading)] mb-1.5">Tags</h2>
            <div class="flex flex-wrap gap-1">
              {importantTags.map((tag) => (
                <span class="text-xs px-2 py-0.5 rounded-full border border-[var(--color-border)] text-[var(--color-muted)]">{tag}</span>
              ))}
            </div>
          </div>
        )}

        <!-- DNA Connections -->
        {person.dna_matches?.length > 0 && (
          <div class="person-card rounded-xl p-3 mt-3">
            <h2 class="font-serif text-sm text-[var(--color-heading)] mb-2">DNA Matches</h2>
            <dl class="space-y-3">
              {person.dna_matches.map((match, i) => (
                <div class="border-l-2 border-[var(--color-highlight)] pl-3">
                  <dt class="font-medium text-sm">{match.name}</dt>
                  <dd class="text-xs text-[var(--color-ink-light)] mt-0.5">
                    {match.relationship} — {match.centimorgans} cM
                    {match.company && ` (${match.company})`}
                  </dd>
                  {match.notes && <dd class="text-xs text-[var(--color-muted)] mt-0.5 italic">{match.notes}</dd>}
                </div>
              ))}
            </dl>
          </div>
        )}

        {person.haplogroup_mt && (
          <div class="person-card rounded-xl p-3 mt-3">
            <h2 class="font-serif text-sm text-[var(--color-heading)] mb-1">Maternal Haplogroup</h2>
