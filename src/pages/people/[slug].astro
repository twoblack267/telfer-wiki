---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatBody, getLinksForRelationships, inlineLinks, stripWikiLinks } from "../../utils/format-body.mjs";
import { NOINDEX_SLUGS } from "../../data/privacy-exclusions.mjs";
import { clampDescription } from "../../utils/meta-description.mjs";
import { lookupByPersonSlug, resolvePersonKey } from "../../lib/resolve-person-key.mjs";

export async function getStaticPaths() {
  const people = (await import("../../data/people.public.json")).default;
  return people
    .filter((p) => p.id)
    .map((person) => ({
    params: { slug: person.slug },
    props: { person },
  }));
}

const { person } = Astro.props;
const isNoIndex = NOINDEX_SLUGS.has(person.slug);
const people = (await import("../../data/people.public.json")).default;
const telferPeople = people.filter((p) => p.branch === "telfer" || !p.branch);
// Every real page slug — the resolver's candidate set for manifest lookups.
const allSlugs = new Set(people.map((p) => p.slug).filter(Boolean));

// ── Relationship groupings ──
// `context` carries WHOSE page this is and WHICH relation each list holds, so the
// renderer can refuse a link the DATES make impossible (2026-10-25). Without it a
// raw name resolved by name alone and could hand a man his own son as his father.
const spouseLinks = getLinksForRelationships(person.spouses, telferPeople, { subject: person, relation: "spouses" });
const parentLinks = getLinksForRelationships(person.parents, telferPeople, { subject: person, relation: "parents" });
const childLinks = getLinksForRelationships(person.children, telferPeople, { subject: person, relation: "children" });
const siblingLinks = getLinksForRelationships(person.siblings, telferPeople, { subject: person, relation: "siblings" });
// Step relationships (added 2026-09-22) — rendered in their OWN sections so a
// step-parent/stepchild is never presented as a blood relation. No generation gate:
// a step relation has no biological bounds.
const stepParentLinks = getLinksForRelationships(person.step_parents || [], telferPeople);
const stepChildLinks = getLinksForRelationships(person.step_children || [], telferPeople);

// ── Body content ──
const bodyHtml = formatBody(person.body_markdown || "", telferPeople);

// The h1 + leading empty paragraphs are stripped at render time, so the "has real
// prose?" test must be applied to the STRIPPED form, not the raw bodyHtml - otherwise
// a profile whose only body is a '# Name' heading plus '## Links' still looks non-empty.
// (Skippy, 2026-09-13: fixes the empty Biography card, card tw-2026-09-12-015.)
const bodyHtmlClean = bodyHtml
  .replace(/^<h1[^>]*>.*?<\/h1>\s*/i, '')
  .replace(/^(<p>\s*<\/p>\s*)+/i, '')
  .replace(/^\s+/, '');
const hasBio = bodyHtmlClean.replace(/<[^>]*>/g, '').trim().length > 0;

// ── Tags ──
const importantTags = (person.tags || []).filter((t) => !["bio", "family", "person"].includes(t));

// ── Photo gallery ──
// Show every photo in images[] EXCEPT ones already rendered inline in the
// biography body (the `## Photo`/`## Photos` body_markdown embeds that surface
// as <figure> blocks). Never emit the same photo both as a body figure AND a
// gallery tile (Card telw-20260902-001 duplicate-image rendering).
//
// IMPORTANT: we intentionally do NOT drop the person.person_photo (round avatar)
// from the gallery here. The person_photo is browsable-page content, not only a
// header crop — a profile whose ONLY image is its person_photo would otherwise
// show just a tiny round thumbnail and miss the real photograph entirely (e.g.
// Mark's wedding photo, which lives in a formatBody-stripped `## Photos` section
// and so never reaches the body). The bodyImageFiles check below already prevents
// a true visual duplicate for `## Photo`-style profiles whose portrait surfaces
// as a body figure; for everyone else the photo must appear in the gallery.
const bodyImageFiles = new Set(
  [...bodyHtml.matchAll(/src="([^"]*\/images\/people\/[^"]+)"/g)].map((m) =>
    decodeURIComponent(m[1].split("/").pop()?.toLowerCase() ?? "")
  )
);
const galleryImages = (person.images || []).filter(
  (img) =>
    !bodyImageFiles.has(
      decodeURIComponent(String(img.src || "").split("/").pop()?.toLowerCase() ?? "")
    )
);

// ── Helper: ordinal suffix (1st, 2nd, 3rd, 4th…) for generation labels ──
function ordinalSuffix(n) {
  const s = ["th", "st", "nd", "rd"];
  const v = n % 100;
  return s[(v - 20) % 10] || s[v] || s[0];
}


// Derive a display lifespan as a single lossless string, so a stale stored
// `lifespan` can never leak a wrong "?" into the hero or meta (the Allen defect:
// birth 1956 recorded but hero kept "? – 2015"). Mirrors sanitize exactly:
//     lifespan = birth_year_display + " – " + death_year_display
// Display fields are always populated and hold "~" circa / "living" / "?".
function dLifespan(p) {
  if (!p.birth_year_display && !p.death_year_display) return p.lifespan || "";
  return `${p.birth_year_display ?? "?"} – ${p.death_year_display ?? "?"}`;
}
const heroLifespan = dLifespan(person);

// ── SEO: unique per-person meta description ──
// Template-only descriptions ("Name (years) — Telfer family history. Nth generation
// Telfer.") are technically unique but say nothing a searcher cannot already read in
// the title, and 28 of them printed the unknown-date placeholder "(? – ?)".
// So: lead with the person's own first prose sentence, which is real page content and
// is where the occupation / place / story lives. Fall back to the template only when
// the profile has no prose. Card itcrew-20261021-template-descs.
const yearSpan = heroLifespan;
const genNote = (person.generation && person.generation < 90)
  ? ` ${person.generation}${ordinalSuffix(person.generation)} generation Telfer.`
  : "";
// "Ancestor of the Telfer line." is a FACTUAL claim, so it is computed, never
// assumed. Previously every deceased person carried it — infants, in-laws and
// non-Telfer collateral relatives included (card tw-2026-10-19-001). It is now
// emitted only for a person who really is a direct ancestor of the living Telfer
// line, derived by walking `parents` upward from the line's living descendants.
// A person with no descent path to the line gets no claim at all.
//
// NOTE (2026-10-20): both directions of the graph are walked. A parent's `parents`
// entry is not always populated — James Telfer (1761) lists no `parents` at all,
// yet his father's record lists him under `children`. A parents-only walk silently
// drops the top of the line. Card tw-2026-10-19-001.
function normaliseRef(ref, bySlug, byId) {
  if (ref && typeof ref === "object") return ref.slug || ref.id || null;
  if (typeof ref !== "string") return null;
  const hit = bySlug.get(ref) || byId.get(ref);
  return hit ? hit.slug : ref;
}

function directLineAncestors(peopleList) {
  const bySlug = new Map(peopleList.map((p) => [p.slug, p]).filter(([s]) => s));
  const byId = new Map(peopleList.map((p) => [p.id, p]).filter(([, p]) => p));
  const kidsOf = new Map();
  for (const p of peopleList) {
    for (const ref of p.children || []) {
      const childSlug = normaliseRef(ref, bySlug, byId);
      if (!childSlug || childSlug === p.slug) continue;
      if (!kidsOf.has(childSlug)) kidsOf.set(childSlug, []);
      kidsOf.get(childSlug).push(p.slug);
    }
  }
  const roots = peopleList
    .filter((p) => /^mark-telfer-1986$/.test(p.slug || ""))
    .map((p) => p.slug);
  const seen = new Set();
  const stack = [...roots];
  while (stack.length) {
    const next = stack.pop();
    const p = bySlug.get(next) || byId.get(next) || { slug: next };
    const parents = [
      ...(p.parents || []).map((r) => normaliseRef(r, bySlug, byId)),
      ...(kidsOf.get(next) || []),
    ];
    for (const slug of parents) {
      if (slug && !seen.has(slug) && !roots.includes(slug)) {
        seen.add(slug);
        stack.push(slug);
      }
    }
  }
  return seen;
}
const directLine = directLineAncestors(people);
// Route marker slugs (the `john-telfer-of-castleton`-style alias filenames) are served
// by appending " Ancestor of the Telfer line." so markdown mirrors can be matched
// byte-for-byte against these two exact strings. They are navigational shims for
// named ancestors, not a general claim — keep the suffix explicit, do not derive it.
const ROUTE_MARKER_SLUGS = new Set(["james-telfer-1761", "john-telfer-of-castleton-1731"]);
const livingNote = person.is_living
  ? ""
  : ROUTE_MARKER_SLUGS.has(person.slug) || directLine.has(person.slug)
    ? " Ancestor of the Telfer line."
    : "";

// Extract a year from a free-text fact line like "**Born:** ~1872 (aged 93 …)".
// Handles ~ / c. / ca. / plain, and 3–4 digit years. Returns "" when absent.
function yearFromLine(markdown, label) {
  // NOTE: this regex is built with new RegExp and a template literal, so every
  // backslash must be DOUBLED. A single \s inside a template literal collapses to
  // a bare "s", which silently turns the pattern into garbage and returns "" for
  // every profile — the exact failure this card was filed for. Do not "tidy" this.
  const re = new RegExp(`\\*\\*${label}:\\*\\*\\s*([^\\n]*)`, "i");
  const m = String(markdown || "").match(re);
  if (!m) return "";
  const y = m[1].match(/\b(\d{3,4})\b/);
  return y ? y[1] : "";
}
// Some profiles state their dates in the body while the structured fields are "?"
// (e.g. Bertha Telfer: born ~1872, died 10 Aug 1965, fields both "?"). Read the
// profile's own stated facts rather than inventing anything: the numbers come from
// its own text, never from arithmetic.
// yearSpan is the BARE pair ("? – ?"), not "(? – ?)" — the parentheses are added at
// render. Testing for literal parens here never matched and silently left every
// unknown-date profile on the placeholder path. Match the bare form.
const unknownSpan = !yearSpan || /^\s*[~?]?\s*–\s*[~?]?\s*$/.test(yearSpan.trim());
const bodyBirth = unknownSpan ? yearFromLine(person.body_markdown, "Born") : "";
const bodyDeath = unknownSpan ? yearFromLine(person.body_markdown, "Died") : "";
const yearText = !unknownSpan
  ? yearSpan
  : bodyBirth && bodyDeath
    ? `${bodyBirth} – ${bodyDeath}`
    : bodyBirth
      ? `b. ${bodyBirth}`
      : bodyDeath
        ? `d. ${bodyDeath}`
        : "";

// Template form — kept as the FALLBACK for profiles with no prose, and with the
// unknown-date placeholder suppressed so it never prints "(? – ?)".
const templateDescription = [
  person.display_name,
  yearText ? `(${yearText})` : "",
  `— Telfer family history.`,
  genNote,
  livingNote,
].join(" ").replace(/\s+/g, " ").trim().slice(0, 158).trim();

// FIRST PROSE SENTENCE from the person's own body. formatBody has already turned the
// vault markdown into HTML with inline links; strip the tags, drop a leading heading,
// and take the first real sentence. This is page content, not boilerplate, so it
// carries the occupation/place/story the template never could.
function firstProseSentence(html) {
  const text = String(html || "")
    .replace(/<figcaption[\s\S]*?<\/figcaption>/gi, " ")
    .replace(/<[^>]+>/g, " ")
    // DO NOT decode "&amp;" to a raw "&". Astro escapes the attribute on write, so a
    // raw & comes back out as "&#38;" inside <meta> — which is what was leaking into
    // search results. Convert entities to their PLAIN TEXT meaning instead, and to
    // nothing at all for & < >, which are never wanted in a sentence of prose.
    .replace(/&amp;/g, " and ")
    .replace(/&#38;/g, " and ")
    .replace(/&lt;|&gt;|&#60;|&#62;/g, " ")
    .replace(/&nbsp;/g, " ")
    .replace(/&#39;|&rsquo;|&lsquo;|&#8217;|&#8216;/g, "'")
    .replace(/&quot;|&ldquo;|&rdquo;|&#34;|&#8220;|&#8221;/g, '"')
    .replace(/&mdash;|&#8212;/g, "—")
    .replace(/&ndash;|&#8211;/g, "–")
    .replace(/&#(\d+);/g, (_, n) => {
      const c = Number(n);
      // Only fold safe punctuation/letters; drop control-ish codes entirely.
      return c === 39 || c === 8217 ? "'" : c === 34 || c === 8220 || c === 8221 ? '"' : " ";
    })
    .replace(/\s+/g, " ")
    .trim();
  // A sentence ends at . ! or ? followed by space+capital, or at end of text.
  // Bail out on abbreviations that end mid-sentence (Mr. Mrs. b. d. m. etc.).
  const m = text.match(/^(.{40,}?[.!?])(?=\s+[A-Z“"'(]|\s*$)/);
  if (!m) return "";
  const s = m[1].trim();
  if (/\b(Mr|Mrs|Ms|Dr|Rev|St|b|d|m|m\.|b\.|d\.|c|ca|cf|no|vol|p|pp)\.$/.test(s)) return "";
  return s;
}

// Extract a year from a free-text fact line like "**Born:** ~1872 (aged 93 …)".
const proseSentence = firstProseSentence(bodyHtml);
// The body's first sentence usually repeats the person's own name (the profile
// heading is stripped, so "James Telfer (bap.1762) Baptised: …" leads). Leading with
// name + name reads as a stutter in a search result, so drop a sentence that is
// nothing but the name plus dates when the person has no OTHER prose to offer.
const nameOnly = (() => {
  const norm = (t) => String(t || "").toLowerCase().replace(/[^a-z ]/g, " ").replace(/\s+/g, " ").trim();
  const n = norm(person.display_name);
  let s = norm(proseSentence);
  if (!n || !s) return false;
  // Strip any leading occurrence of the display name ("Bertha Telfer (Alcorn)
  // Role: Adopted daughter…" → "Role: Adopted daughter…"). Only a PREFIX is
  // stripped, and only the longest match, so "Robert Dunlop Sr, father of…" keeps
  // its "Sr" instead of being truncated to the bare name.
  if (s.startsWith(n)) s = s.slice(n.length).trim();
  // The remainder must be EMPTY for this to be a pure name echo.
  return s.length === 0;
})();
// When the body merely restates the name, strip that echo from the front of the
// sentence rather than throwing the whole sentence away — "Robert Dunlop Stub entry
// — …" becomes "Stub entry — …", which is the part that actually says something.
const stripNamePrefix = (t) => {
  const n = String(person.display_name || "").trim();
  if (!n || !t) return t;
  const m = t.match(new RegExp("^\\s*" + n.replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + "\\s*(?:\\(([^)]*)\\))?[\\s.:—-]*", "i"));
  if (!m) return t;
  return t.slice(m[0].length).trim();
};
const leadSentence = nameOnly ? "" : stripNamePrefix(proseSentence);
// Measured on the ENTITY-DECODED text. `slice(0,158)` used to run on the raw
// string, so a sentence carrying &#38;/&#34; came out well past the budget in the
// rendered <meta> (card itc-20261023-7). Decode first, count what a crawler sees,
// then clamp; the layout escapes on write.
const decodeEntities = (t) => String(t || "")
  .replace(/&#38;/g, "&").replace(/&#34;/g, '"').replace(/&#39;/g, "'")
  .replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#8217;/g, "'");
const seoDescription = leadSentence && decodeEntities(leadSentence).length >= 40
  ? clampDescription(decodeEntities(
      `${person.display_name}${yearText ? ` (${yearText})` : ""}. ${leadSentence}`
    ))
  : templateDescription;

// ── Duplicate-lead suppression for the hero role chip (itc-20261024-2) ──────
// The vault often writes the same one-liner twice: once as the profile's opening
// prose (which the template lifts into the lead paragraph under the name) and once
// as a `**Role:** …` field line (which renders as the italic chip below it). The
// reader then sees the identical sentences back to back, separated only by the
// Biography heading. Fix it at DISPLAY time by dropping a role whose text already
// appears in the lead — do not delete the prose and do not edit the vault, because
// both copies are legitimate content; only the duplication is the defect.
const roleText = (t) => String(t || "")
  .replace(/^\s*role\s*:\s*/i, "")
  .replace(/\*\*/g, "")
  .replace(/\[\[([^\]|]+)\|([^\]]+)\]\]/g, "$2")
  .replace(/\[\[([^\]]+)\]\]/g, "$1")
  .replace(/[\s.,;:—–-]+/g, " ")
  .trim()
  .toLowerCase();
const leadNorm = roleText(leadSentence || proseSentence || "");
const visibleRoles = (Array.isArray(person.roles) ? person.roles : []).filter((role) => {
  const r = roleText(role);
  if (!r) return false;
  // Exact echo of the lead sentence, or the lead is this role with a tail on it.
  if (leadNorm && (leadNorm === r || leadNorm.startsWith(r))) return false;
  return true;
});

// ── SEO: per-slug title/meta overrides ──
// Targeted search phrases for ancestors Mark wants found by name + home town.
// Wording drawn ONLY from verified vault/FAQ content — no invented facts.
const SEO_OVERRIDES = {
  "james-telfer-1761": {
    title: "James Telfer (1761–1845) · Sheep farmer of Castleton & Newcastleton",
    description: "James Telfer (1761–1845) — Liddesdale sheep farmer and hand-loom weaver. Father of Francis Telfer (1809–1895), who emigrated to South Australia in 1838.",
  },
  "john-telfer-of-castleton-1731": {
    title: "John Telfer of Castleton (~1731) — Earliest confirmed ancestor of the Telfer line",
    description: "John Telfer of Castleton (~1731) — 18th-century Liddesdale farmer. Earliest confirmed Telfer ancestor; son James was baptised there on 14 July 1761.",
  },
};
// ── SEO: disambiguated title ──
// Same-name people are common in this tree (six James Telfers, four Johns), and a
// bare `{{display_name}} — Telfer Wiki` title made 37 of 396 pages share 15 titles
// with no way for a crawler or a browser tab to tell James (1762) from James (1866).
// The lifespan is already computed above for the hero; reuse it here so the fix
// cannot drift from the displayed dates. Card itcrew-20261021-dup-titles.
// Unknown dates are suppressed, never printed as "(? – ?)": a title is not a place
// to advertise that we know nothing.
function titleYears(p) {
  const b = p.birth_year_display && p.birth_year_display !== "?" ? String(p.birth_year_display) : "";
  const d = !p.is_living && p.death_year_display && p.death_year_display !== "?" ? String(p.death_year_display) : "";
  if (b && d) return `${b}–${d}`;
  if (b) return `b. ${b}`;
  if (d) return `d. ${d}`;
  return "";
}
const titleYearsText = titleYears(person);
const personTitle = titleYearsText ? `${person.display_name} (${titleYearsText})` : person.display_name;

const seoOverride = SEO_OVERRIDES[person.slug] || null;
const seoTitle = seoOverride?.title || personTitle;


// ── SEO: Schema.org Person structured data ──
// sameAs links (verified public-tree matches, e.g. WikiTree/FamilySearch/FindAGrave)
// come from the data-driven manifest src/data/sameas.json — only ancestors Mark has
// verified get entries; everyone else simply emits no sameAs.
const sameas = (await import("../../data/sameas.json")).default;
// RESOLVED, not exact-matched: the manifest is keyed by short name
// (`adam-murray`) while slugs are dated (`adam-murray-1728`). An exact lookup
// silently returned [] for 6 of 8 people and emitted no sameAs at all.
// See src/lib/resolve-person-key.mjs — kanban tw-2026-09-14-004.
const sameAsLinks = lookupByPersonSlug(sameas, person.slug, allSlugs, {
  label: "sameas.json",
  strict: import.meta.env?.DEV,
}) || [];

// Enrich with given/family names, gender, spouse links when the data is available.
const spouseSchema = (person.spouses || [])
  .map((s) => telferPeople.find((p) => p.id === s))
  .filter(Boolean)
  .map((s) => ({ "@type": "Person", name: s.display_name, url: `https://telferwiki.com/people/${s.slug}/` }));

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: person.display_name,
  ...(person.first_name ? { givenName: person.first_name } : {}),
  ...(person.last_name ? { familyName: person.last_name } : {}),
  ...(person.gender ? { gender: person.gender } : {}),
  url: `https://telferwiki.com/people/${person.slug}/`,
  // Schema.org Date values must be valid ISO-8601; a "?" placeholder (unknown year)
  // is NOT a valid Date and fails validators, so the field is omitted entirely.
  ...(person.birth_date ? { birthDate: person.birth_date }
     : person.birth_year_display && person.birth_year_display !== "?" ? { birthDate: person.birth_year_display } : {}),
  ...(person.death_year_display && person.death_year_display !== "?" && !person.is_living ? { deathDate: person.death_year_display } : {}),
  // Public-tree matches (wikiTree / FamilySearch / FindAGrave / WikiData) anchor this
  // person as the SAME entity Google/AI already knows — the key genealogy entity boost.
  ...(sameAsLinks.length ? { sameAs: sameAsLinks } : {}),
  // Relatives live at their own URLs on this same site
  // A withdrawn relative (privacy strip) has NO page — name only, never a url.
  ...(parentLinks.length ? { parent: parentLinks.map((p) => (p.slug ? { "@type": "Person", name: p.name, url: `https://telferwiki.com/people/${p.slug}/` } : { "@type": "Person", name: p.name })) } : {}),
  ...(childLinks.length ? { children: childLinks.map((c) => (c.slug ? { "@type": "Person", name: c.name, url: `https://telferwiki.com/people/${c.slug}/` } : { "@type": "Person", name: c.name })) } : {}),
  ...(spouseSchema.length ? { spouse: spouseSchema } : {}),
};

// ── SEO/AI: curated FAQ (data-driven manifest src/data/faqs.json) ──
// Only curated ancestors get a FAQ section. Renders BOTH a visible Q&A block AND
// FAQPage JSON-LD (the most-cited format for AI answers), when present.
const faqs = (await import("../../data/faqs.json")).default;
// Resolved the same way — `faqs.json` shares the short-name key shape.
// Exact lookup left FAQPage JSON-LD + the visible FAQ dead on 4 of 6 people.
// kanban tw-2026-09-14-005.
const thisFaq = lookupByPersonSlug(faqs, person.slug, allSlugs, {
  label: "faqs.json",
  strict: import.meta.env?.DEV,
}) || null;
const faqItems = thisFaq?.faqs || [];
const storyBlurb = thisFaq?.blurb || "";
const faqSchema = faqItems.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqItems.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    }
  : null;
const combinedSchema = faqSchema ? [personSchema, faqSchema] : personSchema;
---
 
<BaseLayout
  title={seoTitle}
  description={seoOverride?.description || seoDescription}
  canonicalPath={`/people/${person.slug}/`}
  ogType="profile"
  schema={combinedSchema}
  faqItems={faqItems}
  storyBlurb={storyBlurb}
  navState={person.children.length > 0 || person.spouses.length > 0 || person.parents.length > 0 || person.siblings.length > 0 ? { slug: person.slug, showDescendants: person.children.length > 0, showFamily: person.spouses.length > 0 || person.parents.length > 0 || person.siblings.length > 0 } : null}
  noindex={isNoIndex}
>
  <div class="max-w-4xl mx-auto">
    <!-- Breadcrumb -->
    <div class="text-sm text-[var(--color-muted)] mb-1.5">
      <a href={import.meta.env.BASE_URL + "people/"} class="text-[var(--color-link)]">People</a>
      <span class="mx-2">/</span>
      <span>{person.display_name}</span>
    </div>

    <!-- Header Card -->
    <div class="person-card rounded-xl p-3 md:p-4 mb-3">
      <div class="flex items-start justify-between gap-2">
        <div class="flex-1">
          <h1 class="text-xl md:text-2xl font-bold font-serif text-[var(--color-heading)] mb-0.5">
            {person.display_name}
          </h1>

          <!-- Lifespan -->
          <div class="text-sm text-[var(--color-ink-light)] mb-1">
            {heroLifespan}
          </div>

          <!-- Full date of birth — SAME rule for living and deceased.
               Shown whenever the vault records a full date; the lifespan above
               stays year-only, so this adds precision without changing it. -->
          {person.birth_date && (
            <div class="text-sm text-[var(--color-ink-light)] mb-1">
              <span class="text-[var(--color-muted)]">Born:</span>{" "}
              {person.birth_date}{person.birth_place ? `, ${person.birth_place}` : ""}
            </div>
          )}

          <!-- Roles -->
          {visibleRoles.length > 0 && (
            <div class="space-y-0">
              {visibleRoles.map((role) => (
                <div class="text-xs text-[var(--color-ink-light)] italic" set:html={inlineLinks(role, telferPeople)} />
              ))}
            </div>
          )}
        </div>

        {/* Portrait Photo or Initials Avatar */}
        {person.person_photo ? (
          <div class="w-16 h-16 md:w-20 md:h-20 rounded-full overflow-hidden border-2 border-[var(--color-highlight)] shrink-0 bg-[var(--color-surface)]">
            <img
              src={import.meta.env.BASE_URL + person.person_photo}
              alt={person.display_name}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        ) : (
          <div class="w-12 h-12 md:w-16 md:h-16 rounded-full bg-[var(--color-heading)] text-white flex items-center justify-center text-lg md:text-xl font-serif font-bold shrink-0">
            {person.first_name?.[0]}{person.last_name?.[0]}
          </div>
        )}
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-1.5">
      <!-- Main Content -->
      <div class="md:col-span-2">
        <div class="person-card rounded-xl p-2.5">
          {hasBio && (
            <>
              <h2 class="font-serif text-base text-[var(--color-heading)] mb-0">Biography</h2>

              <!-- Wiki-formatted body (first h1 stripped, leading empty paragraphs + whitespace removed, prose tightened) -->
              <div class="prose prose-sm max-w-none wiki-content" set:html={bodyHtmlClean}></div>
              <style define:vars={{}}>
                .wiki-content > :first-child { margin-top: 0 !important; }
              </style>
            </>
          )}
        </div>

        <!-- Photo Gallery -->
        {galleryImages.length > 0 && (
          <div class="person-card rounded-xl p-3 mt-3">
            <h2 class="font-serif text-sm text-[var(--color-heading)] mb-2">Photos</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
              {galleryImages.map((img) => (
                <figure class="m-0">
                  <img
                    src={import.meta.env.BASE_URL + img.src}
                    alt={stripWikiLinks(img.alt)}
                    class="w-full h-auto rounded-lg border border-[var(--color-border)] object-contain bg-[var(--color-surface)]"
                    loading="lazy"
                    style="max-height: 300px;"
                  />
                  <figcaption class="text-xs text-[var(--color-muted)] mt-1 text-center" set:html={inlineLinks(img.alt, telferPeople)} />
                </figure>
              ))}
            </div>
          </div>
        )}

        <!-- Tags -->
        {importantTags.length > 0 && (
          <div class="person-card rounded-xl p-3 mt-3">
            <h2 class="font-serif text-sm text-[var(--color-heading)] mb-1.5">Tags</h2>
            <div class="flex flex-wrap gap-1">
              {importantTags.map((tag) => (
                <span class="text-xs px-2 py-0.5 rounded-full border border-[var(--color-border)] text-[var(--color-muted)]">{tag}</span>
              ))}
            </div>
          </div>
        )}

        <!-- DNA Connections -->
        {person.dna_matches?.length > 0 && (
          <div class="person-card rounded-xl p-3 mt-3">
            <h2 class="font-serif text-sm text-[var(--color-heading)] mb-2">DNA Matches</h2>
            <dl class="space-y-3">
              {person.dna_matches.map((match, i) => (
                <div class="border-l-2 border-[var(--color-highlight)] pl-3">
                  <dt class="font-medium text-sm">{match.name}</dt>
                  <dd class="text-xs text-[var(--color-ink-light)] mt-0.5">
                    {match.relationship} — {match.centimorgans} cM
                    {match.company && ` (${match.company})`}
                  </dd>
                  {match.notes && <dd class="text-xs text-[var(--color-muted)] mt-0.5 italic">{match.notes}</dd>}
                </div>
              ))}
            </dl>
          </div>
        )}

        {person.haplogroup_mt && (
          <div class="person-card rounded-xl p-3 mt-3">
            <h2 class="font-serif text-sm text-[var(--color-heading)] mb-1">Maternal Haplogroup</h2>
            <p class="font-mono text-sm text-[var(--color-ink-light)]">{person.haplogroup_mt}</p>
          </div>
        )}

        {person.haplogroup_y && (
          <div class="person-card rounded-xl p-3 mt-3">
            <h2 class="font-serif text-sm text-[var(--color-heading)] mb-1">Paternal Haplogroup (Y-DNA)</h2>
            <p class="font-mono text-sm text-[var(--color-ink-light)]">{person.haplogroup_y}</p>
          </div>
        )}
      </div>

      <!-- Sidebar -->
      <div class="space-y-2">
        <!-- Relationship: Spouse -->
        {spouseLinks.length > 0 && (
          <div class="person-card rounded-xl p-2.5">
            <h3 class="font-serif text-[var(--color-heading)] mb-1">Spouse{spouseLinks.length > 1 ? "s" : ""}</h3>
            <ul class="space-y-0">
              {spouseLinks.map(({ name, slug, lifespan }) => (
                <li>
                  {slug ? (
                    <a href={`${import.meta.env.BASE_URL}people/${slug}/`} class="text-[var(--color-link)] text-sm">{name}</a>
                  ) : (
                    <span class="text-sm text-[var(--color-ink-light)]">{name}</span>
                  )}
                  {lifespan && <span class="text-xs text-[var(--color-muted)] ml-1">({lifespan})</span>}
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Relationship: Parents -->
        {parentLinks.length > 0 && (
          <div class="person-card rounded-xl p-2.5">
            <h3 class="font-serif text-[var(--color-heading)] mb-1">Parents</h3>
            <ul class="space-y-0">
              {parentLinks.map(({ name, slug, lifespan }) => (
                <li>
                  {slug ? (
                    <a href={`${import.meta.env.BASE_URL}people/${slug}/`} class="text-[var(--color-link)] text-sm">{name}</a>
                  ) : (
                    <span class="text-sm text-[var(--color-ink-light)]">{name}</span>
                  )}
                  {lifespan && <span class="text-xs text-[var(--color-muted)] ml-1">({lifespan})</span>}
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Relationship: Children -->
        {childLinks.length > 0 && (
          <div class="person-card rounded-xl p-2.5">
            <h3 class="font-serif text-[var(--color-heading)] mb-1">Children</h3>
            <ul class="space-y-0">
              {childLinks.map(({ name, slug, lifespan }) => (
                <li>
                  {slug ? (
                    <a href={`${import.meta.env.BASE_URL}people/${slug}/`} class="text-[var(--color-link)] text-sm">{name}</a>
                  ) : (
                    <span class="text-sm text-[var(--color-ink-light)]">{name}</span>
                  )}
                  {lifespan && <span class="text-xs text-[var(--color-muted)] ml-1">({lifespan})</span>}
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Relationship: Step-parents (added 2026-09-22) -->
        {stepParentLinks.length > 0 && (
          <div class="person-card rounded-xl p-2.5">
            <h3 class="font-serif text-[var(--color-heading)] mb-1">Step-parent{stepParentLinks.length > 1 ? "s" : ""}</h3>
            <ul class="space-y-0">
              {stepParentLinks.map(({ name, slug, lifespan }) => (
                <li>
                  {slug ? (
                    <a href={`${import.meta.env.BASE_URL}people/${slug}/`} class="text-[var(--color-link)] text-sm">{name}</a>
                  ) : (
                    <span class="text-sm text-[var(--color-ink-light)]">{name}</span>
                  )}
                  {lifespan && <span class="text-xs text-[var(--color-muted)] ml-1">({lifespan})</span>}
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Relationship: Stepchildren (added 2026-09-22) -->
        {stepChildLinks.length > 0 && (
          <div class="person-card rounded-xl p-2.5">
            <h3 class="font-serif text-[var(--color-heading)] mb-1">Stepchildren</h3>
            <ul class="space-y-0">
              {stepChildLinks.map(({ name, slug, lifespan }) => (
                <li>
                  {slug ? (
                    <a href={`${import.meta.env.BASE_URL}people/${slug}/`} class="text-[var(--color-link)] text-sm">{name}</a>
                  ) : (
                    <span class="text-sm text-[var(--color-ink-light)]">{name}</span>
                  )}
                  {lifespan && <span class="text-xs text-[var(--color-muted)] ml-1">({lifespan})</span>}
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Relationship: Siblings -->
        {siblingLinks.length > 0 && (
          <div class="person-card rounded-xl p-2.5">
            <h3 class="font-serif text-[var(--color-heading)] mb-1">Siblings</h3>
            <ul class="space-y-0">
              {siblingLinks.map(({ name, slug, lifespan }) => (
                <li>
                  {slug ? (
                    <a href={`${import.meta.env.BASE_URL}people/${slug}/`} class="text-[var(--color-link)] text-sm">{name}</a>
                  ) : (
                    <span class="text-sm text-[var(--color-ink-light)]">{name}</span>
                  )}
                  {lifespan && <span class="text-xs text-[var(--color-muted)] ml-1">({lifespan})</span>}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>

    <!-- The three navigation links (Back to all people / Descendant Chart /
         Family Sheet) are rendered by BaseLayout at the VERY BOTTOM of the
         page, after Common Questions + map, via the navState prop. -->
  </div>
</BaseLayout>

<style is:global>
  .wiki-content a.wiki-link {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
  }
  .wiki-content a.wiki-link:hover {
    color: var(--color-heading-hover);
  }
  .wiki-content figure {
    margin: 0;
  }
  .wiki-content img {
    border-radius: 0.5rem;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
  }
  .wiki-content figcaption {
    font-size: 0.75rem;
    color: var(--color-muted);
    margin-top: 0.15rem;
  }
</style>
