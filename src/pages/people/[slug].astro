---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatBody, getLinksForRelationships } from "../../utils/format-body.mjs";

export async function getStaticPaths() {
  const people = (await import("../../data/people.json")).default;
  return people.map((person) => ({
    params: { slug: person.slug },
    props: { person },
  }));
}

const { person } = Astro.props;
const people = (await import("../../data/people.json")).default;
const telferPeople = people.filter((p) => p.related_trees.includes("telfer-tree"));

// ── Relationship groupings ──
const spouseLinks = getLinksForRelationships(person.spouses, telferPeople);
const parentLinks = getLinksForRelationships(person.parents, telferPeople);
const childLinks = getLinksForRelationships(person.children, telferPeople);
const siblingLinks = getLinksForRelationships(person.siblings, telferPeople);

// ── Body content ──
const bodyHtml = formatBody(person.body_markdown, telferPeople);

// ── Tags ──
const importantTags = person.tags.filter((t) => !["bio", "family", "person"].includes(t));
---

<BaseLayout title={person.display_name}>
  <div class="max-w-4xl mx-auto">
    <!-- Breadcrumb -->
    <div class="text-sm text-[var(--color-muted)] mb-1.5">
      <a href={import.meta.env.BASE_URL + "people"} class="text-[var(--color-link)]">People</a>
      <span class="mx-2">/</span>
      <span>{person.display_name}</span>
    </div>

    <!-- Header Card -->
    <div class="person-card rounded-xl p-3 md:p-4 mb-3">
      <div class="flex items-start justify-between gap-2">
        <div class="flex-1">
          <h1 class="text-xl md:text-2xl font-bold font-serif text-[var(--color-heading)] mb-0.5">
            {person.display_name}
          </h1>

          <!-- Lifespan -->
          <div class="text-sm text-[var(--color-ink-light)] mb-1">
            {person.lifespan}
          </div>

          <!-- Roles -->
          {person.roles.length > 0 && (
            <div class="space-y-0">
              {person.roles.map((role) => (
                <div key={role} class="text-xs text-[var(--color-ink-light)] italic">
                  {role}
                </div>
              ))}
            </div>
          )}
        </div>

        {/* Portrait Photo or Initials Avatar */}
        {person.person_photo ? (
          <div class="w-16 h-16 md:w-20 md:h-20 rounded-full overflow-hidden border-2 border-[var(--color-highlight)] shrink-0 bg-[var(--color-surface)]">
            <img
              src={import.meta.env.BASE_URL + person.person_photo}
              alt={person.display_name}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        ) : (
          <div class="w-12 h-12 md:w-16 md:h-16 rounded-full bg-[var(--color-heading)] text-white flex items-center justify-center text-lg md:text-xl font-serif font-bold shrink-0">
            {person.first_name?.[0]}{person.last_name?.[0]}
          </div>
        )}
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-1.5">
      <!-- Main Content -->
      <div class="md:col-span-2">
        <div class="person-card rounded-xl p-2.5">
          <h2 class="font-serif text-base text-[var(--color-heading)] mb-0">Biography</h2>
          <!-- Wiki-formatted body (first h1 stripped, leading empty paragraphs + whitespace removed, prose tightened) -->
          <div class="prose prose-sm max-w-none wiki-content" set:html={bodyHtml
            .replace(/^<h1[^>]*>.*?<\/h1>\s*/i, '')
            .replace(/^(<p>\s*<\/p>\s*)+/i, '')
            .replace(/^\s+/, '')
          }></div>
          <style define:vars={{}}>
            .wiki-content > :first-child { margin-top: 0 !important; }
          </style>
        </div>

        <!-- Tags -->
        {importantTags.length > 0 && (
          <div class="person-card rounded-xl p-3 mt-3">
            <h2 class="font-serif text-sm text-[var(--color-heading)] mb-1.5">Tags</h2>
            <div class="flex flex-wrap gap-1">
              {importantTags.map((tag) => (
                <span key={tag} class="text-xs px-2 py-0.5 rounded-full border border-[var(--color-border)] text-[var(--color-muted)]">{tag}</span>
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- Sidebar -->
      <div class="space-y-2">
        <!-- Relationship: Spouse -->
        {spouseLinks.length > 0 && (
          <div class="person-card rounded-xl p-2.5">
            <h3 class="font-serif text-[var(--color-heading)] mb-1">Spouse{spouseLinks.length > 1 ? "s" : ""}</h3>
            <ul class="space-y-0">
              {spouseLinks.map(({ name, slug }) => (
                <li key={slug || name}>
                  {slug ? (
                    <a href={`${import.meta.env.BASE_URL}people/${slug}`} class="text-[var(--color-link)] text-sm">{name}</a>
                  ) : (
                    <span class="text-sm text-[var(--color-ink-light)]">{name}</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Relationship: Parents -->
        {parentLinks.length > 0 && (
          <div class="person-card rounded-xl p-2.5">
            <h3 class="font-serif text-[var(--color-heading)] mb-1">Parents</h3>
            <ul class="space-y-0">
              {parentLinks.map(({ name, slug }) => (
                <li key={slug || name}>
                  {slug ? (
                    <a href={`${import.meta.env.BASE_URL}people/${slug}`} class="text-[var(--color-link)] text-sm">{name}</a>
                  ) : (
                    <span class="text-sm text-[var(--color-ink-light)]">{name}</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Relationship: Children -->
        {childLinks.length > 0 && (
          <div class="person-card rounded-xl p-2.5">
            <h3 class="font-serif text-[var(--color-heading)] mb-1">Children</h3>
            <ul class="space-y-0">
              {childLinks.map(({ name, slug }) => (
                <li key={slug || name}>
                  {slug ? (
                    <a href={`${import.meta.env.BASE_URL}people/${slug}`} class="text-[var(--color-link)] text-sm">{name}</a>
                  ) : (
                    <span class="text-sm text-[var(--color-ink-light)]">{name}</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Relationship: Siblings -->
        {siblingLinks.length > 0 && (
          <div class="person-card rounded-xl p-2.5">
            <h3 class="font-serif text-[var(--color-heading)] mb-1">Siblings</h3>
            <ul class="space-y-0">
              {siblingLinks.map(({ name, slug }) => (
                <li key={slug || name}>
                  {slug ? (
                    <a href={`${import.meta.env.BASE_URL}people/${slug}`} class="text-[var(--color-link)] text-sm">{name}</a>
                  ) : (
                    <span class="text-sm text-[var(--color-ink-light)]">{name}</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>

    <!-- Navigation footer -->
    <div class="mt-3 flex justify-between items-center border-t border-[var(--color-border)] pt-2 text-sm">
      <a href={import.meta.env.BASE_URL + "people"} class="text-[var(--color-link)]">← Back to all people</a>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .wiki-content a.wiki-link {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
  }
  .wiki-content a.wiki-link:hover {
    color: var(--color-heading-hover);
  }
  .wiki-content figure {
    margin: 0;
  }
  .wiki-content img {
    border-radius: 0.5rem;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
  }
  .wiki-content figcaption {
    font-size: 0.75rem;
    color: var(--color-muted);
    margin-top: 0.15rem;
  }
</style>
