---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { PersonData } from "../utils/extract-data.mjs";
import { stripWikiLinks } from "../utils/format-body.mjs";

const people = (await import("../data/people.public.json")).default as PersonData[];
const telferPeople = people.filter((p) => (p.branch === "telfer" || !p.branch) && p.id);
---

<BaseLayout
  title="Search"
  description={`Search ${telferPeople.length} profiles in the Telfer family line by name, year, or occupation. Part of the Telfer Family Wiki — a digital family history archive tracing nine generations from Scotland to South Australia.`}
>
  <div class="page-header">
    <h1>Search</h1>
    <p class="text-[var(--color-ink-light)] mt-2">
      Search {telferPeople.length} profiles in the Telfer line
    </p>
  </div>

  <!-- Search input -->
  <div class="mb-6">
    <div class="relative">
      <span class="absolute left-4 top-1/2 -translate-y-1/2 text-[var(--color-muted)]" style="display:flex;pointer-events:none"><svg class="pg-ico" width="20" height="20" aria-hidden="true" focusable="false"><use href="#i-search"></use></svg></span>
      <input
        id="search-input"
        type="text"
        placeholder="Search by name, year, occupation..."
        class="w-full pl-10 pr-4 py-3 rounded-lg border-2 border-[var(--color-border)] bg-white text-[var(--color-ink)] text-lg font-serif focus:outline-none focus:border-[var(--color-gold)] focus:ring-2 focus:ring-[var(--color-gold)]/20 transition-all"
        autofocus
      />
    </div>
    <div class="mt-2 text-sm text-[var(--color-muted)]">
      <span id="result-count">{telferPeople.length} profiles</span>
    </div>
  </div>

  <!-- Results table -->
  <div id="results" class="divide-y divide-[var(--color-border)]">
    {telferPeople.map((person) => (
      <a
        data-search-item
        data-name={person.display_name.toLowerCase()}
        data-year={String(person.birth_year || "")}
        data-role={stripWikiLinks(person.roles?.[0] || "").toLowerCase()}
        data-living={person.is_living ? "1" : "0"}
        href={`${import.meta.env.BASE_URL}people/${person.slug}/`}
        class="flex items-center gap-4 py-3 px-2 no-underline hover:bg-[var(--color-surface)]/50 transition-colors rounded group"
      >
        <div class="flex-1 min-w-0">
          <div class="font-medium text-[var(--color-burgundy)] group-hover:text-[var(--color-burgundy-light)] transition-colors">
            {person.display_name}
          </div>
          <div class="text-sm text-[var(--color-muted)]">{person.lifespan}</div>
        </div>
        {person.roles?.length > 0 && (
          <div class="hidden md:block text-xs text-[var(--color-ink-light)] max-w-xs truncate">{stripWikiLinks(person.roles[0])}</div>
        )}
        <div class="shrink-0">
          {person.is_deceased && (
            <span class="text-xs px-2 py-0.5 rounded badge-deceased">Deceased</span>
          )}
        </div>
        <span class="shrink-0 text-[var(--color-border)] group-hover:text-[var(--color-burgundy)] transition-colors">&rarr;</span>
      </a>
    ))}
  </div>

  <!-- Empty state -->
  <div id="empty-state" class="hidden text-center py-12">
    <div class="mb-3" style="display:flex;justify-content:center"><svg class="pg-ico" width="40" height="40" aria-hidden="true" focusable="false" style="vertical-align:-2px;margin-right:.3rem;display:inline-block"><use href="#i-search"></use></svg></div>
    <p class="text-lg text-[var(--color-ink-light)] font-serif">No profiles match your search.</p>
    <p class="text-sm text-[var(--color-muted)] mt-1">Try a different name or keyword.</p>
  </div>
</BaseLayout>

<script>
  import Fuse from "fuse.js";

  document.addEventListener("DOMContentLoaded", () => {
    const input = document.getElementById("search-input");
    const results = document.getElementById("results");
    const emptyState = document.getElementById("empty-state");
    const resultCount = document.getElementById("result-count");
    const items = Array.from(document.querySelectorAll("[data-search-item]"));

    if (!input || !results || !items.length) return;

    const searchData = items.map((el, idx) => ({
      el,
      idx,
      name: el.dataset.name || "",
      year: el.dataset.year || "",
      role: el.dataset.role || "",
    }));

    // Hybrid ranking for genealogy search:
    //   tier 1 — exact/prefix name match (a word starts with the query) — these always surface first
    //   tier 2 — name contains the query
    //   tier 3 — fuzzy Fuse fallback (exact and contains already caught, so fuzz stays optional)
    // This stops a query like "mark" being flooded by fuzzy "Margaret"/"Martha" matches, and keeps
    // the real "Mark Telfer" profiles on top.
    const fuse = new Fuse(searchData, {
      keys: [{ name: "name", weight: 3 }],
      threshold: 0.3,
      includeScore: true,
      ignoreLocation: true,
    });

    function rank(query) {
      const q = query.toLowerCase();
      if (!q) return searchData.map((s) => ({ el: s.el, score: 0 }));
      if (q.length < 2) return searchData;

      const isWordBoundaryStartsWith = (name) =>
        name.startsWith(q) || name.split(" ").some((w) => w.startsWith(q));

      const exact = searchData.filter((s) => isWordBoundaryStartsWith(s.name));
      // Within the exact tier, ORDER MATTERS. Data order is generation order
      // (oldest first), so a bare `filter` ranked an 1877 Mark Telfer above a
      // 1958 Mark Welch only by accident of generation — and once namesakes
      // carried a lifespan suffix the tie broke the wrong way and the living
      // Mark was buried under unrelated surnames.
      // Tiers: 0 = the query IS the whole name ("mark telfer" for "mark"),
      //        1 = the query is the FIRST word ("mark andrew telfer"),
      //        2 = the query matches some later word (a middle name),
      // then the TELFER line (this is the Telfer wiki), then surname, then
      // shortest name (so "Mark Telfer" outranks "Mark Andrew Telfer").
      const qWhole = (name) => name === q || name.startsWith(q + " ");
      const qFirst = (name) => name.split(" ")[0] === q;
      // Exactness is measured on the NAME ONLY. The lifespan suffix that
      // disambiguates namesakes (" (1877 – 1946)") must never count toward
      // length, or an old Mark outranks a plain one on punctuation alone.
      const NAME_ONLY = /^\s*(\d{4}|\?)\s*[–-]\s*(\d{4}|\?|living)\s*$/;
      const nameOnly = (s) => {
        const dn = s.display || s.name || "";
        const m = dn.match(/\s*\(([^)]*)\)\s*$/);
        if (m && NAME_ONLY.test(m[1])) {
          // Base name keeps its original case (a.name.localeCompare must not
          // become a case-insensitive no-op — that silently disabled the
          // final tie-break and let the comparator return 0 for distinct rows,
          // so V8's TimSort left them in generation order).
          return dn.slice(0, m.index).trim();
        }
        return dn.trim();
      };
      const rankTier = (s) => {
        const n = nameOnly(s).toLowerCase();
        return qWhole(n) ? 0 : qFirst(n) ? 1 : 2;
      };
      const isTelfer = (s) => /\btelfer\b/i.test(nameOnly(s));
      // Two keys are needed, not one:
      //   1. surname priority — "Mark Telfer" before "Mark Welch"
      //   2. shortest name — "Mark Telfer" before "Mark Andrew Telfer"
      // A single `length` key conflated them ("Mark Welch" = 10 chars beat
      // "Mark Telfer" = 11). And `a.name.localeCompare(b.name)` compares the
      // LOWERCASED data-name, which is case-insensitive — it returned 0 for
      // every pair, so the comparator's last resort was a tie and V8's stable
      // sort quietly preserved generation order. Names here are unique, so a
      // case-SENSITIVE compare always discriminates.
      const surnameAfterTelfer = (s) => {
        const parts = nameOnly(s).toLowerCase().split(/\s+/);
        const surname = parts.length > 1 ? parts[1] : parts[0];
        return /^telfer\b/.test(surname) ? 0 : 1;
      };
      exact.sort((a, b) =>
        rankTier(a) - rankTier(b) ||
        Number(isTelfer(b)) - Number(isTelfer(a)) ||
        surnameAfterTelfer(a) - surnameAfterTelfer(b) ||
        nameOnly(a).length - nameOnly(b).length ||
        (nameOnly(a) < nameOnly(b) ? -1 : nameOnly(a) > nameOnly(b) ? 1 : 0)
      );
      const exactIds = new Set(exact.map((s) => s.el));
      const contains = searchData.filter((s) => s.name.includes(q) && !exactIds.has(s.el));
      contains.sort((a, b) =>
        Number(isTelfer(b.name)) - Number(isTelfer(a.name)) || a.name.localeCompare(b.name)
      );
      const containsIds = new Set([...exactIds, ...contains.map((s) => s.el)]);
      const rest = searchData.filter((s) => !containsIds.has(s.el));
      // Fuzzy rows carry the SAME shape as the other tiers ({el, idx, name,
      // year, role}). The old version returned bare {el, score} objects, so any
      // downstream code reaching for `.name` (the comparator, or render's
      // shown-set) hit `undefined` and threw. Keep the shape uniform.
      const fuzzy =
        rest.length > 0
          ? fuse.search(q).map((r) => ({ ...r.item, score: r.score }))
          : [];

      return [...exact, ...contains, ...fuzzy].slice(0, 60);
    }

    // ────────────────────────────────────────────────────────────────────
    // render() — show the ranked rows, in ranked order.
    //
    // This is deliberately the dumbest possible implementation, because every
    // clever version of it was wrong:
    //
    //   • forEach(appendChild) on a SUBSET reverses the block — each append
    //     detaches the row and drops it at the tail, compacting earlier ones.
    //   • insertBefore(item, results.children[i]) drifts, because children[i]
    //     counts the ~590 hidden rows as well as the visible ones.
    //   • append(...matched) then prepend(...matched) reverses AND then
    //     front-loads the reversed block.
    //
    // The working method: build a detached <div>, append a COPY of the
    // matched rows' order by walking the ranked array and appending each node
    // to the fragment in turn (the fragment starts empty, so appending is
    // plain insertion — nothing detaches a second time), then move the
    // fragment's now-ordered children to the front of #results in one call.
    // ----------------------------------------------------------------
    function render(matchedItems) {
      const matchedEls = [];
      matchedItems.forEach((item) => {
        const el = item && item.el;
        if (el && el.style && matchedEls.indexOf(el) === -1) matchedEls.push(el);
      });

      if (!matchedEls.length) {
        items.forEach((el) => { if (el && el.style) el.style.display = "none"; });
        results.classList.add("hidden");
        emptyState.classList.remove("hidden");
        resultCount.textContent = "No results";
        return;
      }

      // Order in a detached staging node. The staging node is EMPTY before we
      // start, so every append puts the node at the end of a short list — the
      // exact inverse of the bug (where the source list was long and each
      // append removed a hole).
      const stage = document.createElement("div");
      matchedEls.forEach((el) => stage.appendChild(el));
      const ordered = Array.prototype.slice.call(stage.children);

      // Put the ordered block at the front of #results in ONE call. prepend
      // with several nodes inserts them in argument order, which is why the
      // block must be ordered BEFORE it arrives (see above).
      results.prepend(...ordered);

      // Show the ranked rows, hide the rest.
      const shown = new Set(ordered);
      items.forEach((el) => {
        if (el && el.style) el.style.display = shown.has(el) ? "" : "none";
      });

      results.classList.remove("hidden");
      emptyState.classList.add("hidden");
      resultCount.textContent = `${ordered.length} profile${ordered.length !== 1 ? "s" : ""}`;
    }

    input.addEventListener("input", () => {
      render(rank(input.value.trim()));
    });

    render(rank(input.value.trim()));
  });
</script>
