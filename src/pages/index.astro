---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { PersonData } from "../utils/extract-data.mjs";

const peopleData = (await import("../data/people.public.json")).default as PersonData[];
const metaData = (await import("../data/meta.json")).default;

// Only Telfer tree people for the home page
const telferPeople = peopleData;
const deceasedTelfer = telferPeople.filter((p) => !p.is_living);
const livingTelfer = telferPeople.filter((p) => p.is_living);

// Find earliest and latest years
const validPeople = peopleData.filter((p) => p.birth_year);
const years = validPeople.map((p) => p.birth_year as number);
const minYear = years.length > 0 ? Math.min(...years) : 1731;
const maxYear = years.length > 0 ? Math.max(...years, new Date().getFullYear()) : new Date().getFullYear();

// Count generations from John Telfer (of Castleton) (~1731) to the kids (2019)
const generationRanges = [
  { label: "1st Gen", range: "1731–1761", from: 1731, to: 1761 },
  { label: "2nd Gen", range: "1761–1809", from: 1762, to: 1809 },
  { label: "3rd Gen", range: "1809–1895", from: 1809, to: 1895 },
  { label: "4th Gen", range: "1847–1929", from: 1847, to: 1929 },
  { label: "5th Gen", range: "1875–1954", from: 1875, to: 1954 },
  { label: "6th Gen", range: "1924–2009", from: 1924, to: 2009 },
  { label: "7th Gen", range: "1959–", from: 1959, to: new Date().getFullYear() },
  { label: "8th Gen", range: "2008–", from: 2008, to: new Date().getFullYear() },
];

// Pre-compute generation members
function peopleInRange(fr, t) {
  return telferPeople.filter((p) => p.birth_year && p.birth_year >= fr && p.birth_year <= t).slice(0, 4).map((p) => p.display_name);
}

// Timeline highlight: key events
const keyDates = [
  { year: "1809", event: "Francis Telfer born in Scotland" },
  { year: "1839", event: "Francis emigrates to South Australia" },
  { year: "1874", event: "John Telfer marries Caroline Masters" },
  { year: "1895", event: "Francis Telfer dies, aged 86" },
  { year: "1924", event: "Murray John Telfer born" },
  { year: "1950s", event: "The family settles on Eyre Peninsula" },
  { year: "1986", event: "Mark Kenneth Telfer born" },
  { year: "2017", event: "Levi Leonard Telfer born" },
  { year: "2019", event: "Zabella Violet Telfer born" },
];

// Recent profiles added
const recentPeople = (telferPeople || []).slice(-6).reverse();
---

<BaseLayout title="Home">
  <div class="space-y-3 sm:space-y-4">
    <!-- Hero -->
    <section class="text-center py-4 sm:py-6 border-b-2 border-[var(--color-border)]">
      <div class="text-4xl sm:text-5xl mb-2">🌳</div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold font-serif text-[var(--color-heading)] mb-3">
        Telfer Wiki
      </h1>
      <p class="text-base sm:text-lg text-[var(--color-ink-light)] font-serif italic max-w-2xl mx-auto px-2">
        A digital archive for the descendants of John Telfer of Castleton — from the Scottish lowlands to the South Australian plains
      </p>

      <!-- What we are -->
      <div class="max-w-xl mx-auto mt-4 px-2 text-left">
        <p class="text-sm sm:text-base text-[var(--color-ink-light)] font-serif italic leading-relaxed">
          This is a living family history. <strong>Eight generations</strong> of Telfers — shepherds and farmers,
          miners and merchants — traced from the hills of Roxburghshire, Scotland (~1715) through the copper
          boom of South Australia, across the Eyre Peninsula, and into the present day.
        </p>
        <p class="text-sm sm:text-base text-[var(--color-ink-light)] font-serif italic leading-relaxed mt-2">
          Every person here is blood of the same root. Every page tells a piece of the story.
          This is <strong>our</strong> family's record — built for the living, remembering the gone.
        </p>
      </div>

      <p class="text-xs sm:text-sm text-[var(--color-muted)] mt-3">
        <span class="font-sans not-italic">{metaData.total_people} profiles</span>
        &nbsp;·&nbsp; covering <span class="font-sans not-italic">{minYear}–{maxYear}</span>
        &nbsp;·&nbsp; <span class="font-sans not-italic">{metaData.total_trees} family tree{metaData.total_trees !== 1 ? 's' : ''}</span>
      </p>
      <div class="mt-3 sm:mt-4 flex flex-col sm:flex-row gap-3 justify-center items-center">
        <a href={import.meta.env.BASE_URL + "people"} class="inline-block w-full sm:w-auto px-5 sm:px-6 py-3 bg-[var(--color-heading)] text-white rounded-lg font-serif text-base sm:text-lg no-underline hover:bg-[var(--color-heading-hover)] transition-colors text-center">
          Browse the People
        </a>
        <a href={import.meta.env.BASE_URL + "timeline"} class="inline-block w-full sm:w-auto px-5 sm:px-6 py-3 border-2 border-[var(--color-border)] text-[var(--color-ink)] rounded-lg font-serif text-base sm:text-lg no-underline hover:border-[var(--color-heading)] hover:text-[var(--color-heading)] transition-colors text-center">
          View the Timeline
        </a>
        <a href={import.meta.env.BASE_URL + "people/full-tree"} class="inline-block w-full sm:w-auto px-5 sm:px-6 py-3 border-2 border-[var(--color-border)] text-[var(--color-ink)] rounded-lg font-serif text-base sm:text-lg no-underline hover:border-[var(--color-heading)] hover:text-[var(--color-heading)] transition-colors text-center">
          Explore the Tree
        </a>
      </div>
    </section>

    <!-- Stats -->
    <section>
      <h2 class="text-center mb-3">At a Glance</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
        <div class="person-card rounded-lg p-3 sm:p-4 text-center">
          <div class="text-2xl sm:text-3xl font-bold font-serif text-[var(--color-heading)]">{telferPeople.length}</div>
          <div class="text-sm text-[var(--color-muted)] mt-0.5">Telfer Profiles</div>
        </div>
        <div class="person-card rounded-lg p-3 sm:p-4 text-center">
          <div class="text-2xl sm:text-3xl font-bold font-serif text-[var(--color-heading)]">{generationRanges.length}</div>
          <div class="text-sm text-[var(--color-muted)] mt-0.5">Generations</div>
        </div>
        <div class="person-card rounded-lg p-3 sm:p-4 text-center">
          <div class="text-2xl sm:text-3xl font-bold font-serif text-[var(--color-heading)]">{livingTelfer.length}</div>
          <div class="text-sm text-[var(--color-muted)] mt-0.5">Living</div>
        </div>
        <div class="person-card rounded-lg p-3 sm:p-4 text-center">
          <div class="text-2xl sm:text-3xl font-bold font-serif text-[var(--color-heading)]">{deceasedTelfer.length}</div>
          <div class="text-sm text-[var(--color-muted)] mt-0.5">Deceased</div>
        </div>
      </div>
    </section>

    <!-- Generations -->
    <section>
      <h2 class="mb-2">The Generations</h2>
      <div class="space-y-1">
        {generationRanges.map((gen) => (
          <div class="person-card rounded-lg p-2 sm:p-3 flex items-center gap-2 sm:gap-3">
            <div class="w-12 sm:w-14 text-center shrink-0">
              <div class="font-bold font-serif text-sm sm:text-base text-[var(--color-heading)]">{gen.label}</div>
              <div class="text-xs text-[var(--color-muted)]">{gen.range}</div>
            </div>
            <div class="h-4 sm:h-6 w-px bg-[var(--color-border)] shrink-0"></div>
            <div class="flex-1 text-xs sm:text-sm text-[var(--color-ink-light)]">
              {peopleInRange(gen.from, gen.to).join(", ")}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Timeline Highlights -->
    <section>
      <h2 class="mb-2">Timeline Highlights</h2>
      <div class="space-y-0">
        {keyDates.map((item) => (
          <div class="timeline-line pl-5 pb-2">
            <span class="font-bold font-serif text-[var(--color-heading)]">{item.year}</span>
            <span class="text-[var(--color-ink-light)]"> — {item.event}</span>
          </div>
        ))}
      </div>
      <div class="mt-1.5">
        <a href={import.meta.env.BASE_URL + "timeline"} class="text-sm text-[var(--color-link)]">View full timeline →</a>
      </div>
    </section>

    <!-- Recent Profiles -->
    <section>
      <h2 class="mb-2">Recently Added</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2">
        {recentPeople.map((person) => (
          <a href={import.meta.env.BASE_URL + "people/" + person.slug} class="person-card rounded-lg p-2.5 sm:p-3 no-underline block">
            <div class="font-medium text-[var(--color-heading)]">{person.display_name}</div>
            <div class="text-sm text-[var(--color-muted)]">
              {person.birth_year ? person.birth_year : "?"} – {person.death_year || person.is_living ? "living" : "?"}
              <span class="ml-2 inline-block text-xs px-2 py-0.5 rounded badge-living">{person.is_living ? "Living" : "Deceased"}</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
